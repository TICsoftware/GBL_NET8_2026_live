@model UploadFiles
@{
    Layout = "~/Views/Shared/Manage/_Layout_Dashboard.cshtml";
    ViewData["Title"] = "Upload Multiple files";
    string returnUrl = Context.Request.Query["ReturnUrl"].ToString();
}

<div class="page-heading">
    <div class="page-title">
        <div class="row justify-content-between">
            <div class="col-12 col-md-6 order-md-1 order-first">
                <h3>Upload Multiple files</h3>
                
            </div>
            <div class="col-12 col-md-3 order-md-2 order-last">
                <div class="input-group mb-3">
                    <label class="input-group-text" for="inputGroupSelect01">Options</label>
                    <select class="form-select" id="inputGroupSelect01">
                        <option selected="">Select...</option>
                        <option value="1">Add new </option>
                        <option value="2">Draft</option>
                        <option value="3">Published</option>
                        <option value="3">In-Process</option>
                    </select>
                </div>
            </div>
        </div>
    </div>
    <section class="section content-main">
        @using (Html.BeginForm("Upload", "ManageFiles", FormMethod.Post, new
        {
            id = "myDropzone",
            @class = "dropzone",
            enctype = "multipart/form-data"
        }))
        {
            <input type="hidden" name="HiddenData" id="hiddenData" value="" />
            <div class="row">
                <div class="col-12">
                    <div class="card">                     
                        <div class="card-body">  
                            <div id="selectMastersAccordion-collapseOne">
                                <div class="accordion-body">
                                    <div class="row">
                                        <div class="col-md-6 col-12">
                                            <div class="form-group mb-3">
                                                <label for="Language_master_id" class="form-label">Language</label>
                                                @Html.DropDownListFor(model => model.Language_master_id, Model.Languages,
                                                new { id = "ddLanguage", @class = "form-select" })
                                                @Html.ValidationMessageFor(model => model.Language_master_id, "", new
                                                {
                                                    @class = "text-danger"
                                                })
                                            </div>
                                        </div>
                                        <div class="col-md-6 col-12">
                                            <div class="form-group mb-3">
                                                <label for="Geography_ID" class="form-label">Geography <sup>*</sup></label>
                                                <div class="d-flex flex-wrap">
                                                    @Html.DropDownListFor(model => model.Geography_ID,
                                                        Model.Geographies, new { id = "ddGeography", @class = "form-select" })
                                                    @Html.ValidationMessageFor(model => model.Geography_ID, "",
                                                    new { @class = "text-danger" })
                                                        
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6 col-12">
                                            <div class="form-group mb-3">
                                                <label for="Content_Type_ID" class="form-label">Content type
                                                    <sup>*</sup></label>
                                                    <div class="d-flex">
                                                        <div class="form-check me-2">
                                                            @Html.RadioButtonFor(model => model.Content_Type_ID,
                                                    Core_project_BusinessLogic.Content_Types.Section, new
                                                    {
                                                        id = "Content_Type_ID",
                                                        @class = "form-check-label"
                                                    })
                                                            @Html.Label("Section")
                                                        </div>
                                                        <div class="form-check me-2">
                                                            @Html.RadioButtonFor(model => model.Content_Type_ID,
                                                    Core_project_BusinessLogic.Content_Types.Common_Article, new
                                                    {
                                                        id = "Content_Type_ID",
                                                        @class = "form-check-label"
                                                    }) @Html.Label("Common article")
                                                        </div>
                                                        <div class="form-check me-2">
                                                            @Html.RadioButtonFor(model => model.Content_Type_ID,
                                                    Core_project_BusinessLogic.Content_Types.Related_Article, new
                                                    {
                                                        id = "Content_Type_ID",
                                                        @class = "form-check-label"
                                                    }) @Html.Label("Related article")
                                                        </div>                                                                
                                                    </div>
                                                    @Html.ValidationMessageFor(model => model.Content_Type_ID, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                                
                                            <div class="col-md-6 col-12">
                                                <div class="form-group mb-3">
                                                    <label for="ddTemplates" class="form-label">Template </label>
                                                    <div class="d-flex flex-wrap">
                                                        @Html.DropDownListFor(model => model.Template_id,
                                                            Model.Templates, new { id = "ddTemplates", @class = "form-select" })
                                                        @Html.ValidationMessageFor(model => model.Template_id, "", new { @class = "text-danger" })
                                                        
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div class="col-md-12 col-12" id="div_language_sections"
                                                 style="display:@(Model.Language_master_id > 1 ? "block": "none");">
                                                <div class="form-group mb-3">
                                                    <label for="ddLanguage_Sections" class="form-label">Select Section</label>
                                                    <div class="row">
                                                        <div class="col-md-6 col-12 mb-2">
                                                            @Html.DropDownListFor(model => model.Language_section_id,
                                                            Model.Language_sections, new
                                                            {
                                                                id = "ddLanguage_Sections",
                                                                @class = "form-select"
                                                            })
                                                        </div>
                                                        <div class="col-md-6 col-12">
                                                            @Html.DropDownListFor(model => model.Language_subSection_id,
                                                            Model.Language_subSections, new { id = "ddLanguage_SubSections", @class = "form-select" }) 
                                                        </div>
                                                    </div>
                                                    
                                                </div>
                                            </div>
                                            <div class="col-md-12 col-12">
                                                <div class="form-group mb-3">
                                                    <label for="ddSections" class="form-label" id="lblddSections">Select
                                                Section</label>
                                                <div class="row">
                                                    <div class="col-md-6 col-12 mb-2">
                                                        @Html.DropDownListFor(model => model.Section_id,
                                                        Model.Sections, new { id = "ddSections", @class = "form-select" })
                                                    </div>
                                                    <div class="col-md-6 col-12">
                                                        @Html.DropDownListFor(model => model.Subsection_id,
                                                        Model.subSections, new { id = "ddSubSections", @class = "form-select" }) 
                                                    </div>
                                                
                                                </div>
                                            
                                            </div>
                                        </div>
                                        <div class="col-md-12 col-12">
                                            <div class="form-group mb-3">
                                                <label for="ddArticle" class="form-label" id="lblddArticle">Select
                                                    Article</label>
                                                    <div class="d-flex flex-wrap">
                                                        @Html.DropDownListFor(model => model.article_id,
                                                            Model.Articles, new { id = "ddArticle", @class = "form-select" })
                                                
                                                    </div>
                                                </div>
                                            </div>
                                    
                                    
                                            <div class="col-md-12 col-12">
                                                <div class="row">
                                                    <div class="col-md-6 col-12 mb-2">
                                                        <div class="form-group mb-3">
                                                            <label for="lstMapping_Sections" class="form-label">Map to other
                                                                section(s)</label>
                                                                @Html.ListBoxFor(model => model.SelectedMapping_sections,
                                                                Model.Mapping_sections, new
                                                                {
                                                                    id = "lstMapping_Sections",
                                                                    @class = "form-select",
                                                                    size = "8"
                                                                })
                                                                <small class="text-muted"><b>Hold Ctrl to select multiple
                                                                    sections</b></small>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6 col-12">
                                                        <div class="form-group mb-3">
                                                            <label for="lstTagging_Sections" class="form-label">Select
                                                                Tag(s)</label>
                                                                @Html.ListBoxFor(model => model.SelectedTagging_sections,
                                                                Model.Tagging_sections, new
                                                                {
                                                                    id = "lstTagging_Sections",
                                                                    @class = "form-select",
                                                                    size = "8"
                                                                })
                                                                <small class="text-muted"><b>Hold Ctrl to select multiple tags</b></small>
                                                                                        
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
            
                                </div>
                            </div>
                        </div>
                    </div>
                }
                <button type="button" id="uploadButton" class="btn btn-outline-primary me-1 mb-1">
                    Upload Files
                </button>
    </section>
</div>
@section Scripts {
    <link rel="stylesheet" href="~/scripts/Dropzone/dropzone.min.css" />
    <script src="~/scripts/Dropzone/dropzone.min.js"></script>
    <script src="~/scripts/Dropzone/upload_multiple_files.js"></script>
}