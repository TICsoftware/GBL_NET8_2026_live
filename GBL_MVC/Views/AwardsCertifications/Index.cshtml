@using GBL_MVC.Helpers
@model GBL_BusinessLogic.Entity.AwardsCertificationsModel
@{
    ViewData["Title"] = Model?.Content?.ContTitle ?? "Awards & Certifications";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var content = Model?.Content;
    var sections = Model?.Sections ?? new List<GBL_BusinessLogic.Entity.AwardsSectionModel>();
    var awardsSection = sections.FirstOrDefault(s => !s.IsCertifications);
    var certsSection = sections.FirstOrDefault(s => s.IsCertifications);
    if (awardsSection == null)
        awardsSection = sections.FirstOrDefault();
    if (certsSection == null && sections.Count > 1)
        certsSection = sections.Skip(1).FirstOrDefault();
}

@section head {
    <title>@(content?.cont_window_title)</title>
    <meta content="@(content?.cont_metatag)" name="keywords" />
    <meta content="@(content?.cont_metadesc)" name="description" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@(content?.ContTitle)" />
    <meta name="twitter:description" content="@(content?.cont_metadesc)" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Godavari Biorefineries" />
    <meta property="og:title" content="@(content?.ContTitle)" />
    <meta property="og:description" content="@(content?.cont_metadesc)" />
    <meta property="og:url" content="@(content?.CanonicalUrl)" />
    <meta property="og:image" content="@(content?.cont_meta_image)" />
    <link rel="canonical" href="@(content?.CanonicalUrl)" />
}

@section Styles {
    <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Assets/css/awards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Assets/css/leadership.css" asp-append-version="true" />
}

@if (content != null && content.ContId > 0)
{
    @await Html.PartialAsync("~/Views/CommonComponent/_page_banner.cshtml", content)
}

@if (!string.IsNullOrWhiteSpace(content?.Cont_intro) || !string.IsNullOrWhiteSpace(content?.Cont_hmpg_intro))
{
    <section class="relative overflow-hidden section-spacing page-intro-outer bg-gray">
        <div class="container">
            <div class="page-intro-inner intro-lg text-center">
                @Html.Raw(!string.IsNullOrWhiteSpace(content?.Cont_intro) ? content.Cont_intro : content?.Cont_hmpg_intro)
            </div>
        </div>
    </section>
}

@if (awardsSection != null && awardsSection.Groups.Any(g => g.Items.Count > 0))
{
    <section class="relative section-spacing awards-outer">
        <div class="container">
            <div class="awards-head">
                <h2 class="text-h2 awards-head__title">@awardsSection.Title</h2>
                @if (!string.IsNullOrWhiteSpace(awardsSection.Intro))
                {
                    <div class="awards-head__intro">@Html.Raw(awardsSection.Intro)</div>
                }
            </div>

            @foreach (var group in awardsSection.Groups.Where(g => g.Items.Count > 0))
            {
                <div class="awards-group">
                    <h3 class="awards-group__title">@group.Title</h3>
                    <div class="awards-slider" data-awards
                         role="region" aria-roledescription="carousel" aria-label="@group.Title">
                        <button type="button" class="awards-arrow awards-arrow--prev" data-aw-prev aria-label="Previous award">
                            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <ul class="awards-track card-list-items" data-aw-track>
                            @foreach (var item in group.Items)
                            {
                                var image = FirstPath(item.ThumbnailImage, item.ComponentThumbnail, item.Component_LHS_thumbnail);
                                var alt = FirstText(item.ThumbnailAltText, item.ComponentThumbnailAltText, item.Title);
                                var title = FirstText(item.Title, item.DisplayTitle, item.BlockDisplayTitle);
                                var text = FirstText(PlainText(item.Intro), PlainText(item.year));
                                var year = HasYearValue(item.year) ? PlainText(item.year) : "";
                                if (string.IsNullOrWhiteSpace(PlainText(item.Intro)) && !HasYearValue(item.year))
                                {
                                    text = PlainText(item.year);
                                    year = "";
                                }
                                else if (!string.IsNullOrWhiteSpace(PlainText(item.Intro)))
                                {
                                    text = PlainText(item.Intro);
                                }
                                var popupIntro = FirstText(item.Popup_Content);
                                var hasPopup = !string.IsNullOrWhiteSpace(PlainText(popupIntro));
                                var modalRole = FirstText(year, text);

                                <li class="award-card card-rise"
                                    @if (hasPopup)
                                    {
                                        <text>data-award role="button" tabindex="0" aria-haspopup="dialog" aria-controls="award-modal"</text>
                                    }>
                                    <div class="award-card__media">
                                        @if (!string.IsNullOrWhiteSpace(image))
                                        {
                                            <img src="@image" alt="@alt" loading="lazy" @(hasPopup ? Html.Raw("data-award-photo") : null)>
                                        }
                                    </div>
                                    <div class="award-card__body">
                                        @if (!string.IsNullOrWhiteSpace(title))
                                        {
                                            <h4 class="award-card__title" @(hasPopup ? Html.Raw("data-award-name") : null)>@title</h4>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(text))
                                        {
                                            <p class="award-card__text">@text</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(year))
                                        {
                                            <span class="award-card__year">@year</span>
                                        }
                                    </div>
                                    @if (hasPopup)
                                    {
                                        <span class="sr-only" data-award-role>@modalRole</span>
                                        <div class="hidden" hidden data-award-bio>
                                            @Html.Raw(popupIntro)
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                        <button type="button" class="awards-arrow awards-arrow--next" data-aw-next aria-label="Next award">
                            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                    </div>
                </div>
            }
        </div>
    </section>
}

@if (certsSection != null && certsSection.Groups.Any(g => g.Items.Count > 0))
{
    <section class="relative section-spacing bg-gray certs-outer">
        <div class="container">
            <div class="certs-head">
                <h2 class="text-h2 certs-head__title">@certsSection.Title</h2>
                @if (!string.IsNullOrWhiteSpace(certsSection.Intro))
                {
                    <div class="certs-head__intro text-p">@Html.Raw(certsSection.Intro)</div>
                }
            </div>

            <div class="certs-grid card-list-items" data-certs>
                @foreach (var group in certsSection.Groups.Where(g => g.Items.Count > 0))
                {
                    <article class="cert-card card-rise" data-cert>
                        <div class="cert-card__head">
                            <h3 class="cert-card__title font-uniNeueBold">@group.Title</h3>
                        </div>
                        <ul class="cert-track" data-cert-track>
                            @foreach (var item in group.Items)
                            {
                                var image = FirstPath(item.ThumbnailImage, item.ComponentThumbnail, item.Component_LHS_thumbnail);
                                var alt = FirstText(item.ThumbnailAltText, item.ComponentThumbnailAltText, item.Title);
                                var title = FirstText(item.Title, item.DisplayTitle, item.BlockDisplayTitle);
                                <li class="cert-item">
                                    <div class="cert-item__logo">
                                        @if (!string.IsNullOrWhiteSpace(image))
                                        {
                                            <img src="@image" alt="@alt" loading="lazy">
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(title))
                                    {
                                        <p class="cert-item__name text-14">@title</p>
                                    }
                                </li>
                            }
                        </ul>
                    </article>
                }
            </div>
        </div>
    </section>
}

<dialog class="leader-modal" id="award-modal" aria-labelledby="award-modal-name">
    <div class="leader-modal__backdrop" data-award-close></div>
    <div class="leader-modal__panel">
        <button type="button" class="leader-modal__close" data-award-close aria-label="Close award details">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
        </button>
        <div class="leader-modal__scroll" data-lenis-prevent tabindex="-1">
            <div class="leader-modal__media">
                <div class="leader-modal__photo">
                    <img src="" alt="" data-award-modal-photo>
                </div>
            </div>
            <div class="leader-modal__content">
                <h2 class="leader-modal__name" id="award-modal-name" data-award-modal-name></h2>
                <p class="leader-modal__role" data-award-modal-role></p>
                <span class="leader-modal__rule" aria-hidden="true"></span>
                <div class="leader-modal__bio" data-award-modal-bio></div>
            </div>
        </div>
    </div>
</dialog>

@section Scripts {
    <script src="~/Assets/js/card-animation.js" asp-append-version="true"></script>
    <script src="~/Assets/js/awards-slider.js" asp-append-version="true"></script>
    <script src="~/Assets/js/awards-modal.js" asp-append-version="true"></script>
}

@functions {
    private static string FirstText(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value)) return value;
        }
        return "";
    }

    private static string FirstPath(params string?[] values) => FirstText(values);

    private static string PlainText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";
        var plain = System.Text.RegularExpressions.Regex.Replace(value, "<[^>]+>", " ");
        return System.Text.RegularExpressions.Regex.Replace(plain, @"\s+", " ").Trim();
    }

    private static bool HasYearValue(string? value)
    {
        var plain = PlainText(value);
        if (string.IsNullOrWhiteSpace(plain)) return false;
        return System.Text.RegularExpressions.Regex.IsMatch(plain, @"\d{4}");
    }
}
