@using GBL_MVC.Helpers
@model GBL_BusinessLogic.Entity.AboutModel
@{
    ViewData["Title"] = Model?.Content?.ContTitle ?? "Our Legacy";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var content = Model?.Content;

    var familySection = Model?.Founding_Family_List?.FirstOrDefault(x => x.IsBlock == 0);
    var familyItems = (Model?.Founding_Family_List?.Where(x => x.IsBlock == 1).OrderBy(x => x.Sequence).ToList()
        ?? new List<GBL_BusinessLogic.Entity.ComponentModel>());
    if (!familyItems.Any() && Model?.Founding_Family_List?.Any() == true)
    {
        familyItems = Model.Founding_Family_List.OrderBy(x => x.Sequence).ToList();
    }

    var milestoneSection = Model?.Milestones_List?.FirstOrDefault(x => x.IsBlock == 0);
    var milestoneItems = (Model?.Milestones_List?.Where(x => x.IsBlock == 1).OrderBy(x => x.Sequence).ToList()
        ?? new List<GBL_BusinessLogic.Entity.ComponentModel>());
    if (!milestoneItems.Any() && Model?.Milestones_List?.Any() == true)
    {
        milestoneItems = Model.Milestones_List.OrderBy(x => x.Sequence).ToList();
    }

    string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)) ?? "";

    bool LooksLikeYear(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        var t = value.CleanParagraphTags().Trim();
        return t.Length >= 4 && t.Take(4).All(char.IsDigit);
    }
}

@section head {
   <title>@(content?.cont_window_title ?? ViewData["Title"])</title>
   <meta content="@(content?.cont_metatag)" name="keywords" />
   <meta content="@(content?.cont_metadesc)" name="description" />
   <meta property="og:title" content="@(content?.ContTitle)" />
   <meta property="og:description" content="@(content?.cont_metadesc)" />
   <meta property="og:image" content="@(content?.cont_meta_image)" />
   <link rel="canonical" href="@(content?.CanonicalUrl)" />
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/our-legacy.css" asp-append-version="true" />
}

@if (Model?.Content != null)
{
   @await Html.PartialAsync("~/Views/CommonComponent/_page_banner.cshtml", Model.Content)
}
else
{
   <section class="relative inside-banner-outer">
      <div class="inside-banner-inner banner-animation relative">
         <div class="overflow-hidden h-[75vh] sm:h-[700px] relative innerbanner-image-wrapper">
            <picture>
               <source media="(min-width:1024px)" srcset="~/Assets/images/banners/product-banner-desktop.webp">
               <img src="~/Assets/images/banners/product-banner-desktop.webp" alt="Our Legacy"
                    class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                    loading="eager" fetchpriority="high">
            </picture>
            <div class="innerbanner-overlay"></div>
         </div>
         <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
            <div class="container">
               <div class="max-w-4xl text-left">
                  <h1 class="innerbanner-title text-h1 text-white title-animation">Our Legacy</h1>
                  <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                     <ol class="flex items-center gap-2 text-sm">
                        <li><a href="/" class="text-white/70 hover:text-white transition">Home</a></li>
                        <li class="text-white/60">/</li>
                        <li class="text-white">Our Legacy</li>
                     </ol>
                  </nav>
               </div>
            </div>
         </div>
      </div>
   </section>
}

@if (!string.IsNullOrWhiteSpace(Model?.Content?.Cont_intro))
{
   <section class="relative overflow-hidden section-spacing page-intro-outer bg-gray">
      <div class="container">
         <div class="page-intro-inner intro-lg text-center">
            @Html.Raw(Model.Content.Cont_intro)
         </div>
      </div>
   </section>
}
else if (!string.IsNullOrWhiteSpace(Model?.Content?.Content))
{
   <section class="relative overflow-hidden section-spacing page-intro-outer bg-gray">
      <div class="container">
         <div class="page-intro-inner intro-lg text-center">
            @Html.Raw(Model.Content.Content)
         </div>
      </div>
   </section>
}

@if (familyItems.Any())
{
   <section class="relative section-spacing family-outer">
      <div class="container">
         <div class="section-intro">
            <div class="section-intro__title title-section">
               <h2 class="text-h2">
                  @Html.Raw(FirstNonEmpty(familySection?.Title, familySection?.DisplayTitle, "Our Founding Family").CleanParagraphTags())
               </h2>
            </div>
         </div>

         <div class="family-list">
            @for (var i = 0; i < familyItems.Count; i++)
            {
               var item = familyItems[i];
               var isReverse = i % 2 == 1;
               var img = FirstNonEmpty(item.ThumbnailImage, item.ComponentThumbnail);
               var alt = FirstNonEmpty(item.ThumbnailAltText, item.ComponentThumbnailAltText, item.Title);
               var nameId = $"family-{item.Sequence}-{i}";
               var name = item.Title?.CleanParagraphTags() ?? "";
               var eyebrow = item.Section_title?.CleanParagraphTags() ?? "";
               var years = item.year?.CleanParagraphTags() ?? "";

               <article class="family-card@(isReverse ? " family-card--reverse" : "")" aria-labelledby="@nameId">
                  <div class="family-card__media">
                     @if (!string.IsNullOrWhiteSpace(img))
                     {
                        <img src="@img" alt="@alt" loading="lazy">
                     }
                  </div>
                  <div class="family-card__content">
                     @if (!string.IsNullOrWhiteSpace(eyebrow))
                     {
                        <span class="family-card__eyebrow">@Html.Raw(eyebrow)</span>
                     }
                     @if (!string.IsNullOrWhiteSpace(name))
                     {
                        <h3 class="family-card__name" id="@nameId">@Html.Raw(name)</h3>
                     }
                     @if (!string.IsNullOrWhiteSpace(years))
                     {
                        <span class="family-card__years">@Html.Raw(years)</span>
                     }
                     @if (!string.IsNullOrWhiteSpace(item.Content))
                     {
                        <div class="family-card__body">
                           @Html.Raw(item.Content)
                        </div>
                     }
                  </div>
               </article>
            }
         </div>
      </div>
   </section>
}

@if (milestoneItems.Any())
{
   var total = milestoneItems.Count;

   <section class="relative section-spacing milestones-outer">
      <div class="container">
         <div class="section-intro">
            <div class="section-intro__title title-section">
               <h2 class="text-h2">
                  @Html.Raw(FirstNonEmpty(milestoneSection?.Title, milestoneSection?.DisplayTitle, "Milestones").CleanParagraphTags())
               </h2>
            </div>
         </div>

         <div class="milestones" data-milestones
              role="region" aria-roledescription="carousel" aria-label="Company milestones">

            <button type="button" class="milestones-arrow milestones-arrow--prev" data-ms-prev aria-label="Previous milestone">
               <svg viewBox="0 0 32 16" fill="none" aria-hidden="true"><path d="M31 8H1M8 1L1 8l7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>

            <div class="milestones-viewport">
               <div class="milestones-track" style="--ms-index:0">
                  @for (var i = 0; i < milestoneItems.Count; i++)
                  {
                     var item = milestoneItems[i];
                     var rawTitle = item.Title?.CleanParagraphTags() ?? "";
                     var rawIntro = item.Intro?.CleanParagraphTags() ?? "";
                     var yearText = item.year?.CleanParagraphTags() ?? "";

                     if (string.IsNullOrWhiteSpace(yearText) && LooksLikeYear(rawTitle))
                     {
                        yearText = rawTitle;
                     }

                     string titleText;
                     string? bodyHtml;
                     if (!string.IsNullOrWhiteSpace(yearText)
                         && string.Equals(rawTitle, yearText, StringComparison.OrdinalIgnoreCase))
                     {
                        titleText = rawIntro;
                        bodyHtml = item.Content;
                     }
                     else
                     {
                        titleText = rawTitle;
                        bodyHtml = !string.IsNullOrWhiteSpace(item.Content) ? item.Content : item.Intro;
                     }

                     if (string.IsNullOrWhiteSpace(titleText) && !string.IsNullOrWhiteSpace(rawIntro))
                     {
                        titleText = rawIntro;
                        if (string.Equals(bodyHtml?.CleanParagraphTags(), rawIntro, StringComparison.OrdinalIgnoreCase))
                        {
                           bodyHtml = null;
                        }
                     }

                     var img = FirstNonEmpty(item.ThumbnailImage, item.ComponentThumbnail);
                     var alt = FirstNonEmpty(item.ThumbnailAltText, item.ComponentThumbnailAltText, titleText, yearText);
                     var isFirst = i == 0;
                     var isLast = i == total - 1;
                     var loading = (isFirst || isLast) ? "eager" : "lazy";
                     var label = $"{(string.IsNullOrWhiteSpace(yearText) ? titleText : yearText)}, {i + 1} of {total}";

                     <article class="milestone-slide@(isFirst ? " is-active" : "")"
                              data-ms-slide="@i"
                              role="group"
                              aria-roledescription="slide"
                              aria-label="@label"
                              aria-hidden="@(isFirst ? "false" : "true")">
                        <div class="milestone-slide__media">
                           @if (!string.IsNullOrWhiteSpace(img))
                           {
                              <img src="@img" alt="@alt" loading="@loading">
                           }
                        </div>
                        <div class="milestone-slide__content">
                           <div class="milestone-slide__content-inner">
                              @if (!string.IsNullOrWhiteSpace(yearText))
                              {
                                 <span class="milestone-slide__year">@Html.Raw(yearText)</span>
                              }
                              <div>
                                 @if (!string.IsNullOrWhiteSpace(titleText))
                                 {
                                    <h3 class="milestone-slide__title">@Html.Raw(titleText)</h3>
                                 }
                                 @if (!string.IsNullOrWhiteSpace(bodyHtml))
                                 {
                                    <div class="milestone-slide__text">@Html.Raw(bodyHtml)</div>
                                 }
                              </div>
                           </div>
                        </div>
                     </article>
                  }
               </div>
            </div>

            <button type="button" class="milestones-arrow milestones-arrow--next" data-ms-next aria-label="Next milestone">
               <svg viewBox="0 0 32 16" fill="none" aria-hidden="true"><path d="M1 8h30M24 1l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>

            <div class="milestones-timeline">
               <ol class="milestones-years">
                  @for (var i = 0; i < milestoneItems.Count; i++)
                  {
                     var item = milestoneItems[i];
                     var rawTitle = item.Title?.CleanParagraphTags() ?? "";
                     var yearText = item.year?.CleanParagraphTags() ?? "";
                     if (string.IsNullOrWhiteSpace(yearText) && LooksLikeYear(rawTitle))
                     {
                        yearText = rawTitle;
                     }
                     if (string.IsNullOrWhiteSpace(yearText))
                     {
                        yearText = FirstNonEmpty(rawTitle, (i + 1).ToString());
                     }
                     var isFirst = i == 0;

                     <li>
                        @if (isFirst)
                        {
                           <button type="button" class="milestones-year is-active" data-ms-year="@i" aria-label="Go to @yearText" aria-current="step">@Html.Raw(yearText)</button>
                        }
                        else
                        {
                           <button type="button" class="milestones-year" data-ms-year="@i" aria-label="Go to @yearText">@Html.Raw(yearText)</button>
                        }
                     </li>
                  }
               </ol>
            </div>
         </div>
      </div>
   </section>
}

@section Scripts {
   <script src="~/Assets/js/milestones-slider.js" asp-append-version="true"></script>
}
