@using GBL_MVC.Helpers
@model GBL_BusinessLogic.Entity.AboutModel
@{
    ViewData["Title"] = Model?.Content?.ContTitle ?? "Our Vision";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var content = Model?.Content;

    string FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)) ?? "";

    // "Our Guiding Principles: We live by them every day" → "Our Guiding Principles" (matches design)
    string SectionHeading(string? raw, string fallback)
    {
        var t = (raw ?? "").CleanParagraphTags().Trim();
        if (string.IsNullOrWhiteSpace(t)) return fallback;
        var idx = t.IndexOf(':');
        return idx > 0 ? t[..idx].Trim() : t;
    }

    string AsParagraph(string? html)
    {
        var value = (html ?? "").Trim();
        if (string.IsNullOrWhiteSpace(value)) return "";
        if (value.Contains('<')) return value;
        return $"<p>{System.Net.WebUtility.HtmlEncode(value)}</p>";
    }

    // Page details
    var bannerTitle = FirstNonEmpty(content?.ContTitle, "Our Vision");
    var bannerImg = FirstNonEmpty(content?.MastheadImage, Url.Content("~/Assets/images/banners/sustainability-banner.webp"));
    var bannerAlt = FirstNonEmpty(content?.Masthead_image_Alt_text, bannerTitle);
    var landingTitle = content?.ContHmpgTitle?.Trim() ?? "";
    var landingIntro = FirstNonEmpty(content?.Cont_hmpg_intro);
    var pageIntroCopy = FirstNonEmpty(content?.Cont_intro, content?.Content);
    var hasVisionIntro = !string.IsNullOrWhiteSpace(landingIntro)
        || !string.IsNullOrWhiteSpace(landingTitle)
        || !string.IsNullOrWhiteSpace(pageIntroCopy);

    // ========== Component 1: Our Guiding Principles ==========
    // IsBlock 0 → Component Title, Component Intro, Component Background image
    // IsBlock 1 → Title, Intro, Thumbnail Image (icon), Sequence
    var principlesSection = Model?.Guiding_Principles_List?.FirstOrDefault(x => x.IsBlock == 0);
    var principleItems = (Model?.Guiding_Principles_List?.Where(x => x.IsBlock == 1)
            .OrderBy(x => x.Sequence).ThenBy(x => x.Title).ToList()
        ?? new List<GBL_BusinessLogic.Entity.ComponentModel>());

    var principlesTitle = SectionHeading(
        FirstNonEmpty(principlesSection?.Title, principlesSection?.DisplayTitle, principlesSection?.BlockDisplayTitle),
        "Our Guiding Principles");
    var principlesIntro = FirstNonEmpty(principlesSection?.Intro, principlesSection?.HmpgIntro, principlesSection?.Content);
    var principlesBg = FirstNonEmpty(
        principlesSection?.Componentbackground,
        principlesSection?.ComponentThumbnail,
        Url.Content("~/Assets/images/our-vision/guiding-principles-bg.webp"));

    // ========== Component 2: Our Mission ==========
    // IsBlock 0 → Title, Component Background image
    // IsBlock 1 → Title (mission line list)
    var missionSection = Model?.Our_Mission_List?.FirstOrDefault(x => x.IsBlock == 0);
    var missionItems = (Model?.Our_Mission_List?.Where(x => x.IsBlock == 1)
            .OrderBy(x => x.Sequence).ThenBy(x => x.Title).ToList()
        ?? new List<GBL_BusinessLogic.Entity.ComponentModel>());

    var missionTitle = SectionHeading(
        FirstNonEmpty(missionSection?.Title, missionSection?.DisplayTitle, missionSection?.BlockDisplayTitle),
        "Our Mission");
    var missionBg = FirstNonEmpty(
        missionSection?.Componentbackground,
        missionSection?.ThumbnailImage,
        Url.Content("~/Assets/images/our-vision/our-mission-bg.webp"));
}

@section head {
   <title>@(content?.cont_window_title ?? ViewData["Title"])</title>
   <meta content="@(content?.cont_metatag)" name="keywords" />
   <meta content="@(content?.cont_metadesc)" name="description" />
   <meta property="og:title" content="@(content?.ContTitle)" />
   <meta property="og:description" content="@(content?.cont_metadesc)" />
   <meta property="og:image" content="@(content?.cont_meta_image)" />
   <link rel="canonical" href="@(content?.CanonicalUrl)" />
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />
   <link rel="preconnect" href="https://fonts.googleapis.com">
   <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400&display=swap" rel="stylesheet">
   <link rel="stylesheet" href="~/Assets/css/sustainability-intro.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/our-vision.css" asp-append-version="true" />
}

<section class="relative inside-banner-outer">
   <div class="inside-banner-inner banner-animation relative">
      <div class="overflow-hidden h-[75vh] sm:h-[700px] relative innerbanner-image-wrapper">
         <picture>
            <source media="(min-width:1024px)" srcset="@bannerImg">
            <img src="@bannerImg" alt="@bannerAlt"
                 class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                 loading="eager" fetchpriority="high">
         </picture>
         <div class="innerbanner-overlay"></div>
      </div>
      <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
         <div class="container">
            <div class="max-w-4xl text-left">
               <h1 class="innerbanner-title text-h1 text-white title-animation">
                  @Html.Raw(bannerTitle.CleanParagraphTags())
               </h1>
               <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                  @if (!string.IsNullOrWhiteSpace(content?.BreadcrumPath))
                  {
                     @Html.Raw(content.BreadcrumPath.CleanParagraphTags())
                  }
                  else
                  {
                     <ol class="flex items-center gap-2 text-sm">
                        <li><a href="/" class="text-white/70 hover:text-white transition">Home</a></li>
                        <li class="text-white/60">/</li>
                        <li><a href="/about-us" class="text-white/70 hover:text-white transition">About Us</a></li>
                        <li class="text-white/60">/</li>
                        <li class="text-white">Our Vision &amp; Mission</li>
                     </ol>
                  }
               </nav>
            </div>
         </div>
      </div>
   </div>
</section>

@if (hasVisionIntro)
{
   <section class="page-intro-outer page-intro-outer--mantra page-intro-outer--vision" aria-label="Our operating principle">
      <div class="container">
         <div class="page-intro-mantra">
            <blockquote class="page-intro-mantra__quote">
               @if (!string.IsNullOrWhiteSpace(landingIntro))
               {
                  @Html.Raw(landingIntro)
               }
               @if (!string.IsNullOrWhiteSpace(landingTitle)
                    && (string.IsNullOrWhiteSpace(landingIntro)
                        || !landingIntro.Contains(landingTitle, StringComparison.Ordinal)))
               {
                  <h2 class="page-intro-mantra__sanskrit text-h1">@Html.Raw(landingTitle.CleanParagraphTags())</h2>
               }
            </blockquote>
            @if (!string.IsNullOrWhiteSpace(pageIntroCopy))
            {
               <div class="page-intro-mantra__copy">
                  @Html.Raw(pageIntroCopy)
               </div>
            }
         </div>
      </div>
   </section>
}

@* ========== 1. Our Guiding Principles ==========
   Main (IsBlock=0): Component Title, Component Intro, Component Background image
   Blocks (IsBlock=1): Title, Intro, Thumbnail Image *@
@if (principlesSection != null || principleItems.Any())
{
   <section class="guiding-principles bg-parallax-section" aria-labelledby="guiding-principles-title">
      <div class="parallax-wrap guiding-principles__bg" aria-hidden="true">
         <img src="@principlesBg" alt="" class="parallax-img" loading="lazy">
      </div>
      <div class="guiding-principles__veil" aria-hidden="true"></div>

      <div class="container guiding-principles__inner">
         <div class="guiding-principles__head">
            <h2 id="guiding-principles-title" class="text-h2 title-animation guiding-principles__title">
               @Html.Raw(principlesTitle)
            </h2>
            @if (!string.IsNullOrWhiteSpace(principlesIntro))
            {
               <div class="guiding-principles__intro">@Html.Raw(principlesIntro)</div>
            }
         </div>

         @if (principleItems.Any())
         {
            <ul class="guiding-principles__panel card-list-items">
               @foreach (var item in principleItems)
               {
                  var cardTitle = item.Title?.CleanParagraphTags() ?? "";
                  var cardIntro = FirstNonEmpty(item.Intro, item.Content);
                  var cardIcon = FirstNonEmpty(
                      item.ThumbnailImage,
                      item.ComponentThumbnail,
                      item.Icon_Image,
                      item.Component_Icon_Image);
                  var cardAlt = FirstNonEmpty(item.ThumbnailAltText, item.ComponentThumbnailAltText, cardTitle);

                  <li class="principle-item card-rise">
                     @if (!string.IsNullOrWhiteSpace(cardIcon))
                     {
                        <span class="principle-item__icon">
                           <img src="@cardIcon" alt="@cardAlt" width="48" height="48">
                        </span>
                     }
                     @if (!string.IsNullOrWhiteSpace(cardTitle))
                     {
                        <h3 class="principle-item__title">@Html.Raw(cardTitle)</h3>
                     }
                     @if (!string.IsNullOrWhiteSpace(cardIntro))
                     {
                        @Html.Raw(AsParagraph(cardIntro))
                     }
                  </li>
               }
            </ul>
         }
      </div>
   </section>
}

@* ========== 2. Our Mission ==========
   Main (IsBlock=0): Title, Component Background image
   Blocks (IsBlock=1): Title list *@
@if (missionSection != null || missionItems.Any())
{
   <section class="our-mission" aria-labelledby="our-mission-title">
      <div class="our-mission__bg" aria-hidden="true">
         <img src="@missionBg" alt="" class="our-mission__img" loading="lazy">
      </div>

      <div class="container our-mission__inner">
         <h2 id="our-mission-title" class="text-h2 title-animation our-mission__title">
            @Html.Raw(missionTitle)
         </h2>

         @if (missionItems.Any())
         {
            <ul class="our-mission__list card-list-items">
               @foreach (var item in missionItems)
               {
                  var line = item.Title?.CleanParagraphTags() ?? "";
                  if (string.IsNullOrWhiteSpace(line))
                  {
                     continue;
                  }
                  <li class="card-rise">@Html.Raw(line)</li>
               }
            </ul>
         }
      </div>
   </section>
}

@section Scripts {
   <script src="~/Assets/js/card-animation.js" asp-append-version="true"></script>
   <script src="~/Assets/js/our-vision.js" asp-append-version="true"></script>
}
