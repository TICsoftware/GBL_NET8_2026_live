@model List<GBL_BusinessLogic.Entity.ArticleModel>
@using System.Globalization
@using GBL_BusinessLogic.BAL
@{
    int? visibleCount = ViewData["PdfVisibleCount"] is int count ? count : null;
    var filterYear = ViewData["PdfYear"] as string;
    var shown = 0;
}

@if (Model != null)
{
    foreach (var item in Model)
    {
        var href = !string.IsNullOrWhiteSpace(item.Url)
            ? item.Url
            : (!string.IsNullOrWhiteSpace(item.MediafilePath) ? item.MediafilePath : item.ExternalUrl);

        var title = item.Title;
        if (DateTime.TryParse(title, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsedTitle)
            || DateTime.TryParse(title, out parsedTitle))
        {
            title = parsedTitle.ToString("dd MMM yyyy", CultureInfo.InvariantCulture);
        }

        var yearKey = CorporateGovernance_BAL.FinancialYearKey(item);
        var yearMatch = string.IsNullOrWhiteSpace(filterYear)
            || string.Equals(yearKey, filterYear, StringComparison.OrdinalIgnoreCase);

        var hideMore = false;
        if (yearMatch)
        {
            if (visibleCount.HasValue && shown >= visibleCount.Value)
            {
                hideMore = true;
            }
            shown++;
        }

        var isHidden = !yearMatch || hideMore;
        <li class="card-rise" data-year="@yearKey" @(isHidden ? "hidden" : null)>
            <a class="cg-doc"
               href="@(string.IsNullOrWhiteSpace(href) ? "#" : href)"
               target="_blank"
               rel="noopener noreferrer">
                <span class="cg-doc__title">@title</span>
                <span class="cg-doc__icon" aria-hidden="true"></span>
            </a>
        </li>
    }
}
