@using System.Globalization
@using GBL_MVC.Helpers
@model GBL_BusinessLogic.Entity.InvestorRelationsModel
@{
    ViewData["Title"] = Model?.Content?.ContTitle ?? "Investor Relations";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var content = Model?.Content;
    var intro = FirstText(content?.Cont_intro, content?.Cont_hmpg_intro);
    var press = Model?.WhatsNewPress ?? new List<GBL_BusinessLogic.Entity.ArticleModel>();
    var media = Model?.WhatsNewMedia ?? new List<GBL_BusinessLogic.Entity.ArticleModel>();
    var quarter = Model?.LatestQuarter;
    var annual = Model?.LatestAnnualReport;
    var shareholderLinks = Model?.ShareholderLinks ?? new List<GBL_BusinessLogic.Entity.InvestorLinkModel>();
    var leftCount = shareholderLinks.Count == 0 ? 0 : (int)Math.Ceiling(shareholderLinks.Count / 2.0);
    var shareholderLeft = shareholderLinks.Take(leftCount).ToList();
    var shareholderRight = shareholderLinks.Skip(leftCount).ToList();
    var governanceLinks = Model?.GovernanceLinks ?? new List<GBL_BusinessLogic.Entity.InvestorLinkModel>();
    var subsidiaryLinks = Model?.SubsidiaryLinks ?? new List<GBL_BusinessLogic.Entity.InvestorLinkModel>();
    var contactList = Model?.InvestorContact_List ?? new List<GBL_BusinessLogic.Entity.ComponentModel>();
    var contactTitle = string.IsNullOrWhiteSpace(Model?.InvestorContactTitle) ? "Investor Contact" : Model.InvestorContactTitle;
    var governanceBg = string.IsNullOrWhiteSpace(Model?.GovernanceBackground)
        ? "/Assets/images/investors/governance-img1.webp"
        : Model.GovernanceBackground;
    var shareholderImg = string.IsNullOrWhiteSpace(Model?.ShareholderImage)
        ? "/Assets/images/investors/information-img.webp"
        : Model.ShareholderImage;
    var subsidiariesImg = string.IsNullOrWhiteSpace(Model?.SubsidiariesImage)
        ? "/Assets/images/investors/subsidiaries-img.webp"
        : Model.SubsidiariesImage;
    var annualHref = FirstText(annual?.MediafilePath, annual?.Url, annual?.ExternalUrl);
    var annualThumb = FirstText(annual?.ThumbnailImage, "/Assets/images/investors/annual-report-img.webp");
}

@section head {
    <title>@(content?.cont_window_title)</title>
    <meta content="@(content?.cont_metatag)" name="keywords" />
    <meta content="@(content?.cont_metadesc)" name="description" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@(content?.ContTitle)" />
    <meta name="twitter:description" content="@(content?.cont_metadesc)" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Godavari Biorefineries" />
    <meta property="og:title" content="@(content?.ContTitle)" />
    <meta property="og:description" content="@(content?.cont_metadesc)" />
    <meta property="og:url" content="@(content?.CanonicalUrl)" />
    <meta property="og:image" content="@(content?.cont_meta_image)" />
    <link rel="canonical" href="@(content?.CanonicalUrl)" />
}

@section Styles {
    <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Assets/css/investor.css" asp-append-version="true" />
}

@if (content != null && content.ContId > 0)
{
    @await Html.PartialAsync("~/Views/CommonComponent/_page_banner.cshtml", content)
}
else
{
    <section class="relative inside-banner-outer">
        <div class="inside-banner-inner banner-animation relative">
            <div class="overflow-hidden h-[75vh] sm:h-[700px] relative innerbanner-image-wrapper">
                <picture>
                    <source media="(min-width:1024px)" srcset="~/Assets/images/banners/investor-banner.webp">
                    <img src="~/Assets/images/banners/investor-banner.webp" alt="Investor Relations"
                         class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                         loading="eager" fetchpriority="high">
                </picture>
                <div class="innerbanner-overlay"></div>
            </div>
            <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
                <div class="container">
                    <div class="max-w-4xl text-left">
                        <h1 class="innerbanner-title text-h1 text-white title-animation">Investor Relations</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

@if (!string.IsNullOrWhiteSpace(intro))
{
    <section class="relative overflow-hidden section-spacing page-intro-outer bg-gray">
        <div class="container">
            <div class="page-intro-inner intro-lg text-center">
                @Html.Raw(intro)
            </div>
        </div>
    </section>
}
else
{
    <section class="relative overflow-hidden section-spacing page-intro-outer bg-gray">
        <div class="container">
            <div class="page-intro-inner intro-lg text-center">
                <p>Godavari Biorefineries Ltd. is committed to disciplined corporate governance, transparent market disclosures and consistent shareholder communication. This repository houses all essential investor information, including financial statements, share and stock data, statutory policies, press releases and meeting disclosures to support informed decision-making.</p>
            </div>
        </div>
    </section>
}

<section class="whatsNew section-spacing" aria-labelledby="whats-new-title">
    <div class="container">
        <h2 id="whats-new-title" class="whatsNew__title text-h2">What's New</h2>

        <div class="whatsNew__grid">
            @foreach (var item in press)
            {
                var href = string.IsNullOrWhiteSpace(item.Url) ? "/media/press-release" : item.Url;
                <article class="whatsNew__card">
                    <p class="whatsNew__meta">
                        <span class="whatsNew__tag">@(string.IsNullOrWhiteSpace(item.Tag_list) ? "Press Release" : item.Tag_list)</span>
                        @if (item.DisplayDate.HasValue)
                        {
                            <time datetime="@item.DisplayDate.Value.ToString("yyyy-MM-dd")">@item.DisplayDate.Value.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture)</time>
                        }
                    </p>
                    <h3>@Html.Raw((item.Title ?? "").CleanParagraphTags())</h3>
                    <a href="@href" class="site-btn site-btn--line" target="@(item.UrlTarget ?? "_self")">
                        <span class="site-btn__label">Read More</span>
                        <span class="site-btn__arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                    </a>
                </article>
            }

            @foreach (var item in media)
            {
                var href = string.IsNullOrWhiteSpace(item.Url) ? "/media/media-coverage" : item.Url;
                var copy = FirstText(item.HmpgIntro, item.Intro, item.Title);
                <article class="whatsNew__card whatsNew__card--media">
                    @if (!string.IsNullOrWhiteSpace(item.ThumbnailImage))
                    {
                        <div class="whatsNew__media">
                            <img src="@item.ThumbnailImage" alt="@(string.IsNullOrWhiteSpace(item.ThumbnailAltText) ? item.Title : item.ThumbnailAltText)">
                        </div>
                    }
                    <p class="whatsNew__meta">
                        <span class="whatsNew__tag">@(string.IsNullOrWhiteSpace(item.Tag_list) ? "Media Coverage" : item.Tag_list)</span>
                        @if (item.DisplayDate.HasValue)
                        {
                            <time datetime="@item.DisplayDate.Value.ToString("yyyy-MM-dd")">@item.DisplayDate.Value.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture)</time>
                        }
                    </p>
                    <p>@Html.Raw((copy ?? "").CleanParagraphTags())</p>
                    <a href="@href" class="site-btn site-btn--line" target="@(item.UrlTarget ?? "_self")">
                        <span class="site-btn__label">Read More</span>
                        <span class="site-btn__arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                    </a>
                </article>
            }

            <div class="whatsNew__aside">
                <div class="whatsNew__quote" data-inv-quote>
                    <script type="module" src="https://widgets.tradingview-widget.com/w/en/tv-single-ticker.js"></script>
                    <tv-single-ticker symbol="BSE:GODAVARIB"></tv-single-ticker>
                </div>
                <article class="whatsNew__card whatsNew__card--note">
                    <h3>Announcement</h3>
                    <p>Nam vel sapien sit amet ipsum laoreet aliquam. Donec iaculis semper est non aliquam.</p>
                    <a href="/media/press-release" class="site-btn site-btn--line">
                        <span class="site-btn__label">Read More</span>
                        <span class="site-btn__arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                    </a>
                </article>
            </div>
        </div>

        <a href="/media/press-release" class="site-btn site-btn--outline">
            <span class="site-btn__label">View All</span>
            <span class="site-btn__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
        </a>
    </div>
</section>

<section class="quarterlyResults section-spacing">
    <div class="container">
        <div class="qr-row">
            <div class="qr-col">
                <h2 class="text-h2">Quarterly results</h2>
                <div class="qr-panel">
                    <span class="qr-panel__mark" aria-hidden="true">@(string.IsNullOrWhiteSpace(quarter?.QuarterCode) ? "Q1" : quarter.QuarterCode)</span>
                    <ul class="qr-files">
                        @if (!string.IsNullOrWhiteSpace(quarter?.FinancialResultsUrl))
                        {
                            <li>
                                <a href="@quarter.FinancialResultsUrl" target="_blank" rel="noopener noreferrer">
                                    <span>Financial Results</span>
                                    <img src="@Url.Content("~/Assets/images/homepage/our-performance/pdf-icon.svg")" alt="" width="28" height="28">
                                </a>
                            </li>
                        }
                        @if (!string.IsNullOrWhiteSpace(quarter?.TranscriptUrl))
                        {
                            <li>
                                <a href="@quarter.TranscriptUrl" target="_blank" rel="noopener noreferrer">
                                    <span>Transcript</span>
                                    <img src="@Url.Content("~/Assets/images/homepage/our-performance/pdf-icon.svg")" alt="" width="28" height="28">
                                </a>
                            </li>
                        }
                        @if (!string.IsNullOrWhiteSpace(quarter?.ResultsPresentationUrl))
                        {
                            <li>
                                <a href="@quarter.ResultsPresentationUrl" target="_blank" rel="noopener noreferrer">
                                    <span>Presentations</span>
                                    <img src="@Url.Content("~/Assets/images/homepage/our-performance/pdf-icon.svg")" alt="" width="28" height="28">
                                </a>
                            </li>
                        }
                        @if (!string.IsNullOrWhiteSpace(quarter?.AudioUrl))
                        {
                            <li>
                                <a href="@quarter.AudioUrl" target="_blank" rel="noopener noreferrer">
                                    <span>Audio</span>
                                    <img src="@Url.Content("~/Assets/images/homepage/our-performance/voice-icon.svg")" alt="" width="28" height="28">
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                <a href="/investor-relations/quarterly-reports" class="site-btn site-btn--outline">
                    <span class="site-btn__label">View All Quarterly</span>
                    <span class="site-btn__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                </a>
            </div>

            <div class="qr-col">
                <h2 class="text-h2">Annual report</h2>
                <div class="qr-panel qr-panel--report">
                    <img src="@annualThumb" alt="@(string.IsNullOrWhiteSpace(annual?.ThumbnailAltText) ? annual?.Title : annual.ThumbnailAltText)">
                    <div class="qr-report__copy">
                        @if (!string.IsNullOrWhiteSpace(annual?.Title))
                        {
                            <p>@Html.Raw(annual.Title.CleanParagraphTags())</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(annualHref))
                        {
                            <a href="@annualHref" class="site-btn site-btn--line" target="_blank" rel="noopener noreferrer">
                                <span class="site-btn__label">Download</span>
                                <span class="site-btn__arrow" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </span>
                            </a>
                        }
                    </div>
                </div>
                <a href="/investor-relations/annual-reports" class="site-btn site-btn--outline">
                    <span class="site-btn__label">View All Reports</span>
                    <span class="site-btn__arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                </a>
            </div>
        </div>
    </div>
</section>

@if (shareholderLinks.Count > 0)
{
    <section class="shareholderInfo section-spacing" aria-labelledby="shareholder-info-title">
        <div class="container">
            <h2 id="shareholder-info-title" class="text-h2">Shareholder Information</h2>
            <div class="si-row">
                <div class="si-media">
                    <img src="@shareholderImg" alt="@(string.IsNullOrWhiteSpace(Model?.ShareholderImageAlt) ? "Shareholders reviewing company documents together" : Model.ShareholderImageAlt)">
                </div>
                <div class="si-links">
                    <ul class="si-list">
                        @foreach (var item in shareholderLeft)
                        {
                            <li>
                                <a href="@(string.IsNullOrWhiteSpace(item.Url) ? "#" : item.Url)" target="@item.UrlTarget">
                                    <span>@item.Title</span>
                                    @await Html.PartialAsync("_si_arrow")
                                </a>
                            </li>
                        }
                    </ul>
                    @if (shareholderRight.Count > 0)
                    {
                        <ul class="si-list">
                            @foreach (var item in shareholderRight)
                            {
                                <li>
                                    <a href="@(string.IsNullOrWhiteSpace(item.Url) ? "#" : item.Url)" target="@item.UrlTarget">
                                        <span>@item.Title</span>
                                        @await Html.PartialAsync("_si_arrow")
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </section>
}

@if (governanceLinks.Count > 0)
{
    <section class="corporateGovernance section-spacing" aria-labelledby="corporate-governance-title">
        <div class="cg-bg" aria-hidden="true">
            <img src="@governanceBg" alt="">
        </div>
        <div class="container">
            <div class="cg-panel">
                <h2 id="corporate-governance-title" class="text-h2">Corporate Governance</h2>
                <ul class="cg-list">
                    @foreach (var item in governanceLinks)
                    {
                        <li>
                            <a href="@(string.IsNullOrWhiteSpace(item.Url) ? "/investor-relations/corporate-governance" : item.Url)">
                                <span>@item.Title</span>
                                @await Html.PartialAsync("_si_arrow")
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </section>
}

@if (subsidiaryLinks.Count > 0)
{
    <section class="subsidiaries section-spacing" aria-labelledby="subsidiaries-title">
        <div class="container">
            <h2 id="subsidiaries-title" class="text-h2">Subsidiaries</h2>
            <div class="si-row">
                <div class="si-media">
                    <img src="@subsidiariesImg" alt="@(string.IsNullOrWhiteSpace(Model?.SubsidiariesImageAlt) ? "Representatives meeting across Godavari Biorefineries subsidiaries" : Model.SubsidiariesImageAlt)">
                </div>
                <ul class="si-list sub-list">
                    @foreach (var item in subsidiaryLinks)
                    {
                        <li>
                            <a href="@(string.IsNullOrWhiteSpace(item.Url) ? "#" : item.Url)" target="@item.UrlTarget" rel="noopener noreferrer">
                                <span>@item.Title</span>
                                @await Html.PartialAsync("_si_arrow")
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </section>
}

@if (contactList.Count > 0)
{
    <section class="codeOfConduct section-spacing" aria-labelledby="investor-contact-title">
        <div class="container">
            <h2 id="investor-contact-title" class="text-h2">@contactTitle</h2>
            <div class="coc-row">
                @foreach (var item in contactList)
                {
                    <div class="coc-card">
                        @if (!string.IsNullOrWhiteSpace(item.Title))
                        {
                            <h3>@Html.Raw(item.Title.CleanParagraphTags())</h3>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Content))
                        {
                            @Html.Raw(item.Content)
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

@section Scripts {
    <script src="~/Assets/js/investor.js" asp-append-version="true"></script>
}

@functions {
    private static string FirstText(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value)) return value;
        }
        return "";
    }
}
