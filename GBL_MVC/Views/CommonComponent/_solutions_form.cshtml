@model SolutionCenterEnquiryModal

<form asp-controller="Product" asp-action="SubmitSolutionsEnquiry" method="post" id="solutionsEnquiryForm" novalidate
    class="mx-auto mt-10 grid max-w-full grid-cols-1 gap-x-[30px] lg:gap-x-[30px] xl:gap-x-[36px] gap-y-6 md:grid-cols-2 xl:grid-cols-3">
    @Html.AntiForgeryToken()

    <div>
        <input asp-for="FullName" class="f-field" placeholder="Full Name*" maxlength="150"/>
        <span asp-validation-for="FullName" class="text-red-500"></span>
    </div>

    <div>
        <div class="f-field flex items-center gap-2 p-0">
            <span class="pl-1 text-[16px] font-light text-white">+91</span>
            <input asp-for="PhoneNumber" type="tel" maxlength="10" placeholder="Phone Number*"
                class="w-full bg-transparent text-base font-light text-white placeholder:text-white/40 focus:outline-none" />
        </div>
        <span asp-validation-for="PhoneNumber" class="text-red-500"></span>
    </div>

    <div>
        <div class="f-field flex items-center gap-2 p-0">
            <span class="pl-1 text-[16px] font-light text-white">+91</span>
            <input asp-for="WhatsAppNumber" type="tel" maxlength="10" placeholder="WhatsApp Number"
                class="w-full bg-transparent text-base font-light text-white placeholder:text-white/40 focus:outline-none" />
        </div>
        <span asp-validation-for="WhatsAppNumber" class="text-red-500"></span>
    </div>

    <div>
        <input asp-for="EmailAddress" class="f-field" placeholder="Email Address*" maxlength="150"/>
        <span asp-validation-for="EmailAddress" class="text-red-500"></span>
    </div>

    <div class="cselect">
        <select asp-for="Gender" class="f-field">
            <option value="">Gender*</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
            <option value="Prefer not to say">Prefer not to say</option>
        </select>
        <span asp-validation-for="Gender" class="text-red-500"></span>
    </div>

    <div class="cselect">
        <select asp-for="AgeGroup" class="f-field">
            <option value="">Age Group*</option>
            <option value="18-25">18-25</option>
            <option value="26-35">26-35</option>
            <option value="36-45">36-45</option>
            <option value="46-55">46-55</option>
            <option value="56+">56+</option>
        </select>
        <span asp-validation-for="AgeGroup" class="text-red-500"></span>
    </div>

    <div class="cselect">
        <select asp-for="District" class="f-field">
            <option value="">District*</option>
            <option value="Andhra Pradesh-Ongole">Andhra Pradesh - Ongole</option>
            <option value="Andhra Pradesh-Markapuram">Andhra Pradesh - Markapuram</option>
            <option value="Andhra Pradesh-Prakasham">Andhra Pradesh - Prakasham</option>
            <option value="Karnataka-Kalaburgi">Karnataka - Kalaburgi</option>
            <option value="Karnataka-Bidar">Karnataka - Bidar</option>
            <option value="Karnataka-Yadgir">Karnataka - Yadgir</option>
            <option value="Other">Other</option>
        </select>
        <span asp-validation-for="District" class="text-red-500"></span>
    </div>

    <div id="otherDistrictDiv" style="display:none;">
        <input asp-for="OtherDistrict" class="f-field" placeholder="Other District*" maxlength="200"/>
        <span asp-validation-for="OtherDistrict" class="text-red-500"></span>
    </div>

    <div>
        <input asp-for="TownVillage" class="f-field" placeholder="Town / Village" maxlength="200"/>
        <span asp-validation-for="TownVillage" class="text-red-500"></span>
    </div>

    <div class="cselect">
        <select asp-for="CurrentOccupation" class="f-field">
            <option value="">Current Occupation*</option>
            <option value="Business Owner">Business Owner</option>
            <option value="Dealer / Retailer">Dealer / Retailer</option>
            <option value="Civil Contractor">Civil Contractor</option>
            <option value="Professional">Professional</option>
            <option value="Homemaker">Homemaker</option>
            <option value="Student">Student</option>
            <option value="Other">Other</option>
        </select>
        <span asp-validation-for="CurrentOccupation" class="text-red-500"></span>
    </div>

    <div class="solutions-enquiry-others md:col-span-2 xl:col-span-3 is-collapsed" data-occupation-others>
        <input asp-for="CurrentOccupationOthers" class="f-field" placeholder="Please specify occupation" maxlength="200"/>
        <span asp-validation-for="CurrentOccupationOthers" class="text-red-500"></span>
    </div>

    <div class="solutions-enquiry-questions md:col-span-2 xl:col-span-3">
        <div class="solutions-enquiry-qpair">
            <div class="solutions-enquiry-q">
                <p class="solutions-enquiry-radio-label">Do you currently own a shop/commercial
                    space<span class="req">*</span></p>
                <div class="solutions-enquiry-radios" role="radiogroup"
                    aria-label="Do you currently own a shop or commercial space?">
                    <label class="radio-opt">
                        <input asp-for="OwnShopOrCommercialSpace" type="radio" value="Yes" checked />
                        <span class="radio-dot" aria-hidden="true"></span>
                        <span class="text-p font-medium text-white">Yes</span>
                    </label>
                    <label class="radio-opt">
                        <input asp-for="OwnShopOrCommercialSpace" type="radio" value="No" />
                        <span class="radio-dot" aria-hidden="true"></span>
                        <span class="text-p font-medium text-white">No</span>
                    </label>
                </div>
                <span asp-validation-for="OwnShopOrCommercialSpace" class="text-red-500"></span>
            </div>
            <div class="solutions-enquiry-q">
                <p class="solutions-enquiry-radio-label">Have you previously run a business
                </p>
                <div class="solutions-enquiry-radios" role="radiogroup"
                    aria-label="Have you previously run a business?">
                    <label class="radio-opt">
                        <input asp-for="PreviouslyRunBusiness" type="radio" value="Yes" checked />
                        <span class="radio-dot" aria-hidden="true"></span>
                        <span class="text-p font-medium text-white">Yes</span>
                    </label>
                    <label class="radio-opt">
                        <input asp-for="PreviouslyRunBusiness" type="radio" value="No" />
                        <span class="radio-dot" aria-hidden="true"></span>
                        <span class="text-p font-medium text-white">No</span>
                    </label>
                </div>
                <span asp-validation-for="PreviouslyRunBusiness" class="text-red-500"></span>
            </div>
        </div>

        <div class="solutions-enquiry-qpair">
            <div class="solutions-enquiry-q">
                <p class="solutions-enquiry-radio-label">Do you have space for Store setup</p>
                <div class="solutions-enquiry-radios" role="radiogroup" aria-label="Do you have space for store setup?">
                    <label class="radio-opt">
                        <input asp-for="HaveSpaceForStoreSetup" type="radio" value="Yes" checked />
                        <span class="radio-dot" aria-hidden="true"></span>
                        <span class="text-p font-medium text-white">Yes</span>
                    </label>
                    <label class="radio-opt">
                        <input asp-for="HaveSpaceForStoreSetup" type="radio" value="No" />
                        <span class="radio-dot" aria-hidden="true"></span>
                        <span class="text-p font-medium text-white">No</span>
                    </label>
                </div>
                <span asp-validation-for="HaveSpaceForStoreSetup" class="text-red-500"></span>
            </div>
            <div class="solutions-enquiry-q solutions-enquiry-sqft" data-sqft-field>
                <p class="solutions-enquiry-radio-label">If Yes, what is the size in sq.ft.
                </p>
                <input asp-for="StoreSizeSqFt" placeholder="Sq. Ft." class="f-field" />
                <span asp-validation-for="StoreSizeSqFt" class="text-red-500"></span>
            </div>
        </div>
    </div>

    <div class="solutions-enquiry-preferred md:col-span-2 xl:col-span-3">
        <div class="cselect">
            <select asp-for="PreferredTimeForContact" class="f-field">
                <option value="">Preferred Time for Contact</option>
                <option value="Morning (9 AM - 12 PM)">Morning (9 AM - 12 PM)</option>
                <option value="Afternoon (12 PM - 4 PM)">Afternoon (12 PM - 4 PM)</option>
                <option value="Evening (4 PM - 7 PM)">Evening (4 PM - 7 PM)</option>
                <option value="Anytime">Anytime</option>
            </select>
            <span asp-validation-for="PreferredTimeForContact" class="text-red-500"></span>
        </div>
    </div>

    <div class="mt-6 flex flex-col sm:flex-col sm:items-start sm:justify-between gap-4 md:col-span-2">
        <label class="form-check">
            <input asp-for="Consent" type="checkbox" class="form-check-input" />
            <span class="form-check-box" aria-hidden="true"></span>
            <span class="form-check-label">I agree to be contacted regarding this enquiry.</span>

        </label>
        <span asp-validation-for="Consent" class="text-red-500"></span>
    </div>

    <div class="mt-6 flex flex-col sm:flex-col sm:items-center sm:justify-between gap-4 md:col-span-2 lg:max-w-2xl">
        <label class="label-check-txt">
            <p>
                Disclaimer: I authorize Rain Cements Limited (Priya Cement) and its representatives to Call, SMS,
                Email or WhatsApp me about its updates and notifications. This consent overrides any registration for Do
                Not
                Disturb (DND) /
                National Do Not Call (NDNC).
            </p>
        </label>
    </div>

    <div class="mt-6 flex flex-col sm:flex-col sm:items-start sm:justify-between gap-4 md:col-span-2">
        <div class="input-field col s12 p-0 mr-3.75 flex flex-col sm:flex-row items-start sm:items-center gap-2">
            <div class="g-recaptcha" data-sitekey="@ViewBag.captchapublickey"></div>
            <div class="text-white font-light italic dark-textwhite text-sm">
                (Cannot view the captcha? Please make sure Google <br />
                and its services are enabled on your system.)
            </div>
        </div>
        <span id="captchaError" class="text-red-500 field-validation-valid">
    </div>

    <div class="md:col-span-2 xl:col-span-3 mt-3 flex justify-center form-Submitbtn-wrap">
        <button type="submit"
            class="inline-flex items-center gap-2.5 rounded-[10px] bg-white px-[14px] py-[10px] text-base font-medium text-[#231f20] shadow-[0px_4px_5px_rgba(0,0,0,0.1),0px_17px_8.5px_rgba(0,0,0,0.09)] transition-transform hover:-translate-y-0.5">
            Request a Call Back
            <svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true">
                <path d="M0 5h14M10 1l4 4-4 4" stroke="#231f20" stroke-width="1.4" stroke-linecap="round"
                    stroke-linejoin="round" />
            </svg>
        </button>
    </div>

    <div id="solutionsEnquiryMessage" class="md:col-span-2 xl:col-span-3 text-center mt-2"></div>
</form>
