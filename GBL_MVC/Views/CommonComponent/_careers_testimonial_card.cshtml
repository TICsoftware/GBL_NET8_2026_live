@using GBL_BusinessLogic.Entity
@using GBL_MVC.Helpers
@model ComponentModel

@{
    var quote = !string.IsNullOrWhiteSpace(Model?.Intro) ? Model.Intro : Model?.Content;
    var name = !string.IsNullOrWhiteSpace(Model?.DisplayTitle) ? Model.DisplayTitle : Model?.Title;
    var designation = !string.IsNullOrWhiteSpace(Model?.Designation)
        ? Model.Designation
        : Model?.Component_Designation;
    var avatar = !string.IsNullOrWhiteSpace(Model?.ComponentThumbnail)
        ? Model.ComponentThumbnail
        : Model?.ThumbnailImage;
    var link = Model?.Url;
    var linkText = !string.IsNullOrWhiteSpace(Model?.Url_Text) ? Model.Url_Text : "Read The Story";
}

<div class="quote-card rounded-sm shrink-0">
    <div class="quote-mark">
        <img src="/Assets/images/common-images/quote-icon.svg" alt="" class="w-auto object-cover">
    </div>
    @if (!string.IsNullOrWhiteSpace(quote))
    {
        <p class="quote-card-para">@Html.Raw(quote.CleanParagraphTags())</p>
    }
    <div class="flex items-center gap-3 quote-card-content">
        @if (!string.IsNullOrWhiteSpace(avatar))
        {
            <img src="@avatar" alt="" class="w-15 h-15 rounded-full object-cover" />
        }
        <div>
            @if (!string.IsNullOrWhiteSpace(name))
            {
                <p class="quote-card-member">@Html.Raw(name.CleanParagraphTags())</p>
            }
            @if (!string.IsNullOrWhiteSpace(designation))
            {
                <p class="quote-card-desn">@Html.Raw(designation.CleanParagraphTags())</p>
            }
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(link))
    {
        <div class="outer-btn-wrap">
            <a class="site-link" href="@link">
                @linkText
                <span class="site-link-arrow" aria-hidden="true">
                    <img src="/Assets/images/common-images/button-arrow-icon.svg" alt="" class="w-auto object-cover">
                </span>
            </a>
        </div>
    }
</div>
