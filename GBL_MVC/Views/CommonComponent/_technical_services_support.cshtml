@using GBL_BusinessLogic.Entity
@using GBL_MVC.Helpers
@model GBL_BusinessLogic.Entity.ProductModel

@{
    var main = Model?.Support_Intro_List?
        .Where(x => x.IsBlock == 0)
        .OrderBy(x => x.Sequence)
        .FirstOrDefault()
        ?? Model?.Support_Intro_List?.OrderBy(x => x.Sequence).FirstOrDefault();

    var items = Model?.Support_Items_List?
        .Where(x => x.IsBlock == 1)
        .OrderBy(x => x.Sequence)
        .ToList()
        ?? Model?.Support_Items_List?.OrderBy(x => x.Sequence).ToList()
        ?? new List<ComponentModel>();

    // If support items only have IsBlock 0 entries, treat them as cards
    if (!items.Any() && Model?.Support_Items_List != null)
    {
        items = Model.Support_Items_List.Where(x => x.IsBlock == 1).OrderBy(x => x.Sequence).ToList();
        if (!items.Any())
        {
            items = Model.Support_Items_List.OrderBy(x => x.Sequence).ToList();
        }
    }

    var stickyHeader = Model?.Support_Items_List?
        .Where(x => x.IsBlock == 0)
        .OrderBy(x => x.Sequence)
        .FirstOrDefault();

    var media = !string.IsNullOrWhiteSpace(main?.Component_right_image)
        ? main.Component_right_image
        : (!string.IsNullOrWhiteSpace(main?.ComponentThumbnail) ? main.ComponentThumbnail : main?.ThumbnailImage);
    var mediaAlt = !string.IsNullOrWhiteSpace(main?.Component_Right_image_alt)
        ? main.Component_Right_image_alt
        : main?.ComponentThumbnailAltText;
    var eyebrow = !string.IsNullOrWhiteSpace(main?.Designation) ? main.Designation : main?.Component_Designation;
    var title = !string.IsNullOrWhiteSpace(main?.DisplayTitle) ? main.DisplayTitle : main?.Title;
    var body = !string.IsNullOrWhiteSpace(main?.Intro) ? main.Intro : main?.Content;
    var stickyTitle = !string.IsNullOrWhiteSpace(stickyHeader?.DisplayTitle)
        ? stickyHeader.DisplayTitle
        : (!string.IsNullOrWhiteSpace(stickyHeader?.Section_title) ? stickyHeader.Section_title : stickyHeader?.Title);

    var cardItems = items.Where(x => x.IsBlock == 1 || stickyHeader == null || x.GroupId != stickyHeader.GroupId).ToList();
    if (stickyHeader != null)
    {
        cardItems = items.Where(x => x.IsBlock == 1).OrderBy(x => x.Sequence).ToList();
        if (!cardItems.Any())
        {
            cardItems = items.Where(x => x.GroupId != stickyHeader.GroupId).OrderBy(x => x.Sequence).ToList();
        }
    }
}

@if (main != null || cardItems.Any())
{
    <section id="support" class="scroll-mt-28 lg:scroll-mt-40 section-pb">
        @if (main != null)
        {
            <div class="container">
                <div class="flex flex-col lg:flex-row lg:items-start gap-6 lg:gap-10">
                    @if (!string.IsNullOrWhiteSpace(media))
                    {
                        <div class="rounded-md parallax-wrap lg:max-w-[62%] w-full">
                            <img src="@media" alt="@mediaAlt" class="rounded-md object-cover shadow-card parallax-img" />
                        </div>
                    }
                    <div class="lg:max-w-[38%]" data-fade>
                        <div class="section-title-outer section-title-outer-start section-with-intro section-title-nonintro">
                            @if (!string.IsNullOrWhiteSpace(eyebrow))
                            {
                                <span class="eyebrow-text">@Html.Raw(eyebrow.CleanParagraphTags())</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(title))
                            {
                                <h2 class="text-h2 title-section reveal-text">
                                    @Html.Raw(title.CleanParagraphTags())
                                </h2>
                            }
                            @if (!string.IsNullOrWhiteSpace(body))
                            {
                                <p>@Html.Raw(body.CleanParagraphTags())</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (cardItems.Any() || !string.IsNullOrWhiteSpace(stickyTitle))
        {
            <div data-rail-scope class="mt-8 bg-surface py-8 sm:mt-10 sm:py-10 lg:mt-8 lg:py-16 xl:mt-16 xl:py-20">
                <div class="container">
                    @if (!string.IsNullOrWhiteSpace(stickyTitle))
                    {
                        <div class="section-sticky-head lg:max-w-2xl">
                            <h3 class="section-sticky-title text-h2 reveal-text">@Html.Raw(stickyTitle.CleanParagraphTags())</h3>
                        </div>
                    }

                    <div class="mt-10 flex gap-3 sm:mt-12 sm:gap-5 lg:mt-14 lg:gap-8">
                        <div data-rail class="relative w-[8px] shrink-0 self-stretch">
                            <span class="absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-border"></span>
                            <span data-rail-thumb class="absolute left-0 top-0 h-10 w-2 rounded-full bg-secondary"></span>
                        </div>
                        <div class="min-w-0 flex-1 space-y-12 sm:space-y-14 lg:space-y-16 technicalsupport-outer-grid">
                            @{ var index = 1; }
                            @foreach (var item in cardItems)
                            {
                                var itemTitle = !string.IsNullOrWhiteSpace(item.DisplayTitle) ? item.DisplayTitle : item.Title;
                                var itemBody = !string.IsNullOrWhiteSpace(item.Content) ? item.Content : item.Intro;
                                var itemImg = !string.IsNullOrWhiteSpace(item.ComponentThumbnail)
                                    ? item.ComponentThumbnail
                                    : (!string.IsNullOrWhiteSpace(item.ThumbnailImage) ? item.ThumbnailImage : item.Component_right_image);
                                <article class="relative grid gap-6 lg:block lg:pl-16">
                                    @if (!string.IsNullOrWhiteSpace(itemImg))
                                    {
                                        <img data-fade src="@itemImg" alt="" class="w-full rounded-md object-cover aspect-[4/3] sm:aspect-[16/10] lg:ml-auto lg:w-[74%] lg:aspect-[3/2]" />
                                    }
                                    <div class="inner-content-box">
                                        <span data-count aria-hidden="true" class="pointer-events-none relative z-0 mb-2 block select-none leading-none text-ghost lg:absolute lg:left-0 lg:top-[8vw] lg:mb-0 text-big">@index.ToString("00")</span>
                                        <div class="relative z-10 rounded-md bg-white p-6 shadow-[0_8px_30px_rgba(0,0,0,0.08)] sm:p-8 lg:absolute lg:left-0 lg:top-1/2 lg:w-[388px] lg:-translate-y-1/2 lg:p-[21px] lg:pt-12">
                                            <h4 class="text-h4">@Html.Raw(itemTitle.CleanParagraphTags())</h4>
                                            <span class="my-3 block h-px w-full bg-[#EDEDED]"></span>
                                            @if (!string.IsNullOrWhiteSpace(itemBody))
                                            {
                                                <p>@Html.Raw(itemBody.CleanParagraphTags())</p>
                                            }
                                        </div>
                                    </div>
                                </article>
                                index++;
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </section>
}
