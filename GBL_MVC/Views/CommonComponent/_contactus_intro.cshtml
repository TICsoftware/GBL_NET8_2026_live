@using GBL_BusinessLogic.Entity
@using GBL_MVC.Helpers
@model List<ComponentModel>

@{
    var intro = Model?
        .Where(x => x.IsBlock == 0)
        .OrderBy(x => x.Sequence)
        .FirstOrDefault()
        ?? Model?.OrderBy(x => x.Sequence).FirstOrDefault();

    var locations = Model?.Where(x => x.IsBlock == 1).OrderBy(x => x.Sequence).ToList() ?? new List<ComponentModel>();
    if (!locations.Any() && Model != null && intro != null)
    {
        locations = Model.Where(x => x.GroupId != intro.GroupId).OrderBy(x => x.Sequence).ToList();
    }

    var title = !string.IsNullOrWhiteSpace(intro?.DisplayTitle) ? intro.DisplayTitle : intro?.Title;
    var introCopy = intro?.Intro;
    var mapHtml = intro?.Content;
    var circleImg = !string.IsNullOrWhiteSpace(intro?.ComponentThumbnail)
        ? intro.ComponentThumbnail
        : (!string.IsNullOrWhiteSpace(intro?.Component_right_image)
            ? intro.Component_right_image
            : (!string.IsNullOrWhiteSpace(intro?.ThumbnailImage)
                ? intro.ThumbnailImage
                : "/Assets/images/contactus/circle-img.webp"));

    List<(string Text, string Href)> BuildPhones(ComponentModel loc)
    {
        var phones = new List<(string Text, string Href)>();
        void Add(string? text, string? href)
        {
            text = text?.CleanParagraphTags();
            href = href?.Trim();
            if (string.IsNullOrWhiteSpace(text) && string.IsNullOrWhiteSpace(href)) { return; }
            var display = !string.IsNullOrWhiteSpace(text) ? text : href;
            var tel = href;
            if (string.IsNullOrWhiteSpace(tel) || (!tel.StartsWith("tel:", StringComparison.OrdinalIgnoreCase) && !tel.StartsWith("+") && !char.IsDigit(tel[0])))
            {
                tel = display;
            }
            if (!string.IsNullOrWhiteSpace(tel) && !tel.StartsWith("tel:", StringComparison.OrdinalIgnoreCase))
            {
                tel = "tel:" + tel.Replace(" ", string.Empty);
            }
            phones.Add((display ?? string.Empty, tel ?? "#"));
        }

        Add(loc.Url_Text, loc.Url);
        Add(!string.IsNullOrWhiteSpace(loc.component_Url_Text2) ? loc.component_Url_Text2 : loc.Component_Button_Title1, loc.component_Url2);
        Add(loc.Component_Button_Title2, loc.Component_Designation2);
        return phones;
    }
}

@if (intro != null || locations.Any())
{
    <section class="section-spacing map-section">
        <div class="container">
            <div class="outer-map-section relative">
                @if (intro != null)
                {
                    <div class="section-title-outer section-title-outer-start section-title-md relative section-title-left map-title-section">
                        @if (!string.IsNullOrWhiteSpace(title))
                        {
                            <h2 class="text-h2 title-section reveal-text">
                                @Html.Raw(title.CleanParagraphTags())
                            </h2>
                        }
                        @if (!string.IsNullOrWhiteSpace(introCopy))
                        {
                            @Html.Raw(introCopy)
                        }
                    </div>
                }

                <div class="relative map-outer-warapper">
                    @if (!string.IsNullOrWhiteSpace(circleImg))
                    {
                        <div class="circle-img">
                            <img src="@circleImg" alt="" class="w-auto object-cover">
                        </div>
                    }

                    <div class="map-inside-wrapper relative max-w-4xl">
                        @if (!string.IsNullOrWhiteSpace(mapHtml))
                        {
                            @Html.Raw(mapHtml.CleanParagraphTags())
                        }

                        @foreach (var loc in locations)
                        {
                            var locationKey = loc.HmpgIntro.CleanParagraphTags();
                            if (string.IsNullOrWhiteSpace(locationKey)) { continue; }

                            var cardId = "map-info-card-" + locationKey.ToLowerInvariant().Replace(" ", string.Empty);
                            var cardTitle = !string.IsNullOrWhiteSpace(loc.DisplayTitle) ? loc.DisplayTitle : loc.Title;
                            var company = !string.IsNullOrWhiteSpace(loc.Title) && loc.Title != cardTitle
                                ? loc.Title
                                : (!string.IsNullOrWhiteSpace(loc.HmpgIntro) ? loc.HmpgIntro : loc.Section_title);
                            var address = !string.IsNullOrWhiteSpace(loc.Intro) ? loc.Intro : "";
                            var contact = !string.IsNullOrWhiteSpace(loc.Content) ? loc.Content : "";
                      
                            var phones = BuildPhones(loc);

                            <div class="map-info-card" id="@cardId" data-location="@Html.Raw(locationKey)" aria-hidden="true">
                                <div class="map-info-flag">
                                    <svg class="map-info-pin-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                                        <path d="M7 0C3.96 0 1.5 2.46 1.5 5.5c0 4.13 5 8.5 5.5 8.5s5.5-4.37 5.5-8.5C12.5 2.46 10.04 0 7 0Zm0 7.5A2 2 0 1 1 7 3.5a2 2 0 0 1 0 4Z" fill="#fff"/>
                                    </svg>
                                    @if (!string.IsNullOrWhiteSpace(cardTitle))
                                    {
                                        <span class="map-info-title">@Html.Raw(cardTitle.CleanParagraphTags())</span>
                                    }
                                </div>
                                <div class="map-info-body">
                                    @if (!string.IsNullOrWhiteSpace(company))
                                    {
                                        <p class="map-info-company">@Html.Raw(company.CleanParagraphTags())</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(address))
                                    {
                                        <p class="map-info-address">@Html.Raw(address.CleanParagraphTags())</p>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(contact))
                                    {
                                        @Html.Raw(contact)
                                    }
                               
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
}
