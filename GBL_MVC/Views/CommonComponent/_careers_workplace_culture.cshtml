@using GBL_BusinessLogic.Entity
@using GBL_MVC.Helpers
@model List<ComponentModel>

@{
    var intro = Model?.FirstOrDefault(x => x.IsBlock == 0) ?? Model?.FirstOrDefault();
    var photos = Model?.Where(x => x.IsBlock == 1).OrderBy(x => x.Sequence).ToList() ?? new List<ComponentModel>();
    if (!photos.Any() && Model != null && intro != null)
    {
        photos = Model.Where(x => x.GroupId != intro.GroupId).OrderBy(x => x.Sequence).ToList();
    }

    var title = !string.IsNullOrWhiteSpace(intro?.DisplayTitle) ? intro.DisplayTitle : intro?.Title;
    var body = !string.IsNullOrWhiteSpace(intro?.Intro) ? intro.Intro : intro?.Content;
}

@if (intro != null || photos.Any())
{
    <section class="relative section-spacing workplaceculture-section">
        <div class="container">
            <div class="culture-layout">
                @if (intro != null)
                {
                    <div class="culture-intro">
                        <div class="section-title-outer section-title-outer-start section-title-md no-p-width">
                            @if (!string.IsNullOrWhiteSpace(title))
                            {
                                <h2 class="text-h2 title-section reveal-text">
                                    @Html.Raw(title.CleanParagraphTags())
                                </h2>
                            }
                            @if (!string.IsNullOrWhiteSpace(body))
                            {
                                <p>@Html.Raw(body.CleanParagraphTags())</p>
                            }
                        </div>
                    </div>
                }

                @if (photos.Any())
                {
                    <div class="culture-slider">
                        <div class="culture-photos" data-culture-photos>
                            @{ var i = 1; }
                            @foreach (var photo in photos)
                            {
                                var img = !string.IsNullOrWhiteSpace(photo.ComponentThumbnail)
                                    ? photo.ComponentThumbnail
                                    : (!string.IsNullOrWhiteSpace(photo.ThumbnailImage) ? photo.ThumbnailImage : photo.Component_right_image);
                                var alt = !string.IsNullOrWhiteSpace(photo.ComponentThumbnailAltText)
                                    ? photo.ComponentThumbnailAltText
                                    : photo.ThumbnailAltText;
                                if (string.IsNullOrWhiteSpace(img)) { continue; }
                                <div class="culture-photo culture-photo--@i rounded-md overflow-hidden">
                                    <div class="parallax-wrap culture-parallax-wrap" aria-hidden="true">
                                        <img src="@img" alt="@alt" class="grid-photo parallax-img">
                                    </div>
                                </div>
                                i++;
                            }
                        </div>

                        <div class="culture-slider-nav" data-culture-nav aria-label="Workplace culture photos">
                            <button type="button" class="culture-slider-arrow culture-slider-prev" data-culture-prev aria-label="Previous photo">
                                <img src="/Assets/images/common-images/button-arrow-icon.svg" alt="" aria-hidden="true">
                            </button>
                            <div class="culture-slider-dots" data-culture-dots role="tablist" aria-label="Photo pagination"></div>
                            <button type="button" class="culture-slider-arrow culture-slider-next" data-culture-next aria-label="Next photo">
                                <img src="/Assets/images/common-images/button-arrow-icon.svg" alt="" aria-hidden="true">
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
