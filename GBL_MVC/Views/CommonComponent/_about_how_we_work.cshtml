@using Microsoft.AspNetCore.Razor.Language
@using GBL_BusinessLogic.Entity
@using GBL_MVC.Helpers
@model List<ComponentModel>

@{
    var component = Model?.FirstOrDefault(x => x.IsBlock == 0) ?? Model?.FirstOrDefault();

}

<section id="aboutus-values" class="aboutus-values-section" aria-label="Values that define how we work"
    data-frames-base="@Url.Content("~/Assets/images/aboutus/images/")">
    <div class="aboutus-values-sticky">
        <div class="section-title-outer section-title-outer-start aboutus-values-title" id="aboutus-values-title">
            <h2 class="text-h2 title-section reveal-text">
                @Html.Raw(!string.IsNullOrWhiteSpace(component.DisplayTitle)
                                ? component.DisplayTitle.CleanParagraphTags()
                                : component.Title)
            </h2>
        </div>

        <div class="aboutus-values-stage" id="aboutus-values-stage">
            <canvas id="aboutus-values-flower" class="aboutus-values-canvas" role="img"
                aria-label="Red values flower revealing clockwise"></canvas>

            <div id="aboutus-values-logo" class="aboutus-values-node aboutus-values-logo" role="img"
                aria-label="Priya Cement emblem">
                <img src="@component.ComponentThumbnail" alt="@component.ComponentThumbnailAltText"
                    class="aboutus-values-logo-img" draggable="false">
            </div>
            @foreach (var item in Model.Where(x => x.IsBlock == 1).OrderBy(x => x.Sequence))
            {
                var key = item.Title.ToLower().Replace(" ", "").Replace("-", "");
                <img class="aboutus-values-node aboutus-values-icon" data-key="@key" src="@item.Icon_Image"
                    alt="@item.Title">
            }

        </div>

        <div class="aboutus-values-labels" id="aboutus-values-labels">
            @foreach (var item in Model.Where(x => x.IsBlock == 1).OrderBy(x => x.Sequence))
            {
                var key = item.Title.ToLower().Replace(" ", "").Replace("-", "");

                <div class="aboutus-values-label" data-key="@key" data-side="@item.bg_class">
                    <h2>@item.Title</h2>
                    @if (!string.IsNullOrWhiteSpace(item.Intro))
                    {
                        <p>@Html.Raw(item.Intro.CleanParagraphTags())</p>
                    }
                </div>
            }

        </div>
    </div>
</section>