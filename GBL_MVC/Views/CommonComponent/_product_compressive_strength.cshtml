@using GBL_BusinessLogic.Entity
@using GBL_MVC.Helpers
@model List<ComponentModel>

@{
    var header = Model?
        .Where(x => x.IsBlock == 0)
        .OrderBy(x => x.Sequence)
        .FirstOrDefault();

    var rows = Model?
        .Where(x => x.IsBlock == 1)
        .OrderBy(x => x.Sequence)
        .ToList() ?? new List<ComponentModel>();

    var sectionTitle = !string.IsNullOrWhiteSpace(header?.DisplayTitle)
        ? header.DisplayTitle
        : (!string.IsNullOrWhiteSpace(header?.Section_title) ? header.Section_title : header?.Title);

    var htmlTable = header?.Content;
}

@if (header != null || rows.Any())
{
    <section class="section-spacing compressivestrength-section relative overflow-hidden">
        <div class="bgimage-outer-wrap" aria-hidden="true">
            <img src="/Assets/images/bg-image.webp" alt="" class="w-full h-full object-cover bg-image">
        </div>
        <div class="container">
            @if (!string.IsNullOrWhiteSpace(sectionTitle))
            {
                <h3 class="text-h4">@Html.Raw(sectionTitle.CleanParagraphTags())</h3>
            }

            <div class="table-scroll mt-6" data-table-scroll>
                <div class="table-scroll-x">
                    @if (!string.IsNullOrWhiteSpace(htmlTable) && htmlTable.Contains("<table", StringComparison.OrdinalIgnoreCase))
                    {
                        @Html.Raw(htmlTable)
                    }
                    else if (rows.Any())
                    {
                        <table class="spec-table spacing-table-td">
                            <thead>
                                <tr class="bg-brand-row">
                                    <th class="w-[30%]">Curing period</th>
                                    <th class="w-[34%]">IS 269:2015 minimum</th>
                                    <th class="w-[36%]">Priya Cement test result</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in rows)
                                {
                                    var rowClass = !string.IsNullOrWhiteSpace(row.bg_class) ? row.bg_class : "";
                                    <tr class="@rowClass">
                                        <td>@Html.Raw((!string.IsNullOrWhiteSpace(row.Title) ? row.Title : row.DisplayTitle).CleanParagraphTags())</td>
                                        <td>@Html.Raw(row.Intro.CleanParagraphTags())</td>
                                        <td>@Html.Raw(row.Content.CleanParagraphTags())</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    <div class="lion-red-wrap">
                        <img src="/Assets/images/common-images/lion-red.svg" alt="" class="w-auto h-auto object-cover">
                    </div>
                </div>
            </div>
        </div>
    </section>
}
