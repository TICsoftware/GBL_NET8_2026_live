@using GBL_BusinessLogic.Entity
@using GBL_MVC.Helpers
@model List<ComponentModel>

@{
    var cta = Model?.FirstOrDefault(x => x.IsBlock == 0) ?? Model?.FirstOrDefault();
    var title = !string.IsNullOrWhiteSpace(cta?.DisplayTitle) ? cta.DisplayTitle : cta?.Title;
    var bgImg = !string.IsNullOrWhiteSpace(cta?.Componentbackground)
        ? cta.Componentbackground
        : (!string.IsNullOrWhiteSpace(cta?.ThumbnailImage) ? cta.ThumbnailImage : "/Assets/images/careers/image1.webp");
        
    var peopleImg = string.IsNullOrWhiteSpace(cta?.ComponentThumbnail)
     ? "/Assets/images/careers/image2.webp"
     : cta.ComponentThumbnail;

    var btn1Text = !string.IsNullOrWhiteSpace(cta?.Component_Button_Title1)
        ? cta.Component_Button_Title1
        : (!string.IsNullOrWhiteSpace(cta?.Url_Text) ? cta.Url_Text : "See open roles");
    var btn1Url = !string.IsNullOrWhiteSpace(cta?.Url) ? cta.Url : "#";

    var btn2Text = !string.IsNullOrWhiteSpace(cta?.Component_Button_Title2)
        ? cta.Component_Button_Title2
        : (!string.IsNullOrWhiteSpace(cta?.component_Url_Text2) ? cta.component_Url_Text2 : "Connect with us");
    var btn2Url = !string.IsNullOrWhiteSpace(cta?.component_Url2) ? cta.component_Url2 : "#";
}

@if (cta != null)
{
    <section class="relative section-spacing bg-parallax-section">
        <div class="outer-bg-wrap">
            <div class="container relative z-1 bg-parallax-stage">
                <div class="bg-parallax-frame relative rounded-sm overflow-hidden">
                    <div class="parallax-wrap rounded-sm" aria-hidden="true">
                        <img src="@bgImg" alt="" class="parallax-img rounded-sm" loading="eager" decoding="async">
                    </div>
                    <div class="overlay-scrim rounded-sm" aria-hidden="true"></div>

                    <div class="bg-parallax-content relative z-2">
                        <div class="section-title-outer section-title-outer-start section-title-sm white-copy">
                            @if (!string.IsNullOrWhiteSpace(title))
                            {
                                <h3 class="text-h2 title-section reveal-text">
                                    @Html.Raw(title.CleanParagraphTags())
                                </h3>
                            }
                        </div>
                    </div>

                    <div class="bg-parallax-cta-row absolute left-0 bottom-0 z-3">
                        <div class="outer-btn-wrap outer-bg-white outer-btn-spacing">
                            <a class="site-link" href="@btn1Url" target="_blank">
                                @Html.Raw(btn1Text.CleanParagraphTags())
                                <span class="site-link-arrow" aria-hidden="true">
                                    <img src="/Assets/images/common-images/button-arrow-icon.svg" alt=""
                                         class="w-auto object-cover">
                                </span>
                            </a>
                        </div>
                        <div class="outer-btn-wrap outer-bg-white outer-btn-spacing">
                            <a class="site-link" href="@btn2Url" target="_blank">
                                @Html.Raw(btn2Text.CleanParagraphTags())
                                <span class="site-link-arrow" aria-hidden="true">
                                    <img src="/Assets/images/common-images/button-arrow-icon.svg" alt=""
                                         class="w-auto object-cover">
                                </span>
                            </a>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(peopleImg))
                {
                    <div class="man-image-wrap" aria-hidden="true">
                        <img src="@peopleImg" alt="" class="man-image-img" loading="eager" decoding="async">
                    </div>
                }
            </div>
        </div>
    </section>
}
