
@using GBL_BusinessLogic.Entity
@using GBL_MVC.Helpers
@model List<ComponentModel>

@{
    var greenpro = Model?
        .Where(x => x.IsBlock == 0)
        .OrderBy(x => x.Sequence)
        .FirstOrDefault();

   
}
<section class="section-spacing greenpro-section">
      <div class="container">
         <h3 class="text-h4">  @Html.Raw((!string.IsNullOrWhiteSpace(greenpro.Section_title) ? greenpro.Section_title :"" ).CleanParagraphTags())</h3>
         <div class="mt-4 border-t border-[#EAEAEA] pt-6 product-content-max">
             <h4 class="text-p font-semibold mb-1">
                  @Html.Raw((!string.IsNullOrWhiteSpace(greenpro.DisplayTitle) ? greenpro.DisplayTitle : greenpro.Title).CleanParagraphTags())
               </h4>
                     @if (!string.IsNullOrWhiteSpace(greenpro.Intro) )
                        {
                            @Html.Raw((!string.IsNullOrWhiteSpace(greenpro.Intro) ? greenpro.Intro : ""))
                        }

                       @if (!string.IsNullOrWhiteSpace(greenpro.Content) )
                        {
                            @Html.Raw((!string.IsNullOrWhiteSpace(greenpro.Content) ? greenpro.Content : ""))
                        }

         </div>
      </div>
   </section>