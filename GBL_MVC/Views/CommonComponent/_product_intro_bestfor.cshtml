@using GBL_BusinessLogic.Entity
@using GBL_MVC.Helpers
@model List<ComponentModel>

@{
    var intro = Model?
        .Where(x => x.IsBlock == 0)
        .OrderBy(x => x.Sequence)
        .FirstOrDefault();

    var bestFor = Model?
        .Where(x => x.IsBlock == 1)
        .OrderBy(x => x.Sequence)
        .ToList() ?? new List<ComponentModel>();
}

@if (intro != null)
{
    <section class="relative overflow-hidden section-spacing page-intro-outer">
        <div class="container">
            <div class="intro-outer-wrapper flex-col flex gap-6 lg:gap-12 items-start product-content-max">
                <div class="intro-title-col lg:max-w-5xl">
                    <div class="section-title-outer section-title-outer-start section-with-intro">
                        <h2 class="text-h2 title-section reveal-text">
                            @Html.Raw((!string.IsNullOrWhiteSpace(intro.DisplayTitle) ? intro.DisplayTitle : intro.Title).CleanParagraphTags())
                        </h2>
                      
                    </div>
                     @if (!string.IsNullOrWhiteSpace(intro.Intro) )
                        {
                            <p>@Html.Raw((!string.IsNullOrWhiteSpace(intro.Intro) ? intro.Intro : "").CleanParagraphTags())</p>
                        }
                </div>
            </div>

            @if (bestFor.Any())
            {
                <h3 class="mt-14 text-h4">@(!string.IsNullOrWhiteSpace(intro.Section_title) ? intro.Section_title.CleanParagraphTags() : "Best for")</h3>
                <div class="mt-4 border-t border-[#EAEAEA] pt-5 sm:pt-10 lg:max-w-6xl product-content-max">
                    <div class="grid gap-y-4 gap-x-4 sm:gap-x-16 sm:gap-y-10 grid-cols-2 sm:grid-cols-2 bestfor-grid-outer">
                        @foreach (var item in bestFor)
                        {
                            var icon = !string.IsNullOrWhiteSpace(item.Component_Icon_Image)
                                ? item.Component_Icon_Image
                                : (!string.IsNullOrWhiteSpace(item.Icon_Image) ? item.Icon_Image : item.ThumbnailImage);
                            var label = !string.IsNullOrWhiteSpace(item.DisplayTitle) ? item.DisplayTitle : item.Title;
                            <div class="flex items-center flex-col sm:flex-row gap-2 sm:gap-6 bestfor-grid">
                                @if (!string.IsNullOrWhiteSpace(icon))
                                {
                                    <img src="@icon" alt="" class="h-auto w-auto object-cover shrink-0">
                                }
                                <p class="text-20 font-medium">@Html.Raw(label.CleanParagraphTags())</p>
                            </div>
                        }
                    </div>
                </div>
            }
               @if (!string.IsNullOrWhiteSpace(intro.Content))
                        {
            <div class="product-content-max mt-5">
           
                           @Html.Raw((!string.IsNullOrWhiteSpace(intro.Content) ? intro.Content : ""))
                      
                        </div>

                          }
        </div>
    </section>
}
