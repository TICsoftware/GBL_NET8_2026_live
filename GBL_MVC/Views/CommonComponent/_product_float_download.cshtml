@using GBL_BusinessLogic.Entity
@using GBL_MVC.Helpers
@model List<ComponentModel>

@{
    var floatItem = Model?
        .Where(x => x.IsBlock == 0)
        .OrderBy(x => x.Sequence)
        .FirstOrDefault();

    var bagImg = !string.IsNullOrWhiteSpace(floatItem?.ComponentThumbnail)
        ? floatItem.ComponentThumbnail
        : (!string.IsNullOrWhiteSpace(floatItem?.Component_right_image) ? floatItem.Component_right_image : floatItem?.ThumbnailImage);
    var bagAlt = !string.IsNullOrWhiteSpace(floatItem?.ComponentThumbnailAltText)
        ? floatItem.ComponentThumbnailAltText
        : "";
    var ctaUrl = !string.IsNullOrWhiteSpace(floatItem?.Url) ? floatItem.Url : "#";
    var ctaText = !string.IsNullOrWhiteSpace(floatItem?.Url_Text) ? floatItem.Url_Text : "Get in touch";

    var file1 = floatItem?.Component_FileUpload1;
    var file2 = floatItem?.Component_FileUpload2;
    var title1 = !string.IsNullOrWhiteSpace(floatItem?.FileUploadTitle1)
        ? floatItem.FileUploadTitle1.CleanParagraphTags()
        : "Product Brochure";
    var title2 = !string.IsNullOrWhiteSpace(floatItem?.FileUploadTitle2)
        ? floatItem.FileUploadTitle2.CleanParagraphTags()
        : "Technical Data Sheet";
    var hasDownloads = !string.IsNullOrWhiteSpace(file1) || !string.IsNullOrWhiteSpace(file2);

    // Bulk cement truck needs its own float styles (wider frame / card)
    var path = (Context.Request.Path.Value ?? "").TrimEnd('/').ToLowerInvariant();
    var isBulkFloat = path.EndsWith("/maxload-bulk-cement") || path.EndsWith("maxload-bulk-cement");
    var floatStickyClass = isBulkFloat
        ? "product-float-outer product-float-sticky product-float-sticky--bulk"
        : "product-float-outer product-float-sticky";
}

@if (floatItem != null && !string.IsNullOrWhiteSpace(bagImg))
{
    <div class="product-float-rail">
        <div class="@floatStickyClass">
            <div class="product-float-inner" aria-hidden="true">
                <img src="@bagImg" alt="@bagAlt" class="product-float-bag">
                @if (!isBulkFloat)
                {
                    <img src="/Assets/images/products/shadow-ellipse.webp" alt="" class="product-shadow-ellipse">
                }
            </div>
            <div class="product-site-link">
                <a href="@ctaUrl" class="fill-site-link">
                    <span>@ctaText</span>
                    <span class="fill-site-link-arrow" aria-hidden="true">
                        <img src="/Assets/images/common-images/button-arrow-icon.svg" alt="">
                    </span>
                </a>
            </div>
        </div>
    </div>
}

