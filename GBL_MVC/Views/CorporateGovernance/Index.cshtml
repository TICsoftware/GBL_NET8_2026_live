@using GBL_MVC.Helpers
@model GBL_BusinessLogic.Entity.CorporateGovernanceModel
@{
    ViewData["Title"] = Model?.Content?.ContTitle ?? "Corporate governance";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var content = Model?.Content;
    var policies = Model?.Policies_List ?? new List<GBL_BusinessLogic.Entity.ArticleModel>();
    var codes = Model?.CodeOfConduct_List ?? new List<GBL_BusinessLogic.Entity.ArticleModel>();
    var committees = Model?.Committees_List ?? new List<GBL_BusinessLogic.Entity.CommitteeModel>();
}

@section head {
    <title>@(content?.cont_window_title)</title>
    <meta content="@(content?.cont_metatag)" name="keywords" />
    <meta content="@(content?.cont_metadesc)" name="description" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@(content?.ContTitle)" />
    <meta name="twitter:description" content="@(content?.cont_metadesc)" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Godavari Biorefineries" />
    <meta property="og:title" content="@(content?.ContTitle)" />
    <meta property="og:description" content="@(content?.cont_metadesc)" />
    <meta property="og:url" content="@(content?.CanonicalUrl)" />
    <meta property="og:image" content="@(content?.cont_meta_image)" />
    <link rel="canonical" href="@(content?.CanonicalUrl)" />
}

@section Styles {
    <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Assets/css/corporate-governance-intro.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Assets/css/investor-pdf.css" asp-append-version="true" />
}

@if (Model?.Content != null)
{
    @await Html.PartialAsync("~/Views/CommonComponent/_page_banner.cshtml", Model.Content)
}

<div class="cg-page">
    <div class="cg-jump-sentinel" aria-hidden="true"></div>
    <section class="cg-jump" aria-label="Corporate governance sections">
        <div class="container">
            <div class="cg-jump__track">
                <button type="button" class="cg-jump__arrow cg-jump__arrow--prev" aria-label="Previous section">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14.5 6 8.5 12l6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <nav class="cg-jump__nav">
                    <a class="cg-jump__btn" href="#policies">Policies</a>
                    <a class="cg-jump__btn" href="#code-of-conduct">Code of Conduct</a>
                    <a class="cg-jump__btn" href="#committees">Committees of the Board</a>
                </nav>
                <button type="button" class="cg-jump__arrow cg-jump__arrow--next" aria-label="Next section">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9.5 6 15.5 12l-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            </div>
        </div>
    </section>

    <section class="cg-docs section-spacing" id="policies" aria-labelledby="policies-title">
        <div class="container">
            <h2 id="policies-title" class="text-h2 title-animation">Policies</h2>
            <ul class="cg-docs__grid card-list-items">
                @await Html.PartialAsync("~/Views/Investors/_investor_pdf_list.cshtml", policies)
            </ul>
        </div>
    </section>

    <section class="cg-docs cg-docs--muted section-spacing" id="code-of-conduct" aria-labelledby="code-of-conduct-title">
        <div class="container">
            <h2 id="code-of-conduct-title" class="text-h2 title-animation">Code of Conduct</h2>
            <ul class="cg-docs__grid card-list-items">
                @await Html.PartialAsync("~/Views/Investors/_investor_pdf_list.cshtml", codes)
            </ul>
        </div>
    </section>

    <section class="cg-docs section-spacing" id="committees" aria-labelledby="committees-title">
            <div class="container">
                <h2 id="committees-title" class="text-h2 title-animation">Committees of the Board</h2>
                <ul class="cg-committees card-list-items">
                    @foreach (var committee in committees)
                    {
                        var isWide = committee.Members.Count > 4;
                        var mid = (int)Math.Ceiling(committee.Members.Count / 2.0);
                        <li class="cg-committee@(isWide ? " cg-committee--wide" : "") card-rise">
                            @if (!string.IsNullOrWhiteSpace(committee.Title))
                            {
                                <h3>@committee.Title</h3>
                            }
                            @if (isWide)
                            {
                                <div class="cg-committee__cols">
                                    <ul>
                                        @foreach (var member in committee.Members.Take(mid))
                                        {
                                            <li>
                                                <span class="cg-committee__name">@member.Name</span>
                                                @if (!string.IsNullOrWhiteSpace(member.Role))
                                                {
                                                    <span class="cg-committee__role">@member.Role</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                    <ul>
                                        @foreach (var member in committee.Members.Skip(mid))
                                        {
                                            <li>
                                                <span class="cg-committee__name">@member.Name</span>
                                                @if (!string.IsNullOrWhiteSpace(member.Role))
                                                {
                                                    <span class="cg-committee__role">@member.Role</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            else
                            {
                                <ul>
                                    @foreach (var member in committee.Members)
                                    {
                                        <li>
                                            <span class="cg-committee__name">@member.Name</span>
                                            @if (!string.IsNullOrWhiteSpace(member.Role))
                                            {
                                                <span class="cg-committee__role">@member.Role</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ul>
            </div>
        </section>
</div>

@section Scripts {
    <script src="~/Assets/js/card-animation.js" asp-append-version="true"></script>
}
