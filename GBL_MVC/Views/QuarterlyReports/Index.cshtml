@using GBL_MVC.Helpers
@model GBL_BusinessLogic.Entity.QuarterlyReportsModel
@{
    ViewData["Title"] = Model?.Content?.ContTitle ?? "Quarterly Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var content = Model?.Content;
    var years = Model?.Years ?? new List<GBL_BusinessLogic.Entity.QuarterlyReportYearModel>();
}

@section head {
    <title>@(content?.cont_window_title)</title>
    <meta content="@(content?.cont_metatag)" name="keywords" />
    <meta content="@(content?.cont_metadesc)" name="description" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@(content?.ContTitle)" />
    <meta name="twitter:description" content="@(content?.cont_metadesc)" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Godavari Biorefineries" />
    <meta property="og:title" content="@(content?.ContTitle)" />
    <meta property="og:description" content="@(content?.cont_metadesc)" />
    <meta property="og:url" content="@(content?.CanonicalUrl)" />
    <meta property="og:image" content="@(content?.cont_meta_image)" />
    <link rel="canonical" href="@(content?.CanonicalUrl)" />
}

@section Styles {
    <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Assets/css/quarterly-reports.css" asp-append-version="true" />
}

@if (content != null && content.ContId > 0)
{
    @await Html.PartialAsync("~/Views/CommonComponent/_page_banner.cshtml", content)
}
else
{
    <section class="relative inside-banner-outer">
        <div class="inside-banner-inner banner-animation relative">
            <div class="overflow-hidden h-[75vh] sm:h-[700px] relative innerbanner-image-wrapper">
                <picture>
                    <source media="(min-width:1024px)" srcset="~/Assets/images/banners/quarterly-reports-banner.webp">
                    <img src="~/Assets/images/banners/quarterly-reports-banner.webp" alt="Quarterly Reports"
                         class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                         loading="eager" fetchpriority="high">
                </picture>
                <div class="innerbanner-overlay"></div>
            </div>
            <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
                <div class="container">
                    <div class="max-w-4xl text-left">
                        <h1 class="innerbanner-title text-h1 text-white title-animation">Quarterly Reports</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<section class="qr-reports section-spacing" data-qr-reports aria-label="Quarterly reports">
    <div class="container">
        @if (years.Count == 0)
        {
            <p class="fh-year-filter__empty">No quarterly reports found.</p>
        }
        else
        {
            <div class="qr-years">
                <button type="button" class="qr-years__arrow qr-years__arrow--prev" aria-label="Previous year">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14.5 6 8.5 12l6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="qr-years__viewport">
                    <div class="qr-years__list" role="tablist" aria-label="Financial year">
                        @for (var i = 0; i < years.Count; i++)
                        {
                            var year = years[i];
                            var isActive = i == 0;
                            <button type="button"
                                    class="qr-years__btn@(isActive ? " is-active" : "")"
                                    id="qr-tab-@year.Key"
                                    role="tab"
                                    aria-selected="@(isActive ? "true" : "false")"
                                    aria-controls="qr-panel-@year.Key"
                                    data-qr-year="@year.Key">
                                <span class="qr-years__dot" aria-hidden="true"></span>
                                <span class="qr-years__label">@year.Title</span>
                            </button>
                        }
                    </div>
                </div>
                <button type="button" class="qr-years__arrow qr-years__arrow--next" aria-label="Next year">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9.5 6 15.5 12l-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            </div>

            @for (var i = 0; i < years.Count; i++)
            {
                var year = years[i];
                <div class="qr-panel"
                     id="qr-panel-@year.Key"
                     role="tabpanel"
                     aria-labelledby="qr-tab-@year.Key"
                     data-qr-panel="@year.Key"
                     @(i == 0 ? null : "hidden")>
                    <div class="qr-table-wrap">
                        <table class="qr-table">
                            <caption class="sr-only">Quarterly reports for @year.Title</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Date</th>
                                    <th scope="col">Quarter</th>
                                    <th scope="col">Financial results</th>
                                    <th scope="col">Results presentation</th>
                                    <th scope="col">Earning call transcript</th>
                                    <th scope="col">Earning call audio</th>
                                    <th scope="col">Download all</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in year.Quarters)
                                {
                                    var quarterLabel = string.IsNullOrWhiteSpace(item.Title) ? "quarter" : item.Title;
                                    <tr>
                                        <td>@item.PublishedOn</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(item.QuarterCode))
                                            {
                                                <span class="qr-qno">@item.QuarterCode</span>
                                                @if (!string.IsNullOrWhiteSpace(item.QuarterRange))
                                                {
                                                    <text> @item.QuarterRange</text>
                                                }
                                            }
                                            else
                                            {
                                                @item.Title
                                            }
                                        </td>
                                        <td>
                                            @await Html.PartialAsync("_qr_file_link", (item.FinancialResultsUrl, $"Financial results, {quarterLabel} {year.Title}", "pdf"))
                                        </td>
                                        <td>
                                            @await Html.PartialAsync("_qr_file_link", (item.ResultsPresentationUrl, $"Results presentation, {quarterLabel} {year.Title}", "pdf"))
                                        </td>
                                        <td>
                                            @await Html.PartialAsync("_qr_file_link", (item.TranscriptUrl, $"Earning call transcript, {quarterLabel} {year.Title}", "audio"))
                                        </td>
                                        <td>
                                            @await Html.PartialAsync("_qr_file_link", (item.AudioUrl, $"Earning call audio, {quarterLabel} {year.Title}", "audio"))
                                        </td>
                                        <td>
                                            @await Html.PartialAsync("_qr_file_link", (item.DownloadAllUrl, $"Download all documents, {quarterLabel} {year.Title}", "zip"))
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </div>
</section>

@section Scripts {
    <script src="~/Assets/js/quarterly-reports.js" asp-append-version="true"></script>
}
