@model Core_project_BusinessLogic.Entity.Product_Packaging_Master_Entity
@using Core_project_BusinessLogic.Entity
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = "~/Views/Shared/Manage/_Layout_RHS.cshtml";
    var list = ViewBag.List as List<Product_Packaging_Master_Entity>;
    var languages = ViewBag.Languages as SelectList;
    int totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize)
        : 0;
}

<div class="page-heading">
    <h4>Product Packaging Master</h4>

    <form method="get">
        <div class="row">
            <div class="col-md-10">
                <input type="text" name="search" value="@Model.SearchText" class="form-control" placeholder="Search name..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-success w-100">Search</button>
            </div>
        </div>
    </form>

    <div class="mb-3 mt-3">
        <a href="@Url.Action("Index", "Product_Master")" class="btn btn-outline-primary me-1 mb-1">Product</a>
        <a href="@Url.Action("Index", "Product_Packaging_Master")" class="btn btn-primary me-1 mb-1">Packaging</a>
    </div>

    <button type="button" class="btn btn-success mb-3 js-open-modal">+ Add New</button>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th class="icm-col-drag"></th>
                <th>Name</th>
                <th>Language</th>
                <th>Display Order</th>
                <th>Status</th>
                <th class="icm-col-action">Action</th>
            </tr>
        </thead>
        <tbody id="sortable">
            @if (list != null && list.Count > 0)
            {
                foreach (var item in list)
                {
                    <tr data-id="@item.product_packaging_MasterId" class="@((item.Status ?? 1) == 0 ? "inactive-row" : "")">
                        <td class="drag-handle">☰</td>
                        <td>@item.Name</td>
                        <td>@item.LanguageName</td>
                        <td>
                            <span id="lblseq_@item.product_packaging_MasterId">@item.Sequence</span>
                        </td>
                        <td>
                            @if ((item.Status ?? 1) == 1)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-primary packaging-edit-btn" data-id="@item.product_packaging_MasterId">Edit</button>
                            @if ((item.Status ?? 1) == 1)
                            {
                                <button type="button" class="btn btn-sm btn-warning deactivate-btn" data-id="@item.product_packaging_MasterId">Deactivate</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-success activate-btn" data-id="@item.product_packaging_MasterId">Activate</button>
                            }
                            <button type="button" class="btn btn-sm btn-danger delete-btn" data-id="@item.product_packaging_MasterId">Delete</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6">No records found</td></tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        @for (int i = 1; i <= totalPages; i++)
        {
            <a href="@Url.Action("Index", new { search = Model.SearchText, page = i })"
               class="btn btn-sm @(i == Model.PageNumber ? "btn-primary" : "btn-outline-primary")">@i</a>
        }
    </div>
</div>

<div class="modal fade" id="packagingModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="packagingModalTitle">Add Packaging</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="packagingMasterForm" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="packagingId" value="0" />

                    <label class="form-label" for="packagingName">Name <span class="text-danger">*</span></label>
                    <input type="text" id="packagingName" maxlength="250" class="form-control mb-1" />
                    <span id="packagingNameError" class="text-danger d-none"></span>

                    <label class="form-label mt-2" for="packagingLanguageId">Language</label>
                    <select id="packagingLanguageId" class="form-select mb-1">
                        <option value="">Select Language</option>
                        @if (languages != null)
                        {
                            foreach (var opt in languages)
                            {
                                <option value="@opt.Value">@opt.Text</option>
                            }
                        }
                    </select>

                    <label class="form-label mt-2" for="packagingSeq">Display Order <span class="text-danger">*</span></label>
                    <input type="number" id="packagingSeq" min="1" max="9999" class="form-control mb-1" />
                    <span id="packagingSeqError" class="text-danger d-none"></span>

                    <label class="form-label mt-3 d-block">Thumbnail Image</label>
                    <button type="button"
                            class="btn btn-outline-primary select-media"
                            data-media-hidden="#packagingThumbMediaId"
                            data-media-preview="#packagingThumbPreview">
                        Select Thumbnail
                    </button>
                    <input type="hidden" id="packagingThumbMediaId" value="" />
                    <img id="packagingThumbPreview" src="" alt="Thumbnail preview"
                         class="imgPreview img-thumbnail industry-media-preview mt-2" />

                    <label class="form-label mt-3" for="packagingThumbAlt">Thumbnail Image Alt Text</label>
                    <input type="text" id="packagingThumbAlt" maxlength="250" class="form-control" />
                    <span id="packagingThumbAltError" class="text-danger d-none"></span>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success js-save-packaging">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="btnSelectFiles" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Media Manager</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="mediaManagerModalBody"></div>
            <div class="modal-footer d-flex justify-content-end gap-2">
                <button id="btnAddImage" type="button" class="btn btn-primary">Add image</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section head {
    <link href="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Assets/css/industry-category-master-style.css" />
    <link rel="stylesheet" href="~/Assets/css/product-master-style.css" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script src="~/Assets/scripts/product_packaging_master.js"></script>
}
