@using GBL_MVC.Helpers
@model GBL_BusinessLogic.Entity.HomePageModel
@{
    ViewData["Title"] = "Godavari Biorefineries";
    Layout = "~/Views/Shared/_Layout_home_page.cshtml";
    var content = Model?.Home_Content;
}

@section head {
    <title>@(content?.cont_window_title)</title>
    <script nonce="@(Context.Items["CSPNonce"])">document.documentElement.classList.add('site-preloader-pending');</script>
    <style nonce="@(Context.Items["CSPNonce"])">
      html.site-preloader-pending .site-header {
        opacity:0 !important;
        visibility:hidden !important;
        pointer-events:none !important;
      }
    </style>

    <meta content="@(content?.cont_metatag)" name="keywords" />
    <meta content="@(content?.cont_metadesc)" name="description" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="" />
    <meta name="twitter:title" content="@(content?.ContTitle)" />
    <meta name="twitter:description" content="@(content?.cont_metadesc)" />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Godavari Biorefineries" />
    <meta property="og:title" content="@(content?.ContTitle)" />
    <meta property="og:description" content="@(content?.cont_metadesc)" />
    <meta property="og:url" content="https://www.godavaribiorefineries.com/" />
    <meta property="og:image" content="@(content?.cont_meta_image)" />

    <meta itemprop="name" content="Godavari Biorefineries" />
    <meta itemprop="description" content="@(content?.cont_metadesc)" />
    <meta itemprop="image" content="@(content?.cont_meta_image)" />

    <!-- Facebook / Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Godavari Biorefineries" />
    <meta property="og:title" content="@(content?.ContTitle)" />
    <meta property="og:description" content="@(content?.cont_metadesc)" />
    <meta property="og:image" content="@(content?.cont_meta_image)" />
    <meta property="og:url" content="https://www.godavaribiorefineries.com/" />

    <link rel="canonical" href="https://www.godavaribiorefineries.com/" />

    @if (!string.IsNullOrWhiteSpace(content?.page_schema))
    {
        @Html.Raw(content?.page_schema.Replace("<p>", "").Replace("</p>", ""))
    }
}

@section Styles {
    <link rel="preload" href="~/Assets/css/swiper-bundle.min.css" as="style">
    <link rel="stylesheet" href="~/Assets/css/swiper-bundle.min.css" />

    <link rel="preload" href="~/Assets/css/hero-banner.css" as="style">
    <link rel="stylesheet" href="~/Assets/css/hero-banner.css" asp-append-version="true" />

    <link rel="preload" href="~/Assets/css/homepage-style.css" as="style">
    <link rel="stylesheet" href="~/Assets/css/homepage-style.css" asp-append-version="true" />

    <link rel="preload" href="~/Assets/css/translating-products.css" as="style">
    <link rel="stylesheet" href="~/Assets/css/translating-products.css" asp-append-version="true" />

    <link rel="preload" href="~/Assets/css/philosophy-principles.css" as="style">
    <link rel="stylesheet" href="~/Assets/css/philosophy-principles.css" asp-append-version="true" />
}

@if (Model?.Banners != null && Model.Banners.Any())
{
    @await Html.PartialAsync("_hero_banner", Model.Banners)
}

@if (Model?.Belief_List != null && Model.Belief_List.Any())
{
    @await Html.PartialAsync("_begins_belief", Model.Belief_List)
}

@if (Model?.Philosophy_List != null && Model.Philosophy_List.Any())
{
    @await Html.PartialAsync("_philosophy", Model.Philosophy_List)
}

@if (Model?.TranslatingProducts_List != null && Model.TranslatingProducts_List.Any())
{
    @await Html.PartialAsync("_translating_products", Model.TranslatingProducts_List)
}

@if (Model?.AtAGlance_List != null && Model.AtAGlance_List.Any())
{
    @await Html.PartialAsync("_at_a_glance", Model.AtAGlance_List)
}

@if (Model?.SoilToTable_List != null && Model.SoilToTable_List.Any())
{
    @await Html.PartialAsync("_soil_to_table", Model.SoilToTable_List)
}

@if (Model?.GiveBack_List != null && Model.GiveBack_List.Any())
{
    @await Html.PartialAsync("_designed_give_back", Model.GiveBack_List)
}

@if (Model?.HealthierTomorrow_List != null && Model.HealthierTomorrow_List.Any())
{
    @await Html.PartialAsync("_healthier_tomorrow", Model.HealthierTomorrow_List)
}

@* Our Performance — intentionally not CMS-bound *@
<section class="section-spacing ourPerformance">
  <div class="container">
      <div class="title-section">
        <h2 class="text-h2">Our Performance</h2>
      </div>

      <div class="performance-row card-list-items">
        <article class="performance-card card-rise">
          <h3 class="text-h5">Investor Call</h3>
          <ul class="doc-list">
            <li>
              <a href="#">
                <span class="doc-icon" aria-hidden="true">
                    <img src="/Assets/images/homepage/our-performance/pdf-icon.svg" />
                </span>
                Transcript Q3 FY 26
              </a>
            </li>
            <li>
              <a href="#">
                <span class="doc-icon" aria-hidden="true">
                  <img src="/Assets/images/homepage/our-performance/voice-icon.svg" />
                </span>
                Audio of Investor Call &ndash; December-2025
              </a>
            </li>
            <li>
              <a href="#">
                <span class="doc-icon" aria-hidden="true">
                  <img src="/Assets/images/homepage/our-performance/pdf-icon.svg" />
                </span>
                Investor Presentation for Q3 9M FY 26
              </a>
            </li>
            <li>
              <a href="#">
                <span class="doc-icon" aria-hidden="true">
                  <img src="/Assets/images/homepage/our-performance/pdf-icon.svg" />
                </span>
                Investor Presentation Q2 H1 FY 26
              </a>
            </li>
          </ul>
        </article>

        <article class="performance-card card-rise">
          <h3 class="text-h5">Quarterly Results: Godavari Biorefineries Q3 FY26</h3>
          <ul class="doc-list">
            <li>
              <a href="#">
                <span class="doc-icon" aria-hidden="true">
                  <img src="/Assets/images/homepage/our-performance/pdf-icon.svg" />
                </span>
                Earnings Release
              </a>
            </li>
            <li>
              <a href="#">
                <span class="doc-icon" aria-hidden="true">
                    <img src="/Assets/images/homepage/our-performance/pdf-icon.svg" />
                </span>
                Analyst presentation
              </a>
            </li>
          </ul>
        </article>

        <article class="performance-card performance-card--report card-rise">
          <div class="performance-card__copy">
            <h3 class="text-h5">Godavari Biorefineries Annual Report FY25</h3>
            <a href="#" class="site-link">
              <span class="site-link-arrow" aria-hidden="true">&rarr;</span>
              Download
            </a>
          </div>
          <div class="performance-card__media">
            <img src="/Assets/images/homepage/performance/annual-report-fy25.png" alt="Godavari Biorefineries Annual Report FY25 cover">
          </div>
        </article>
      </div>

      <div class="flex justify-center">
        <a href="#" class="fill-site-link">
          <span class="site-link-arrow" aria-hidden="true">&rarr;</span>
          Learn more
        </a>
      </div>
  </div>
</section>

@if (Model?.Latest_List != null && Model.Latest_List.Any())
{
    @await Html.PartialAsync("_latest_at_gbl", Model.Latest_List)
}

@* Stories of Change — intentionally not CMS-bound *@
<section class="section-spacing storiesofChange">
  <div class="container">
      <div class="title-section">
        <h2 class="text-h2">Stories of Change</h2>
      </div>

      <div class="stories-grid">
        <article class="story-card ">
          <div class="story-card__media parallax-wrap">
            <img src="/Assets/images/homepage/stories/stories-img1.webp" alt="Shankar Jadhav standing in his sugarcane field" class="parallax-img img-fluid">
          </div>
          <div class="story-card__content">
            <h3 class="story-card__title text-h5">More Than a Better Harvest</h3>
            <p class="story-card__desc">Sugarcane farming no longer means uncertain returns for Shankar Jadhav</p>
            <a href="#" class="site-link story-card__link">
              <span class="site-link-arrow" aria-hidden="true">&rarr;</span>
              Learn More
            </a>
          </div>
        </article>

        <article class="story-card story-card--reverse">
          <div class="story-card__media parallax-wrap">
            <img src="/Assets/images/homepage/stories/stories-img2.webp" alt="His Place in the Story" class="parallax-img img-fluid">
          </div>

          <div class="story-card__content">
            <h3 class="story-card__title text-h5">His Place in the Story</h3>
            <p class="story-card__desc">Vishnu&rsquo;s barbershop shows how growth is measured in relationships at Godavari Biorefineries</p>
            <a href="#" class="site-link story-card__link">
              <span class="site-link-arrow" aria-hidden="true">&rarr;</span>
              Learn More
            </a>
          </div>
        </article>

        <article class="story-card">
          <div class="story-card__media  parallax-wrap">
            <img src="/Assets/images/homepage/stories/stories-img3.webp" alt="Scientists reviewing samples in a Godavari Biorefineries lab" class="parallax-img img-fluid" />
          </div>
          <div class="story-card__content">
            <h3 class="story-card__title text-h5">Enabling a Low-Carbon Future</h3>
            <p class="story-card__desc">As industries look to reduce their carbon footprint, partnerships matter</p>
            <a href="#" class="site-link story-card__link">
              <span class="site-link-arrow" aria-hidden="true">&rarr;</span>
              Learn More
            </a>
          </div>
        </article>

        <article class="story-card story-card--reverse">
          <div class="story-card__media  parallax-wrap">
            <img src="/Assets/images/homepage/stories/stories-img4.webp" alt="Woman applying perfume" class="parallax-img img-fluid" />
          </div>
          <div class="story-card__content">
            <h3 class="story-card__title text-h5">Not just a cosmetic make-over</h3>
            <p class="story-card__desc">Godavari Biorefineries&rsquo; bio-based chemicals are the go-to ingredients in personal care products</p>
            <a href="#" class="site-link story-card__link">
              <span class="site-link-arrow" aria-hidden="true">&rarr;</span>
              Learn More
            </a>
          </div>
        </article>
      </div>
  </div>
</section>

@if (Model?.GlobalStandards_List != null && Model.GlobalStandards_List.Any())
{
    @await Html.PartialAsync("_global_standards", Model.GlobalStandards_List)
}

@section Scripts {
  <script src="~/Assets/js/swiper-bundle.min.js"></script>
  <script src="~/Assets/js/hero-banner.js" asp-append-version="true"></script>
  <script src="~/Assets/js/homepage-script.js" asp-append-version="true"></script>
  <script src="~/Assets/js/translating-products.js" asp-append-version="true"></script>
  <script src="~/Assets/js/philosophy-principles.js" asp-append-version="true"></script>
  <script src="~/Assets/js/logo-marquee-script.js" asp-append-version="true"></script>
  <script src="~/Assets/js/giveback-animation.js" asp-append-version="true"></script>
  <script src="~/Assets/js/card-animation.js" asp-append-version="true"></script>
  <script src="~/Assets/js/stories-card-animation.js" asp-append-version="true"></script>
  <script src="~/Assets/js/odometer-counter-script.js"></script>
  <script src="~/Assets/js/ataglance-script.js" asp-append-version="true"></script>
}
