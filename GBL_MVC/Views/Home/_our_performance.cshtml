@using System.Globalization
@using GBL_BusinessLogic.Entity
@using GBL_MVC.Helpers
@model HomePageModel
@{
    var quarter = Model?.LatestQuarter;
    var annual = Model?.LatestAnnualReport;
    var annualHref = FirstText(annual?.MediafilePath, annual?.Url, annual?.ExternalUrl);
    var annualThumb = FirstText(annual?.ThumbnailImage, "/Assets/images/homepage/performance/annual-report-fy25.png");
    var annualTitle = FirstText(annual?.Title, "Annual Report");
    var quarterHeading = QuarterHeading(quarter);
    var hasCall = quarter != null && (
        !string.IsNullOrWhiteSpace(quarter.TranscriptUrl) ||
        !string.IsNullOrWhiteSpace(quarter.AudioUrl));
    var hasResults = quarter != null && (
        !string.IsNullOrWhiteSpace(quarter.FinancialResultsUrl) ||
        !string.IsNullOrWhiteSpace(quarter.ResultsPresentationUrl));
    var hasAnnual = annual != null && (
        !string.IsNullOrWhiteSpace(annual.Title) ||
        !string.IsNullOrWhiteSpace(annualHref));
}

@if (hasCall || hasResults || hasAnnual)
{
<section class="section-spacing ourPerformance">
  <div class="container">
      <div class="title-section">
        <h2 class="text-h2">Our Performance</h2>
      </div>

      <div class="performance-row card-list-items">
        @if (hasCall)
        {
        <article class="performance-card card-rise">
          <h3 class="text-h5">Investor Call</h3>
          <ul class="doc-list">
            @if (!string.IsNullOrWhiteSpace(quarter!.TranscriptUrl))
            {
            <li>
              <a href="@quarter.TranscriptUrl" target="_blank" rel="noopener noreferrer">
                <span class="doc-icon" aria-hidden="true">
                    <img src="@Url.Content("~/Assets/images/homepage/our-performance/pdf-icon.svg")" alt="" />
                </span>
                Transcript @(string.IsNullOrWhiteSpace(quarter.QuarterCode) ? "" : quarter.QuarterCode)
              </a>
            </li>
            }
            @if (!string.IsNullOrWhiteSpace(quarter.AudioUrl))
            {
            <li>
              <a href="@quarter.AudioUrl" target="_blank" rel="noopener noreferrer">
                <span class="doc-icon" aria-hidden="true">
                  <img src="@Url.Content("~/Assets/images/homepage/our-performance/voice-icon.svg")" alt="" />
                </span>
                Audio of Investor Call@(AudioLabel(quarter))
              </a>
            </li>
            }
          </ul>
        </article>
        }

        @if (hasResults)
        {
        <article class="performance-card card-rise">
          <h3 class="text-h5">@quarterHeading</h3>
          <ul class="doc-list">
            @if (!string.IsNullOrWhiteSpace(quarter!.FinancialResultsUrl))
            {
            <li>
              <a href="@quarter.FinancialResultsUrl" target="_blank" rel="noopener noreferrer">
                <span class="doc-icon" aria-hidden="true">
                  <img src="@Url.Content("~/Assets/images/homepage/our-performance/pdf-icon.svg")" alt="" />
                </span>
                Earnings Release
              </a>
            </li>
            }
            @if (!string.IsNullOrWhiteSpace(quarter.ResultsPresentationUrl))
            {
            <li>
              <a href="@quarter.ResultsPresentationUrl" target="_blank" rel="noopener noreferrer">
                <span class="doc-icon" aria-hidden="true">
                    <img src="@Url.Content("~/Assets/images/homepage/our-performance/pdf-icon.svg")" alt="" />
                </span>
                Analyst presentation
              </a>
            </li>
            }
          </ul>
        </article>
        }

        @if (hasAnnual)
        {
        <article class="performance-card performance-card--report card-rise">
          <div class="performance-card__copy">
            <h3 class="text-h5">@Html.Raw((annualTitle ?? "").CleanParagraphTags())</h3>
            @if (!string.IsNullOrWhiteSpace(annualHref))
            {
            <a href="@annualHref" class="site-btn site-btn--line" target="_blank" rel="noopener noreferrer">
              <span class="site-btn__label">Download</span>
              <span class="site-btn__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
            }
          </div>
          <div class="performance-card__media">
            <img src="@annualThumb" alt="@annualTitle">
          </div>
        </article>
        }
      </div>

      <div class="flex justify-center">
        <a href="/investors" class="site-btn site-btn--fill">
          <span class="site-btn__label">Learn more</span>
          <span class="site-btn__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      </div>
  </div>
</section>
}

@functions {
    private static string FirstText(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value))
                return value.Trim();
        }
        return "";
    }

    private static string QuarterHeading(QuarterlyReportItemModel? quarter)
    {
        var title = (quarter?.Title ?? "").Trim();
        if (string.IsNullOrWhiteSpace(title))
            return "Quarterly Results";
        if (title.Contains("Quarterly", StringComparison.OrdinalIgnoreCase))
            return title;
        return "Quarterly Results: " + title;
    }

    private static string AudioLabel(QuarterlyReportItemModel quarter)
    {
        if (!string.IsNullOrWhiteSpace(quarter.PublishedOn))
        {
            var published = quarter.PublishedOn.Trim();
            if (published.StartsWith("Published on ", StringComparison.OrdinalIgnoreCase))
                published = published.Substring("Published on ".Length).Trim();
            return " \u2013 " + published;
        }
        if (!string.IsNullOrWhiteSpace(quarter.QuarterRange))
            return " \u2013 " + quarter.QuarterRange.Trim();
        return "";
    }
}
