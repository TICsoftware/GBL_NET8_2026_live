@using GBL_BusinessLogic.Entity
@using GBL_MVC.Helpers
@model HomeCommonModel

@{
    var avatar = !string.IsNullOrWhiteSpace(Model.ComponentThumbnail)
        ? Model.ComponentThumbnail
        : Model.ThumbnailImage;
}

<div class="quote-card rounded-sm shrink-0">
  <div class="quote-mark"> <img src="/Assets/images/common-images/quote-icon.svg" alt="" class="w-auto object-cover"></div>
  <p class="quote-card-para">
    @Html.Raw(Model.Intro.CleanParagraphTags())
  </p>
  <div class="flex items-center gap-3 quote-card-content">
    @if (!string.IsNullOrWhiteSpace(avatar))
    {
        <img src="@avatar" alt="@Model.ComponentThumbnailAltText" class="w-15 h-15 rounded-full object-cover" />
    }
    <div>
      <p class="quote-card-member">@Model.Title</p>
      @if (!string.IsNullOrWhiteSpace(Model.Designation))
      {
          <p class="quote-card-desn"> @Html.Raw(Model.Designation.CleanParagraphTags())</p>
      }
    </div>
  </div>
  @if (!string.IsNullOrWhiteSpace(Model.Url))
  {
  <div class="outer-btn-wrap">
    <a class="site-link" href="@Model.Url">
      @(!string.IsNullOrWhiteSpace(Model.Url_Text) ? Model.Url_Text : "Read The Story")
      <span class="site-link-arrow" aria-hidden="true"><img src="/Assets/images/common-images/button-arrow-icon.svg" alt="" class="w-auto object-cover"></span>
    </a>
  </div>
  }
</div>
