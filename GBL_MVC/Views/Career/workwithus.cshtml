@using GBL_MVC.Helpers
@model GBL_BusinessLogic.Entity.CareersModel
@{
   ViewData["Title"] = Model?.Content?.ContTitle ?? "Work with us";
   Layout = "~/Views/Shared/_Layout.cshtml";
   var content = Model?.Content;
}

@section head {
   <title>@(content?.cont_window_title)</title>

   <meta content="@(content?.cont_metatag)" name="keywords" />
   <meta content="@(content?.cont_metadesc)" name="description" />

   <meta name="twitter:card" content="summary" />
   <meta name="twitter:site" content="" />
   <meta name="twitter:title" content="@(content?.ContTitle)" />
   <meta name="twitter:description" content="@(content?.cont_metadesc)" />

   <meta property="og:type" content="article" />
   <meta property="og:site_name" content="Godavari Biorefineries" />
   <meta property="og:title" content="@(content?.ContTitle)" />
   <meta property="og:description" content="@(content?.cont_metadesc)" />
   <meta property="og:url" content="@(content?.CanonicalUrl)" />
   <meta property="og:image" content="@(content?.cont_meta_image)" />

   <meta itemprop="name" content="Godavari Biorefineries" />
   <meta itemprop="description" content="@(content?.cont_metadesc)" />
   <meta itemprop="image" content="@(content?.cont_meta_image)" />

   <meta property="og:type" content="website" />
   <meta property="og:site_name" content="Godavari Biorefineries" />
   <meta property="og:title" content="@(content?.ContTitle)" />
   <meta property="og:description" content="@(content?.cont_metadesc)" />
   <meta property="og:image" content="@(content?.cont_meta_image)" />
   <meta property="og:url" content="@(content?.CanonicalUrl)" />

   <link rel="canonical" href="@(content?.CanonicalUrl)" />
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/enquiry-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/careers-style.css" asp-append-version="true" />
}

<!-- HERO BANNER -->
@if (Model?.Content != null)
{
   @await Html.PartialAsync("~/Views/CommonComponent/_page_banner.cshtml", Model.Content)
}
else
{
   <section class="relative inside-banner-outer">
      <div class="inside-banner-inner banner-animation relative">
         <div class="overflow-hidden h-[75vh] sm:h-[700px] relative innerbanner-image-wrapper">
            <picture>
               <source media="(min-width:1024px)" srcset="~/Assets/images/banners/Workwithus-desktop.webp">
               <source media="(min-width:992px)" srcset="~/Assets/images/banners/Workwithus-mob.webp">
               <img src="~/Assets/images/banners/Workwithus-desktop.webp" alt="Work with us"
                  class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                  loading="eager" fetchpriority="high">
            </picture>
            <div class="innerbanner-overlay"></div>
         </div>
         <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
            <div class="container">
               <div class="max-w-4xl text-left">
                  <h1 class="innerbanner-title text-h1 text-white title-animation">Work with us</h1>
                  <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                     <ol class="flex items-center gap-2 text-sm">
                        <li><a href="/" class="text-white/70 hover:text-white transition">Home</a></li>
                        <li class="text-white/60">/</li>
                        <li><a href="/careers" class="text-white/70 hover:text-white transition">Careers</a></li>
                        <li class="text-white/60">/</li>
                        <li class="text-white">Work with us</li>
                     </ol>
                  </nav>
               </div>
            </div>
         </div>
      </div>
   </section>
}
<!-- HERO BANNER END -->

<!--PAGE INTRO OUTER-->
@if (!string.IsNullOrWhiteSpace(Model?.Content?.Cont_intro))
{
   <section class="relative overflow-hidden section-spacing page-intro-outer bg-gray">
      <div class="container">
         <div class="page-intro-inner intro-lg text-center">
            @Html.Raw(Model.Content.Cont_intro)
         </div>
      </div>
   </section>
}
else
{
   <section class="relative overflow-hidden section-spacing page-intro-outer bg-gray">
      <div class="container">
         <div class="page-intro-inner intro-lg text-center">
            <p>Even if there isn’t a role for you today, we’d love to hear from you. Share your resume and be considered for future opportunities that align with your experience, expertise and career aspirations.</p>
         </div>
      </div>
   </section>
}
<!--PAGE INTRO OUTER END-->

<section class="enquiry-section section-spacing">
   <div class="container">
      <form id="workWithUsForm"
            class="enquiry-form career-form"
            method="post"
            asp-controller="Career"
            asp-action="SubmitWorkWithUs"
            enctype="multipart/form-data"
            novalidate>
         @Html.AntiForgeryToken()

         <div class="enquiry-form__columns">
            <div class="enquiry-form__col">
               <div class="enquiry-field">
                  <label class="enquiry-field__label" for="FullName">Full Name</label>
                  <input type="text" id="FullName" name="FullName" autocomplete="name" placeholder="Full Name*" maxlength="100" aria-required="true">
                  <span class="text-red-500 text-sm" data-valmsg-for="FullName"></span>
               </div>
               <div class="enquiry-field">
                  <label class="enquiry-field__label" for="Email">Email</label>
                  <input type="email" id="Email" name="Email" autocomplete="email" placeholder="Email*" maxlength="500" aria-required="true">
                  <span class="text-red-500 text-sm" data-valmsg-for="Email"></span>
               </div>
               <div class="enquiry-field">
                  <label class="enquiry-field__label" for="Expertise">Function / Area of expertise</label>
                  <input type="text" id="Expertise" name="Expertise" autocomplete="organization-title" placeholder="Function / Area of expertise" maxlength="1000">
                  <span class="text-red-500 text-sm" data-valmsg-for="Expertise"></span>
               </div>
            </div>
            <div class="enquiry-form__col">
               <div class="enquiry-field">
                  <label class="enquiry-field__label" for="Address">Address</label>
                  <input type="text" id="Address" name="Address" autocomplete="street-address" placeholder="Address" maxlength="2000">
                  <span class="text-red-500 text-sm" data-valmsg-for="Address"></span>
               </div>
               <div class="enquiry-field">
                  <label class="enquiry-field__label" for="Designation">Designation</label>
                  <input type="text" id="Designation" name="Designation" autocomplete="organization-title" placeholder="Designation" maxlength="1000">
                  <span class="text-red-500 text-sm" data-valmsg-for="Designation"></span>
               </div>
               <div class="enquiry-field career-field--file">
                  <span class="enquiry-field__label" id="resumeLabel">Upload resume</span>
                  <label class="career-file" for="Resume">
                     <input type="file" id="Resume" name="Resume"
                        accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                        aria-labelledby="resumeLabel">
                     <span class="career-file__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M8.5 12.5 14 7a3 3 0 0 1 4.2 4.2l-7.1 7.1a4.2 4.2 0 0 1-6-6l6.4-6.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                     </span>
                     <span class="career-file__name" data-file-name>Upload resume</span>
                  </label>
                  <span class="text-red-500 text-sm" data-valmsg-for="Resume"></span>
               </div>
            </div>
         </div>
         <div class="enquiry-field enquiry-field--area">
            <label class="enquiry-field__label" for="Message">Message</label>
            <textarea id="Message" name="Message" rows="4" placeholder="Message" maxlength="2000"></textarea>
            <span class="text-red-500 text-sm" data-valmsg-for="Message"></span>
         </div>
         <div class="enquiry-recaptcha">
            <label class="enquiry-recaptcha__box">
               <input type="checkbox" id="NotRobot" name="NotRobot" value="true" aria-required="true">
               <span class="enquiry-recaptcha__label">I'm not a robot</span>
               <span class="enquiry-recaptcha__brand">
                  <svg viewBox="0 0 64 64" aria-hidden="true">
                     <path fill="#1c3aa9" d="M32 6a26 26 0 0 1 22.2 12.5l-7.2 4.2A17.2 17.2 0 0 0 32 14.8V6z"/>
                     <path fill="#4285f4" d="M54.2 18.5A26 26 0 0 1 32 58v-8.8a17.2 17.2 0 0 0 14.8-25.2l7.4-5.5z"/>
                     <path fill="#ababab" d="M32 58A26 26 0 0 1 9.8 18.5l7.4 4.3A17.2 17.2 0 0 0 32 49.2V58z"/>
                     <path fill="#1a73e8" d="M12.4 16.2 19.6 21A17.2 17.2 0 0 1 32 14.8V6a26 26 0 0 0-19.6 10.2z"/>
                  </svg>
                  <span>reCAPTCHA</span>
               </span>
            </label>
            <span class="text-red-500 text-sm" data-valmsg-for="NotRobot"></span>
         </div>
         <button type="submit" class="site-btn site-btn--fill" id="workWithUsSubmitBtn">
            <span class="site-btn__label">Submit</span>
            <span class="site-btn__arrow" aria-hidden="true">
               <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
         </button>
         <div id="workWithUsMessage" class="mt-4 text-center"></div>
      </form>
   </div>
</section>

@section Scripts {
   <script src="~/Assets/js/workwithus-form.js" asp-append-version="true"></script>
}
