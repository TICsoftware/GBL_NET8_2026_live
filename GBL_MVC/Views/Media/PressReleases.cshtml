@using GBL_MVC.Helpers
@using Microsoft.AspNetCore.Razor.Language
@model GBL_BusinessLogic.Entity.MediaModel
@{
   ViewData["Title"] = Model?.Content?.ContTitle ?? "Press release";
   Layout = "~/Views/Shared/_Layout.cshtml";
   var content = Model?.Content;

   var section = ViewData["NewsSection"] as string ?? "press-release";
   var isPress = section == "press-release";
   var pageTitle = isPress ? "Press Release" : "Media Coverage";
}



@section head {
   <title>@(content?.cont_window_title)</title>

   <meta content="@(content?.cont_metatag)" name="keywords" />
   <meta content="@(content?.cont_metadesc)" name="description" />

   <meta name="twitter:card" content="summary" />
   <meta name="twitter:site" content="" />
   <meta name="twitter:title" content="@(content?.ContTitle)" />
   <meta name="twitter:description" content="@(content?.cont_metadesc)" />

   <meta property="og:type" content="article" />
   <meta property="og:site_name" content="Priya Cement" />
   <meta property="og:title" content="@(content?.ContTitle)" />
   <meta property="og:description" content="@(content?.cont_metadesc)" />
   <meta property="og:url" content="@(content?.CanonicalUrl)" />
   <meta property="og:image" content="@(content?.cont_meta_image)" />

   <meta itemprop="name" content="Priya Cement" />
   <meta itemprop="description" content="@(content?.cont_metadesc)" />
   <meta itemprop="image" content="@(content?.cont_meta_image)" />

   <meta property="og:type" content="website" />
   <meta property="og:site_name" content="Priya Cement" />
   <meta property="og:title" content="@(content?.ContTitle)" />
   <meta property="og:description" content="@(content?.cont_metadesc)" />
   <meta property="og:image" content="@(content?.cont_meta_image)" />
   <meta property="og:url" content="@(content?.CanonicalUrl)" />

   <link rel="canonical" href="@(content?.CanonicalUrl)" />

 
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/industries-tab.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/industries-filter.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/news-style.css" asp-append-version="true" />
}

<!-- HERO BANNER END-->
@if (Model?.Content != null)
{
   @await Html.PartialAsync("~/Views/CommonComponent/_page_banner_media.cshtml", Model.Content)
}
<!-- HERO BANNER END -->


<section class="relative section-spacing pb-0!">
   <div class="container">
      <div class="news-toolbar tab-outer mb-10">
         <div class="industry-tabs" role="tablist" aria-label="News categories">
            <span class="industry-tabs__thumb" aria-hidden="true"></span>
            <a href="/media/press-release" class="industry-tab@(isPress ? " is-active" : "")" id="tab-btn-PressRelease"
               role="tab" aria-selected="@(isPress ? "true" : "false")" aria-controls="tab-PressRelease"
               data-tab="PressRelease">
               Press Release
            </a>
            <a href="/media/media-coverage" class="industry-tab@(!isPress ? " is-active" : "")"
               id="tab-btn-MediaCoverage" role="tab" aria-selected="@(!isPress ? "true" : "false")"
               aria-controls="tab-MediaCoverage" data-tab="MediaCoverage">
               Media Coverage
            </a>
         </div>

         <button type="button" class="filter-mobile-trigger" data-open-news-filter aria-controls="news-filter"
                 aria-expanded="false">
            <span class="filter-mobile-trigger__icon" aria-hidden="true"></span>
            Refine by Filters
         </button>
         <div class="filter-mobile-backdrop" data-close-news-filter></div>
         <form class="news-filters" id="news-filter" action="#" method="get">
            <div class="filter-mobile-sheet-head">
               <h2 class="filter-mobile-sheet-head__title">Set Filters</h2>
               <button type="button" class="filter-mobile-close" data-close-news-filter
                       aria-label="Close filters">&times;</button>
            </div>
            <div class="news-filters-desktop">

               <div class="cselect">
                  <label class="cselect-sr" for="filter-topic">Select Topic</label>
                  <select id="filter-topic" name="topic" class="cselect-native">
                     <option value="">Select Topic</option>
                     @foreach (var tag in Model.Tag_List)
                     {
                        <option value="@tag.Value">@tag.Text</option>
                     }
                  </select>
               </div>

               <div class="cselect">
                  <label class="cselect-sr" for="filter-month">Select Month</label>
                  <select id="filter-month" name="month" class="cselect-native">
                     <option value="">Select Month</option>
                     @for (int m = 1; m <= 12; m++)
                     {
                        <option value="@m">
                           @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
                        </option>
                     }
                  </select>
               </div>
               <div class="cselect">
                  <label class="cselect-sr" for="filter-year">Select Year</label>
                  <select id="filter-year" name="year" class="cselect-native">
                     <option value="">Select Year</option>
                     @foreach (var year in Model.Year_List)
                     {
                        <option value="@year.Value">@year.Text</option>
                     }
                  </select>
               </div>
            </div>
            <div class="filter-mobile-sheet-foot">
               <button type="button" class="filter-mobile-clear" data-clear-news-filter>Clear Filters</button>
               <button type="button" class="filter-mobile-apply" data-close-news-filter>Apply Filters</button>
            </div>
         </form>
      </div>
   </div>
</section>


<section class="relative industries-inside-outer news-inside-outer mb-20">
   <div class="container">
      <div class="industries-tab-content">
         <div class="industry-tab-panel is-active" id="tab-PressRelease" role="tabpanel"
              aria-labelledby="tab-btn-PressRelease" data-tab-panel="PressRelease">
           
            <div id="DivContent" class="industry-product-grid media-coverage-grid" data-news-grid data-page-size="12"
                 data-total-count="@Model.TotalCount" data-content-id="@(Model.Content?.ContId ?? 0)"
                 data-load-url="@Url.Action("LoadPressReleases", "Media")">

               @await Html.PartialAsync("_press_release_list", Model.SectionArticles_List)


            </div>

            <div class="news-load-more" data-news-load-more-wrap hidden>
               <button type="button" class="site-btn site-btn--fill" data-news-load-more>
                  <span class="site-btn__label">Load More</span>
                  <span class="site-btn__arrow" aria-hidden="true">
                     <svg viewBox="0 0 24 24" fill="none">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                              stroke-linejoin="round" />
                     </svg>
                  </span>
               </button>
            </div>

         </div>
      </div>
   </div>
</section>



@section Scripts {
   <script src="~/Assets/js/industries-filter.js" asp-append-version="true"></script>
   <script src="~/Assets/js/news-script.js" asp-append-version="true"></script>
   <script src="~/scripts/News/press-release.js" asp-append-version="true"></script>
}
