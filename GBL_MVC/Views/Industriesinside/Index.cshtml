@model Core_project_BusinessLogic.Entity.Industry_Inside_Page
@{
    var industry = Model.Industry ?? new Core_project_BusinessLogic.Entity.Industry_Inside_Detail();
    var title = industry.IndustryName ?? "Industry";
    var windowTitle = string.IsNullOrWhiteSpace(industry.WindowTitle) ? title : industry.WindowTitle;
    var metaTitle = string.IsNullOrWhiteSpace(industry.MetaTitle) ? windowTitle : industry.MetaTitle;
    var banner = industry.BannerUrl ?? "";
    var bannerAlt = industry.BannerAlt ?? title;
    var activeCategoryId = Model.ActiveCategoryId;
    var categories = Model.Categories ?? new List<Core_project_BusinessLogic.Entity.Industry_Public_Lookup>();
    ViewData["Title"] = windowTitle;
}

@section head {
    <title>@metaTitle</title>
    <meta content="@industry.MetaDescription" name="description" />
}

@section Styles {
   <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/industries-style.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/Assets/css/industries-tab.css" asp-append-version="true" />
}

   <section class="relative inside-banner-outer">
         <div class="inside-banner-inner banner-animation relative">
            <div class="overflow-hidden h-[75vh] sm:h-[700px] relative innerbanner-image-wrapper">
               <picture>
                  @if (!string.IsNullOrWhiteSpace(banner))
                  {
                      <source media="(min-width:1024px)" srcset="@banner">
                      <img src="@banner"
                           alt="@bannerAlt"
                           class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                           loading="eager"
                           fetchpriority="high">
                  }
               </picture>
               <div class="innerbanner-overlay"></div>
            </div>

            <div class="innerbanner-caption absolute inset-0 z-30 flex items-center">
               <div class="container">
                  <div class="max-w-4xl text-left">
                     <h1 class="innerbanner-title text-h1 text-white title-animation">
                       @title
                     </h1>

                     <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                        <ol class="flex items-center gap-2 text-sm">
                           <li>
                              <a href="/" class="text-white/70 hover:text-white transition">Home</a>
                           </li>
                           <li class="text-white/60">/</li>
                           <li>
                              <a href="/industries" class="text-white/70 hover:text-white transition">Industries</a>
                           </li>
                           <li class="text-white/60">/</li>
                           <li class="text-white">@title</li>
                        </ol>
                     </nav>
                  </div>
               </div>
            </div>
         </div>
   </section>

   @if (!string.IsNullOrWhiteSpace(industry.Intro))
   {
   <section class="relative overflow-hidden section-spacing page-intro-outer bg-gray">
       <div class="container">
         <div class="page-intro-inner intro-lg text-center">
            @Html.Raw(industry.Intro)
         </div>
      </div>
   </section>
   }

   <section class="relative section-spacing industries-inside-outer"
            id="industryInsideRoot"
            data-industry-id="@industry.IndustryId"
            data-page-size="@Model.PageSize">
      @if (categories.Count > 0)
      {
      <div class="container">
         <div class="tab-outer mb-3">
            <div class="industry-tabs" role="tablist" aria-label="Product categories">
               <span class="industry-tabs__thumb" aria-hidden="true"></span>
               @for (int i = 0; i < categories.Count; i++)
               {
                   var cat = categories[i];
                   var isActive = cat.Id == activeCategoryId || (activeCategoryId == 0 && i == 0);
                   <button type="button"
                           class="industry-tab @(isActive ? "is-active" : "")"
                           id="tab-btn-@cat.Id"
                           role="tab"
                           aria-selected="@(isActive ? "true" : "false")"
                           aria-controls="tab-@cat.Id"
                           data-tab="@cat.Id">
                      @cat.Name
                   </button>
               }
            </div>
         </div>
      </div>
      }

      <div class="container">
         <div class="industries-tab-content">
            @if (categories.Count > 0)
            {
                for (int i = 0; i < categories.Count; i++)
                {
                    var cat = categories[i];
                    var isActive = cat.Id == activeCategoryId || (activeCategoryId == 0 && i == 0);
                    var panelProducts = isActive ? Model.Products : new List<Core_project_BusinessLogic.Entity.Industry_Inside_Product>();
                    var panelTotal = isActive ? Model.TotalRecords : 0;
                    <div class="industry-tab-panel @(isActive ? "is-active" : "")"
                         id="tab-@cat.Id"
                         role="tabpanel"
                         aria-labelledby="tab-btn-@cat.Id"
                         data-tab-panel="@cat.Id"
                         data-category-id="@cat.Id"
                         data-loaded="@(isActive ? "1" : "0")"
                         data-page="1"
                         data-total="@panelTotal"
                         hidden="@(!isActive)">

                       <div class="section-intro">
                          <div class="section-intro__title title-section">
                             <h2 class="text-h2 title-animation">@cat.Name</h2>
                          </div>
                       </div>

                       <div class="industry-product-grid" data-product-grid>
                          @if (isActive && panelProducts.Count > 0)
                          {
                              foreach (var item in panelProducts)
                              {
                                  @await Html.PartialAsync("_IndustryProductCard", item)
                              }
                          }
                          else if (isActive)
                          {
                              <p class="js-industry-empty">No products found</p>
                          }
                       </div>

                       <div class="flex justify-center mt-8">
                          <button type="button"
                                  class="site-btn site-btn--fill js-load-more-products"
                                  style="@((isActive && panelTotal > Model.PageSize) ? "" : "display:none;")">
                             <span class="site-btn__label">Load more</span>
                          </button>
                       </div>
                    </div>
                }
            }
            else
            {
                <div class="industry-tab-panel is-active"
                     data-tab-panel="0"
                     data-category-id="0"
                     data-loaded="1"
                     data-page="1"
                     data-total="@Model.TotalRecords">
                   <div class="section-intro">
                      <div class="section-intro__title title-section">
                         <h2 class="text-h2 title-animation">Products</h2>
                      </div>
                   </div>
                   <div class="industry-product-grid" data-product-grid>
                      @if (Model.Products != null && Model.Products.Count > 0)
                      {
                          foreach (var item in Model.Products)
                          {
                              @await Html.PartialAsync("_IndustryProductCard", item)
                          }
                      }
                      else
                      {
                          <p class="js-industry-empty">No products found</p>
                      }
                   </div>
                   <div class="flex justify-center mt-8">
                      <button type="button"
                              class="site-btn site-btn--fill js-load-more-products"
                              style="@(Model.TotalRecords > Model.PageSize ? "" : "display:none;")">
                         <span class="site-btn__label">Load more</span>
                      </button>
                   </div>
                </div>
            }
         </div>
      </div>
   </section>

@section Scripts {
   <script src="~/Assets/js/industries-tab-script.js" asp-append-version="true"></script>
   <script src="~/Assets/js/industries-inside-loadmore.js" asp-append-version="true"></script>
}
