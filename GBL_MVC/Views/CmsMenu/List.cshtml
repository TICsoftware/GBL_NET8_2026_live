@using System.Runtime.Serialization
@using Core_project_BusinessLogic
@using Core_project_BusinessLogic.Entity.Manage
@model IEnumerable<MenuHeader>
@{
    Layout = "~/Views/Shared/Manage/_Layout_RHS.cshtml";

    string search = ViewBag.Search?.ToString() ?? "";
    int? Status = ViewBag.Status as int?;
    int curPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<h2>Header Menu List</h2>

<form method="get" class="mb-3 d-flex align-items-start" id="searchForm" novalidate>

    <!-- Search -->
    <input type="text" name="search" id="search" value="@search" class="form-control w-25"
        placeholder="Search menu name..." maxlength="100" />

    <!-- Status Dropdown -->
    <select name="Status" class="form-select ms-2" style="width: 180px;">
        <option value="">All Status</option>
        <option value="1" selected="@(Status == 1)">Active</option>
        <option value="0" selected="@(Status == 0)">Inactive</option>
    </select>

    <button type="submit" class="btn btn-secondary ms-2">
        Search
    </button>

</form>

<a asp-action="AddEdit" class="btn btn-primary mb-3">Add New Menu</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Menu Name</th>
            <th>Parent Menu</th>
            <th>Menu Type</th>
            <th>URL</th>
            <th>Sequence</th>
            <th>Status</th>
            <th>Created</th>
            <th width="250">Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MenuId</td>

                    <td>
                        @item.MenuName

                    </td>

                    <td>
                        @(string.IsNullOrEmpty(item.ParentMenuName)
                                        ? "Main Menu"
                                        : item.ParentMenuName)
                    </td>

                    <td>@item.MenuType</td>

                    <td>
                        @if (!string.IsNullOrEmpty(item.Url))
                        {
                            @item.Url
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>

                    <td>@item.Sequence</td>

                    <td>
                        @if (item.Status == 2)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>

                    <td>@item.CreatedDate.ToString("dd-MMM-yyyy")</td>

                    <td>
                        <a asp-action="Edit" asp-route-id="@CryptoEngine.Encrypt(item.MenuId.ToString())"
                            class="btn btn-sm btn-outline-secondary">
                            Edit
                        </a>

                        @if (item.Status == 2)
                        {
                            <a asp-action="Deactivate" asp-route-id="@CryptoEngine.Encrypt(item.MenuId.ToString())"
                                class="btn btn-sm btn-outline-danger js-confirm-deactivate">
                                Deactivate
                            </a>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9" class="text-center text-muted">
                    No menu records found.
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination -->
@if (totalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == curPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("List", new
                                         {
                                             page = i,
                                             search = search,
                                             Status = Status
                                         })">
                @i
            </a>
        </li>
                }
        </ul>
    </nav>
}

@section Scripts {

    <script src="~/Assets/scripts/menu_header_index.js"></script>
    @* <script src="~/Assets/scripts/CMS_paging.js" type="module"></script>
    @if (ViewBag.alert_message != null)
    {
        <div id="edit-content-alert" class="d-none" data-message="@ViewBag.alert_message"></div>
        <script src="~/Assets/scripts/edit_content_alert.js"></script>
    } *@
}