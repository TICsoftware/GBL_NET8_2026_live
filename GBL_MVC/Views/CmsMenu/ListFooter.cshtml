@using System.Runtime.Serialization
@using Core_project_BusinessLogic
@using Core_project_BusinessLogic.Entity.Manage
@model IEnumerable<MenuFooter>

@{
    Layout = "~/Views/Shared/Manage/_Layout_RHS.cshtml";

    string search = ViewBag.Search?.ToString() ?? "";
    int? Status = ViewBag.Status as int?;
    int curPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<h2>Footer Menu List</h2>

<form method="get" class="mb-3 d-flex align-items-start" id="searchForm" novalidate>

    <!-- Search -->
    <input type="text"
           name="search"
           id="search"
           value="@search"
           class="form-control w-25"
           placeholder="Search footer title..."
           maxlength="100" />

    <!-- Status Dropdown -->
    <select name="Status" class="form-select ms-2" style="width: 180px;">
        <option value="">All Status</option>
        <option value="2" selected="@(Status == 2)">Active</option>
        <option value="0" selected="@(Status == 0)">Inactive</option>
    </select>

    <button type="submit" class="btn btn-secondary ms-2">
        Search
    </button>

</form>

<a asp-action="AddFooter" class="btn btn-primary mb-3">
    Add New Footer
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Parent Footer</th>
            <th>Footer Type</th>
            <th>URL</th>
            <th>Sequence</th>
            <th>Status</th>
            <th>Created</th>
            <th width="250">Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FooterId</td>

                    <td>
                        @item.Title
                    </td>

                    <td>
                        @(string.IsNullOrEmpty(item.ParentFooterTitle)
                            ? "Main Footer"
                            : item.ParentFooterTitle)
                    </td>

                    <td>@item.FooterType</td>

                    <td>
                        @if (!string.IsNullOrEmpty(item.Url))
                        {
                            @item.Url
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>

                    <td>@item.Sequence</td>

                    <td>
                        @if (item.Status == 2)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>

                    <td>@item.CreatedDate.ToString("dd-MMM-yyyy")</td>

                    <td>
                        <a asp-action="EditFooter"
                           asp-route-id="@CryptoEngine.Encrypt(item.FooterId.ToString())"
                           class="btn btn-sm btn-outline-secondary">
                            Edit
                        </a>

                        @if (item.Status == 2)
                        {
                            <a asp-action="DeactivateFooter"
                               asp-route-id="@CryptoEngine.Encrypt(item.FooterId.ToString())"
                               class="btn btn-sm btn-outline-danger js-confirm-deactivate">
                                Deactivate
                            </a>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9" class="text-center text-muted">
                    No footer records found.
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination -->
@if (totalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == curPage ? "active" : "")">
                    <a class="page-link"
                       href="@Url.Action("ListFooter", new
                       {
                           page = i,
                           search = search,
                           Status = Status
                       })">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <script src="~/Assets/scripts/menu_footer_index.js"></script>
}