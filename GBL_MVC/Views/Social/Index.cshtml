@using GBL_MVC.Helpers
@model GBL_BusinessLogic.Entity.CareersModel
@{
    ViewData["Title"] = Model?.Content?.ContTitle ?? "Social";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var content = Model?.Content;

    // Soft-template sequences on /sustainability/social
    // 1 This philosophy | 2 Empowerment principles | 3 Making A Difference | 4 Impact
    var philosophyList = Model?.Empowering_Growth_List ?? new List<GBL_BusinessLogic.Entity.ComponentModel>();
    var principlesList = Model?.Knowledge_Sharing_List ?? new List<GBL_BusinessLogic.Entity.ComponentModel>();
    var differenceList = Model?.Expanding_Horizons_List ?? new List<GBL_BusinessLogic.Entity.ComponentModel>();
    var impactList = Model?.Learning_Philosophy_List ?? new List<GBL_BusinessLogic.Entity.ComponentModel>();

    var philosophyMain = philosophyList.FirstOrDefault(x => x.IsBlock == 0) ?? philosophyList.FirstOrDefault();
    var principlesBlocks = principlesList.Where(x => x.IsBlock == 1).OrderBy(x => x.Sequence).ToList();
    if (principlesBlocks.Count == 0)
        principlesBlocks = principlesList.OrderBy(x => x.Sequence).Where(x => x.IsBlock != 0 || principlesList.All(y => y.IsBlock == 0)).ToList();
    if (principlesBlocks.Count == 0)
        principlesBlocks = principlesList.OrderBy(x => x.Sequence).ToList();

    var differenceMain = differenceList.FirstOrDefault(x => x.IsBlock == 0) ?? differenceList.FirstOrDefault();
    var impactMain = impactList.FirstOrDefault(x => x.IsBlock == 0);
    var impactBlocks = impactList.Where(x => x.IsBlock == 1).OrderBy(x => x.Sequence).ToList();
    if (impactBlocks.Count == 0)
        impactBlocks = impactList.Where(x => x != impactMain).OrderBy(x => x.Sequence).ToList();

    var pageIntro = FirstText(content?.Cont_intro, content?.Cont_hmpg_intro);
    var impactMid = Math.Max(1, (int)Math.Ceiling(impactBlocks.Count / 2.0));
}

@section head {
    <title>@(content?.cont_window_title)</title>
    <meta content="@(content?.cont_metatag)" name="keywords" />
    <meta content="@(content?.cont_metadesc)" name="description" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@(content?.ContTitle)" />
    <meta name="twitter:description" content="@(content?.cont_metadesc)" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Godavari Biorefineries" />
    <meta property="og:title" content="@(content?.ContTitle)" />
    <meta property="og:description" content="@(content?.cont_metadesc)" />
    <meta property="og:url" content="@(content?.CanonicalUrl)" />
    <meta property="og:image" content="@(content?.cont_meta_image)" />
    <link rel="canonical" href="@(content?.CanonicalUrl)" />
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Devanagari:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Assets/css/sustainability-intro.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Assets/css/swiper-bundle.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Assets/css/insidepage-style.css" asp-append-version="true" />
}

@if (content != null && content.ContId > 0)
{
    @await Html.PartialAsync("~/Views/CommonComponent/_page_banner.cshtml", content)
}

@if (HasText(pageIntro))
{
    <section class="relative overflow-hidden section-spacing page-intro-outer bg-gray">
        <div class="container">
            <div class="page-intro-inner intro-lg text-center">
                @Html.Raw(pageIntro)
            </div>
        </div>
    </section>
}

@* 1. This philosophy *@
@if (philosophyMain != null)
{
    var philosophyImage = FirstPath(philosophyMain.ComponentThumbnail, philosophyMain.ThumbnailImage, philosophyMain.Component_LHS_thumbnail);
    var philosophyAlt = FirstText(philosophyMain.ComponentThumbnailAltText, philosophyMain.ThumbnailAltText, philosophyMain.Title);
    var hasPhilosophyCopy = HasText(philosophyMain.Intro) || HasText(philosophyMain.Title);
    if (hasPhilosophyCopy || !string.IsNullOrWhiteSpace(philosophyImage))
    {
        <section class="social-belief left-right-section left-right-gray section-spacing">
            <div class="container">
                <div class="social-split">
                @if (!string.IsNullOrWhiteSpace(philosophyImage))
                {
                    <figure class="social-split__media parallax-wrap parallax-sticky" data-parallax-travel="5">
                        <img src="@philosophyImage" alt="@philosophyAlt" class="parallax-img">
                    </figure>
                }
                @if (hasPhilosophyCopy)
                {
                    <div class="social-split__copy">
                        @if (HasText(philosophyMain.Intro))
                        {
                            @Html.Raw(philosophyMain.Intro)
                        }
                        else
                        {
                            <p>@Html.Raw(philosophyMain.Title.CleanParagraphTags())</p>
                        }
                    </div>
                }
                </div>
            </div>
        </section>
    }
}

@* 2. Empowerment principles *@
@if (principlesBlocks.Count > 0)
{
    <section class="social-principles section-spacing">
        <div class="container">
            <div class="social-principles__grid card-list-items">
                @foreach (var item in principlesBlocks)
                {
                    if (!HasText(item.Title) && !HasText(item.Intro)) { continue; }
                    <article class="social-principles__card card-rise">
                        @if (HasText(item.Title))
                        {
                            <h3 class="text-h5">@Html.Raw(item.Title.CleanParagraphTags())</h3>
                        }
                        @if (HasText(item.Intro))
                        {
                            @Html.Raw(item.Intro)
                        }
                    </article>
                }
            </div>
        </div>
    </section>
}

@* 3. Making A Difference *@
@if (differenceMain != null)
{
    var differenceImage = FirstPath(differenceMain.ComponentThumbnail, differenceMain.ThumbnailImage, differenceMain.Component_LHS_thumbnail);
    var differenceAlt = FirstText(differenceMain.ComponentThumbnailAltText, differenceMain.ThumbnailAltText, differenceMain.Title);
    var hasDifferenceCopy = HasText(differenceMain.Title) || HasText(differenceMain.Intro);
    if (hasDifferenceCopy || !string.IsNullOrWhiteSpace(differenceImage))
    {
        <section class="social-difference left-right-section left-right-white section-spacing">
            <div class="container">
                <div class="social-split social-split--copy-first">
                @if (hasDifferenceCopy)
                {
                    <div class="social-split__copy">
                        @if (HasText(differenceMain.Title))
                        {
                            <h2 class="text-h2">@Html.Raw(differenceMain.Title.CleanParagraphTags())</h2>
                        }
                        @if (HasText(differenceMain.Intro))
                        {
                            @Html.Raw(differenceMain.Intro)
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(differenceImage))
                {
                    <figure class="social-split__media parallax-wrap parallax-sticky" data-parallax-travel="5">
                        <img src="@differenceImage" alt="@differenceAlt" class="parallax-img">
                    </figure>
                }
                </div>
            </div>
        </section>
    }
}

@* 4. Impact *@
@if (impactMain != null || impactBlocks.Count > 0)
{
    var impactTitle = FirstText(impactMain?.Title, "Impact");
    var learnUrl = impactMain?.Url;
    var learnText = FirstText(impactMain?.Url_Text, "Learn more");

    <section class="social-impact section-spacing">
        <div class="container">
            <div class="social-impact__head">
                <h2 class="text-h2">@Html.Raw(impactTitle.CleanParagraphTags())</h2>
                @if (!string.IsNullOrWhiteSpace(learnUrl))
                {
                    <a href="@learnUrl" class="site-btn site-btn--outline">
                        <span class="site-btn__label">@learnText</span>
                        <span class="site-btn__arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                    </a>
                }
            </div>

            @if (impactBlocks.Count > 0)
            {
                <div class="social-impact__tiles" data-counter-deferred>
                    <div class="social-impact__row social-impact__row--offset">
                        @for (var i = 0; i < impactBlocks.Count && i < impactMid; i++)
                        {
                            @await Html.PartialAsync("~/Views/Social/_ImpactTile.cshtml", impactBlocks[i])
                        }
                    </div>
                    @if (impactBlocks.Count > impactMid)
                    {
                        <div class="social-impact__row">
                            @for (var i = impactMid; i < impactBlocks.Count; i++)
                            {
                                @await Html.PartialAsync("~/Views/Social/_ImpactTile.cshtml", impactBlocks[i])
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

@section Scripts {
    <script src="~/Assets/js/swiper-bundle.min.js" asp-append-version="true"></script>
    <script src="~/Assets/js/sustainability-intro.js" asp-append-version="true"></script>
    <script src="~/Assets/js/odometer-counter-script.js" asp-append-version="true"></script>
    <script src="~/Assets/js/card-animation.js" asp-append-version="true"></script>
    <script src="~/Assets/js/social-impact-animation.js" asp-append-version="true"></script>
    <script src="~/Assets/js/social-impact-counter.js" asp-append-version="true"></script>
}

@functions {
    private static bool HasText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        var plain = System.Text.RegularExpressions.Regex.Replace(value, "<[^>]+>", " ").Trim();
        return !string.IsNullOrWhiteSpace(plain);
    }

    private static string FirstText(params string?[] values)
    {
        foreach (var value in values)
        {
            if (!string.IsNullOrWhiteSpace(value)) return value;
        }
        return "";
    }

    private static string FirstPath(params string?[] values) => FirstText(values);
}
