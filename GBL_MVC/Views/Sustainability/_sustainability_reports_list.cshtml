@using GBL_MVC.Helpers
@model List<GBL_BusinessLogic.Entity.ArticleModel>



@foreach (var item in Model)
{
    <li class="sustainabilityReportsList__card card-rise">
        @if (!string.IsNullOrWhiteSpace(item.ThumbnailImage))
        {
            <div class="sustainabilityReportsList__media parallax-wrap">
                <img src="@item.ThumbnailImage" alt="@item.ThumbnailAltText" class="parallax-img">
            </div>
        }

        <div class="sustainabilityReportsList__meta">
            <p class="sustainabilityReportsList__title">
                @item.Title
            </p>

            <a href="@item.Url" class="sustainabilityReportsList__download" target="_blank" rel="noopener noreferrer"
               aria-label="Download Sustainability Report">

                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 4v11M7.5 11.5 12 16l4.5-4.5M6 20h12" stroke="currentColor" stroke-width="1.8"
                          stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </a>
        </div>
    </li>
}