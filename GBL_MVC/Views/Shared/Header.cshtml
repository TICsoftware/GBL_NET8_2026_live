@using GBL_BusinessLogic.Entity
@using GBL_MVC.Helpers
@model List<MenuHeader>

@{
  var menus = Model?.ToList() ?? new List<MenuHeader>();

  var headerLogo = menus.FirstOrDefault(x => x.MenuCategory == 1);

  var topMenus = menus
      .Where(x => x.ParentMenuId == null && x.MenuCategory == 2)
      .OrderBy(x => x.Sequence)
      .ToList();

  var parentMenus = menus
      .Where(x => x.ParentMenuId == null && x.MenuCategory == 3)
      .OrderBy(x => x.Sequence)
      .ToList();

  var isHomePage =
      ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
      ViewContext.RouteData.Values["action"]?.ToString() == "Index";
}

<header class="site-header @(isHomePage ? "site-header--home is-dark" : "site-header--inner is-dark")" id="header"
        data-theme="@(isHomePage ? "home" : "inner")">

  <div class="site-header__backdrop" data-header-backdrop></div>

  <div class="site-header__bar">
    <div class="container site-header__inner">

      @* Company Logo *@
      <a class="site-header__logo site-header__logo--gbl" href="@(headerLogo?.Url ?? Url.Action("Index", "Home"))"
         aria-label="@(headerLogo?.MenuName ?? "Godavari Biorefineries Ltd — Home")">

        <img src="@(headerLogo?.FeatureImage ?? Url.Content("~/Assets/images/logo/gbl-logo.svg"))"
             alt="@(headerLogo?.MenuName ?? "Godavari Biorefineries Ltd")" width="110" height="178">
      </a>

      <div class="site-header__nav-wrap" id="siteHeaderNav">

        <span class="mega-menu__caret" data-mega-caret aria-hidden="true"></span>

        @* Utility Menu *@
        <div class="site-header__utility">

          <ul class="site-header__utility-list">

            @foreach (var menu in topMenus)
            {
              <li>
                <a href="@(menu.Url ?? "#")" target="@(menu.Target ?? "_self")"
                   rel="@(menu.Target == "_blank" ? "noopener noreferrer" : null)">
                  @menu.MenuName
                </a>
              </li>
            }

          </ul>

          <div class="site-header__tools">

            @* Search *@
            <div class="site-header__search-wrap">

              <button type="button" class="site-header__search-btn" data-search-toggle aria-label="Open search" aria-expanded="false" aria-controls="headerSearch">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6"/>
                  <path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </button>

              <div class="site-header__search" id="headerSearch" hidden>
                <form class="site-header__search-form" action="/search/" method="get" role="search">
                  <label class="sr-only" for="headerSearchInput">Search</label>
                  <div class="site-header__search-field">
                    <span class="site-header__search-icon" aria-hidden="true">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6"/>
                        <path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                      </svg>
                    </span>
                    <input type="search" id="headerSearchInput" name="q" class="site-header__search-input" placeholder="What are you looking for?" autocomplete="off">
                    <button type="submit" class="site-header__search-submit">Search</button>
                    <button type="button" class="site-header__search-close" data-search-close aria-label="Close search">
                      <span aria-hidden="true">&times;</span>
                    </button>
                  </div>
                </form>
              </div>

            </div>

            @* Mobile Toggle *@
            <button type="button" class="site-header__toggle" data-nav-toggle aria-label="Open menu"
                    aria-expanded="false" aria-controls="siteHeaderNav">

              <span></span>
              <span></span>
              <span></span>

            </button>

          </div>

        </div>

        @* Primary Navigation *@
        <nav class="site-header__nav" aria-label="Primary">

          <ul class="site-header__primary">

            @foreach (var parent in parentMenus)
            {
                var children = menus
                    .Where(x => x.ParentMenuId == parent.MenuId)
                    .OrderBy(x => x.Sequence)
                    .ToList();


                var menuKey = System.Text.RegularExpressions.Regex.Replace(
                    (parent.MenuName ?? "").Trim().ToLowerInvariant()
                        .Replace("&", "and")
                        .Replace("/", "-"),
                    @"[\s-]+", "-"
                );

                if (string.IsNullOrWhiteSpace(menuKey))
                {
                    menuKey = $"menu-{parent.MenuId}";
                }

                var menuId = $"mega-{menuKey}";

                var hasMegaMenu = string.Equals(
                    parent.MenuType?.Trim(),
                    "MegaMenu",
                    StringComparison.OrdinalIgnoreCase
                );

              <li class="site-header__item" data-nav-item>

                <a href="@(hasMegaMenu ? "#" : (parent.Url ?? "#"))"
                  class="site-header__link"
                  data-mega-trigger="@(hasMegaMenu ? menuKey : "")"
                  aria-haspopup="@(hasMegaMenu ? "true" : "false")"
                  aria-expanded="false"
                  aria-controls="@menuId"
                  target="@parent.Target">

                    @parent.MenuName

                    @if (hasMegaMenu)
                    {
                        <span class="site-header__caret" aria-hidden="true"></span>
                    }
                </a>

                @* Mega Menu *@
                @if (hasMegaMenu)
                {
                  <div class="mega-menu" id="@menuId" data-mega="@menuKey" hidden>

                    <div class="mega-menu__grid">

                      @* Second-Level Menus *@
                      <div class="mega-menu__col mega-menu__col--l2">

                                          
                    <ul class="mega-l2">

                        @foreach (var child in children)
                        {
                            var subChildren = menus
                                .Where(x => x.ParentMenuId == child.MenuId)
                                .OrderBy(x => x.Sequence)
                                .ToList();

                            var panelId = $"panel-{child.MenuId}";

                            <li>

                                <a href="@(subChildren.Any() ? "#" : (child.Url ?? "#"))"
                                  class="mega-l2__item"
                                  data-l2
                                  @if (subChildren.Any())
                                  {
                                      <text>data-panel="@panelId" aria-expanded="false"</text>
                                  }
                                  target="@(subChildren.Any() ? null : (child.Target ?? "_self"))"
                                  rel="@(child.Target == "_blank" && !subChildren.Any() ? "noopener noreferrer" : null)">

                                    @child.MenuName

                                    @if (subChildren.Any())
                                    {
                                        <span class="mega-chevron" aria-hidden="true"></span>
                                    }

                                </a>

                                @* Third-Level Menus *@
                                @if (subChildren.Any())
                                {
                                    <div class="mega-l3-panel"
                                        data-panel="@panelId"
                                        hidden>

                                        @foreach (var subChild in subChildren)
                                        {
                                            var thirdLevelChildren = menus
                                                .Where(x => x.ParentMenuId == subChild.MenuId)
                                                .OrderBy(x => x.Sequence)
                                                .ToList();

                                            <div class="mega-l3-item">

                                                <a href="@(thirdLevelChildren.Any() ? "#" : (subChild.Url ?? "#"))"
                                                  class="mega-l3"
                                                  @if (thirdLevelChildren.Any())
                                                  {
                                                      <text>data-l3 data-panel="panel-@subChild.MenuId" aria-expanded="false"</text>
                                                  }
                                                  target="@(thirdLevelChildren.Any() ? null : (subChild.Target ?? "_self"))"
                                                  rel="@(subChild.Target == "_blank" && !thirdLevelChildren.Any() ? "noopener noreferrer" : null)">

                                                    @subChild.MenuName

                                                    @if (thirdLevelChildren.Any())
                                                    {
                                                        <span class="mega-chevron" aria-hidden="true"></span>
                                                    }

                                                </a>

                                                @* Fourth-Level Menus *@
                                                @if (thirdLevelChildren.Any())
                                                {
                                                    <div class="mega-l3-children"
                                                        data-panel="panel-@subChild.MenuId"
                                                        hidden>

                                                        @foreach (var thirdChild in thirdLevelChildren)
                                                        {
                                                            <a href="@(thirdChild.Url ?? "#")"
                                                              class="mega-l3"
                                                              target="@(thirdChild.Target ?? "_self")"
                                                              rel="@(thirdChild.Target == "_blank" ? "noopener noreferrer" : null)">

                                                                @thirdChild.MenuName

                                                            </a>
                                                        }

                                                    </div>
                                                }

                                            </div>
                                        }

                                    </div>
                                }

                            </li>
                        }

                    </ul>


                      </div>

                      @* Feature Card *@
                      @if (!string.IsNullOrWhiteSpace(parent.FeatureImage)
                          || !string.IsNullOrWhiteSpace(parent.FeatureTitle)
                          || !string.IsNullOrWhiteSpace(parent.FeatureDescription)
                          || !string.IsNullOrWhiteSpace(parent.FeatureButtonText))
                      {
                        <div class="mega-menu__col mega-menu__col--feature">

                          <article class="mega-featured">

                            @if (!string.IsNullOrWhiteSpace(parent.FeatureImage))
                            {
                              <div class="mega-featured__media">

                                <img src="@parent.FeatureImage" alt="@(parent.FeatureTitle ?? parent.MenuName ?? "")">

                              </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(parent.FeatureTitle))
                            {
                              <h3 class="mega-featured__title">
                                @parent.FeatureTitle
                              </h3>
                            }

                            @if (!string.IsNullOrWhiteSpace(parent.FeatureDescription))
                            {
                              <div class="mega-featured__copy">
                                @Html.Raw(parent.FeatureDescription.CleanParagraphTags())
                              </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(parent.FeatureButtonText))
                            {
                              <a href="@(parent.FeatureButtonUrl ?? parent.Url ?? "#")" class="mega-featured__cta"
                                 target="@(parent.FeatureButtonTarget ?? "_self")"
                                 rel="@(parent.FeatureButtonTarget == "_blank" ? "noopener noreferrer" : null)">

                                <span aria-hidden="true">&rarr;</span>

                                @parent.FeatureButtonText

                              </a>
                            }

                          </article>

                        </div>
                      }

                    </div>

                  </div>
                }

              </li>
            }

          </ul>

        </nav>

      </div>

      @* Somaiya Group Logo *@
      <a class="site-header__logo site-header__logo--somaiya" href="https://www.somaiya.com/" target="_blank"
         rel="noopener noreferrer" aria-label="Somaiya Group (opens in a new tab)">

        <img src="@headerLogo.ThumbImage" alt="Somaiya Group" width="152" height="114">

      </a>

    </div>
  </div>

</header>
