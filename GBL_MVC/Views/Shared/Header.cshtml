@using GBL_BusinessLogic.Entity
@using GBL_MVC.Helpers
@model List<MenuHeader>

@{
  var menus = Model?.ToList() ?? new List<MenuHeader>();

  var headerLogo = menus.FirstOrDefault(x => x.MenuCategory == 1);

  var topMenus = menus
      .Where(x => x.ParentMenuId == null && x.MenuCategory == 2)
      .OrderBy(x => x.Sequence)
      .ToList();

  var parentMenus = menus
      .Where(x => x.ParentMenuId == null && x.MenuCategory == 3)
      .OrderBy(x => x.Sequence)
      .ToList();

  var isHomePage =
      ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
      ViewContext.RouteData.Values["action"]?.ToString() == "Index";
}

@functions {
  private static List<(string Name, string Url)> UtilityFallbackLinks(string? menuName)
  {
    var name = (menuName ?? "").Trim().ToLowerInvariant();

    if (name.Contains("media"))
    {
      return new()
      {
        ("Press Releases", "/media/press-release"),
        ("Media Coverage", "/media/media-coverage")
      };
    }

    if (name.Contains("career"))
    {
      return new()
      {
        ("Work With Us", "/careers/work-with-us"),
        ("Learning & Development", "/careers/learning-and-development"),
        ("Diversity & Inclusion", "/careers/diversity-and-inclusion"),
        ("Wellbeing & Benefits", "/careers/wellbeing-and-benefits")
      };
    }

    if (name.Contains("contact"))
    {
      return new()
      {
        ("Registered and Corporate Office", "/contact-us#registered-office"),
        ("Marketing Office", "/contact-us#marketing-office"),
        ("Products", "/contact-us#products"),
        ("India Offices", "/contact-us#india-offices"),
        ("International Offices", "/contact-us#international-offices"),
        ("Submit your query", "/contact-us#submit-query")
      };
    }

    return new();
  }

  private bool UtilityLinkIsCurrent(string? url)
  {
    if (string.IsNullOrWhiteSpace(url) || url == "#") return false;
    var hashAt = url.IndexOf('#');
    if (hashAt >= 0) return false;

    var path = url;
    if (path.StartsWith("http", StringComparison.OrdinalIgnoreCase))
    {
      if (!Uri.TryCreate(path, UriKind.Absolute, out var absolute)) return false;
      path = absolute.AbsolutePath;
    }

    path = path.Trim().TrimEnd('/').ToLowerInvariant();
    if (string.IsNullOrEmpty(path)) path = "/";

    var requestPath = (Context.Request.Path.Value ?? "/").Trim().TrimEnd('/').ToLowerInvariant();
    if (string.IsNullOrEmpty(requestPath)) requestPath = "/";
    return path == requestPath;
  }
}

<header class="site-header @(isHomePage ? "site-header--home is-dark" : "site-header--inner is-dark")" id="header"
        data-theme="@(isHomePage ? "home" : "inner")">

  <div class="site-header__backdrop" data-header-backdrop></div>

  <div class="site-header__bar">
    <div class="container site-header__inner">

      @* Company Logo *@
      <a class="site-header__logo site-header__logo--gbl" href="@(headerLogo?.Url ?? Url.Action("Index", "Home"))"
         aria-label="@(headerLogo?.MenuName ?? "Godavari Biorefineries Ltd — Home")">

        <img src="@(headerLogo?.FeatureImage ?? Url.Content("~/Assets/images/logo/gbl-logo.svg"))"
             alt="@(headerLogo?.MenuName ?? "Godavari Biorefineries Ltd")" width="110" height="178">
      </a>

      <div class="site-header__nav-wrap" id="siteHeaderNav">

        <span class="mega-menu__caret" data-mega-caret aria-hidden="true"></span>
        <span class="mega-menu__pill" aria-hidden="true"></span>

        @* Utility Menu *@
        <div class="site-header__utility">

          <ul class="site-header__utility-list">

            @foreach (var menu in topMenus)
            {
              var utilityChildren = menus
                  .Where(x => x.ParentMenuId == menu.MenuId)
                  .OrderBy(x => x.Sequence)
                  .ToList();
              var utilityLinks = new List<(string Name, string Url, string Target)>();
              var seenUtilityUrls = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
              string UtilityUrlKey(string url) => (url ?? "").Trim().TrimEnd('/').ToLowerInvariant();
              foreach (var child in utilityChildren)
              {
                var childUrl = string.IsNullOrWhiteSpace(child.Url) ? "#" : child.Url.Trim();
                seenUtilityUrls.Add(UtilityUrlKey(childUrl));
                utilityLinks.Add((child.MenuName ?? "", childUrl, child.Target ?? "_self"));
              }
              foreach (var extra in UtilityFallbackLinks(menu.MenuName))
              {
                if (!seenUtilityUrls.Add(UtilityUrlKey(extra.Url))) continue;
                utilityLinks.Add((extra.Name, extra.Url, "_self"));
              }
              var hasUtilityDropdown = utilityLinks.Any();
              var utilityAlignEnd = menu == topMenus.Last();
              var utilityIsCurrent = UtilityLinkIsCurrent(menu.Url) || utilityLinks.Any(link => UtilityLinkIsCurrent(link.Url));

              <li class="@((hasUtilityDropdown ? "site-header__media-item" : "") + (utilityIsCurrent ? " is-current" : null))">
                <a href="@(menu.Url ?? "#")" target="@(menu.Target ?? "_self")"
                   rel="@(menu.Target == "_blank" ? "noopener noreferrer" : null)"
                   aria-haspopup="@(hasUtilityDropdown ? "true" : null)"
                   aria-expanded="@(hasUtilityDropdown ? "false" : null)">
                  @menu.MenuName
                  @if (hasUtilityDropdown)
                  {
                    <span class="site-header__caret" aria-hidden="true"></span>
                  }
                </a>
                @if (hasUtilityDropdown)
                {
                  <ul class="site-header__media-dd@(utilityAlignEnd ? " site-header__media-dd--end" : null)">
                    @foreach (var child in utilityLinks)
                    {
                      var childIsCurrent = UtilityLinkIsCurrent(child.Url);
                      <li>
                        <a href="@child.Url" target="@child.Target"
                           class="@(childIsCurrent ? "is-active" : null)"
                           aria-current="@(childIsCurrent ? "page" : null)"
                           rel="@(child.Target == "_blank" ? "noopener noreferrer" : null)">
                          @child.Name
                        </a>
                      </li>
                    }
                  </ul>
                }
              </li>
            }

          </ul>

          <div class="site-header__tools">

            @* Search *@
            <div class="site-header__search-wrap">

              <button type="button" class="site-header__search-btn" data-search-toggle aria-label="Open search" aria-expanded="false" aria-controls="searchOverlay">
                <svg class="site-header__search-ico site-header__search-ico--open" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="2.2"/>
                  <path d="M16.2 16.2L21 21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                </svg>
                <svg class="site-header__search-ico site-header__search-ico--close" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
                </svg>
              </button>

            </div>

            @* Mobile Toggle *@
            <button type="button" class="site-header__toggle" data-nav-toggle aria-label="Open menu"
                    aria-expanded="false" aria-controls="siteHeaderNav">

              <span></span>
              <span></span>
              <span></span>

            </button>

          </div>

        </div>

        @* Primary Navigation *@
        <nav class="site-header__nav" aria-label="Primary">

          <ul class="site-header__primary">

            @foreach (var parent in parentMenus)
            {
                var children = menus
                    .Where(x => x.ParentMenuId == parent.MenuId)
                    .OrderBy(x => x.Sequence)
                    .ToList();


                var menuKey = System.Text.RegularExpressions.Regex.Replace(
                    (parent.MenuName ?? "").Trim().ToLowerInvariant()
                        .Replace("&", "and")
                        .Replace("/", "-"),
                    @"[\s-]+", "-"
                );

                if (string.IsNullOrWhiteSpace(menuKey))
                {
                    menuKey = $"menu-{parent.MenuId}";
                }

                var menuId = $"mega-{menuKey}";

                var hasMegaMenu = string.Equals(
                    parent.MenuType?.Trim(),
                    "MegaMenu",
                    StringComparison.OrdinalIgnoreCase
                );

              <li class="site-header__item" data-nav-item>

                <a href="@(hasMegaMenu ? "#" : (parent.Url ?? "#"))"
                  class="site-header__link"
                  data-mega-trigger="@(hasMegaMenu ? menuKey : "")"
                  aria-haspopup="@(hasMegaMenu ? "true" : "false")"
                  aria-expanded="false"
                  aria-controls="@menuId"
                  target="@parent.Target">

                    @parent.MenuName

                    @if (hasMegaMenu)
                    {
                        <span class="site-header__caret" aria-hidden="true"></span>
                    }
                </a>

                @* Mega Menu *@
                @if (hasMegaMenu)
                {
                  <div class="mega-menu mega-menu--list" id="@menuId" data-mega="@menuKey" hidden>

                    <div class="mega-menu__grid">

                      @* Second-Level Menus *@
                      <div class="mega-menu__col mega-menu__col--l2">

                                          
                    <ul class="mega-l2">

                        @* "Overview" = link to the top menu item's own page ("#" until that page has a URL
                           in the CMS). Skipped if the CMS already has a 2nd-level "Overview" item. *@
                        @if (!children.Any(c => string.Equals(c.MenuName?.Trim(), "Overview", StringComparison.OrdinalIgnoreCase)))
                        {
                            var overviewUrl = string.IsNullOrWhiteSpace(parent.Url) ? "#" : parent.Url.Trim();
                            <li>
                                <a href="@overviewUrl"
                                   class="mega-l2__item mega-l2__item--overview"
                                   data-l2
                                   target="@(parent.Target ?? "_self")"
                                   rel="@(parent.Target == "_blank" ? "noopener noreferrer" : null)">
                                    Overview
                                </a>
                            </li>
                        }

                        @foreach (var child in children)
                        {
                            var subChildren = menus
                                .Where(x => x.ParentMenuId == child.MenuId)
                                .OrderBy(x => x.Sequence)
                                .ToList();

                            var panelId = $"panel-{child.MenuId}";

                            @* Items with a submenu still link to their own page when the CMS has a URL:
                               desktop click goes there (hover opens the submenu); on mobile a tap opens
                               the submenu, whose "Overview" link below goes to the page. *@
                            var childUrl = string.IsNullOrWhiteSpace(child.Url) ? "#" : child.Url.Trim();

                            <li>

                                <a href="@childUrl"
                                  class="mega-l2__item"
                                  data-l2
                                  @if (subChildren.Any())
                                  {
                                      <text>data-panel="@panelId" aria-expanded="false"</text>
                                  }
                                  target="@(childUrl == "#" ? null : (child.Target ?? "_self"))"
                                  rel="@(child.Target == "_blank" && childUrl != "#" ? "noopener noreferrer" : null)">

                                    @child.MenuName

                                    @if (subChildren.Any())
                                    {
                                        <span class="mega-chevron" aria-hidden="true"></span>
                                    }

                                </a>

                                @* Third-Level Menus *@
                                @if (subChildren.Any())
                                {
                                    <div class="mega-l3-panel"
                                        data-panel="@panelId"
                                        data-title="@(string.Equals(child.MenuName?.Trim(), "Overview", StringComparison.OrdinalIgnoreCase) ? (parent.MenuName ?? child.MenuName) : child.MenuName)"
                                        hidden>

                                        @* Mobile only (hidden on desktop in header-footer.css): the parent's own page *@
                                        @if (childUrl != "#")
                                        {
                                            <div class="mega-l3-item mega-l3-item--overview">
                                                <a href="@childUrl"
                                                  class="mega-l3"
                                                  target="@(child.Target ?? "_self")"
                                                  rel="@(child.Target == "_blank" ? "noopener noreferrer" : null)">
                                                    Overview
                                                </a>
                                            </div>
                                        }

                                        @foreach (var subChild in subChildren)
                                        {
                                            var thirdLevelChildren = menus
                                                .Where(x => x.ParentMenuId == subChild.MenuId)
                                                .OrderBy(x => x.Sequence)
                                                .ToList();

                                            <div class="mega-l3-item">

                                                <a href="@(thirdLevelChildren.Any() ? "#" : (subChild.Url ?? "#"))"
                                                  class="mega-l3"
                                                  @if (thirdLevelChildren.Any())
                                                  {
                                                      <text>data-l3 data-panel="panel-@subChild.MenuId" aria-expanded="false"</text>
                                                  }
                                                  target="@(thirdLevelChildren.Any() ? null : (subChild.Target ?? "_self"))"
                                                  rel="@(subChild.Target == "_blank" && !thirdLevelChildren.Any() ? "noopener noreferrer" : null)">

                                                    @subChild.MenuName

                                                    @if (thirdLevelChildren.Any())
                                                    {
                                                        <span class="mega-chevron" aria-hidden="true"></span>
                                                    }

                                                </a>

                                                @* Fourth-Level Menus *@
                                                @if (thirdLevelChildren.Any())
                                                {
                                                    <div class="mega-l3-children"
                                                        data-panel="panel-@subChild.MenuId"
                                                        hidden>

                                                        @foreach (var thirdChild in thirdLevelChildren)
                                                        {
                                                            <a href="@(thirdChild.Url ?? "#")"
                                                              class="mega-l3"
                                                              target="@(thirdChild.Target ?? "_self")"
                                                              rel="@(thirdChild.Target == "_blank" ? "noopener noreferrer" : null)">

                                                                @thirdChild.MenuName

                                                            </a>
                                                        }

                                                    </div>
                                                }

                                            </div>
                                        }

                                    </div>
                                }

                            </li>
                        }

                    </ul>


                      </div>

                      @* Feature Card *@
                      @{
                        var featureImage = parent.FeatureImage;
                        // Business mega menu: use a fallback image when CMS has no FeatureImage.
                        if (string.IsNullOrWhiteSpace(featureImage)
                            && !string.IsNullOrWhiteSpace(parent.MenuName)
                            && parent.MenuName.Contains("Business", StringComparison.OrdinalIgnoreCase))
                        {
                            featureImage = Url.Content("~/Assets/images/banners/business-banner.webp");
                        }
                      }
                      @if (!string.IsNullOrWhiteSpace(featureImage)
                          || !string.IsNullOrWhiteSpace(parent.FeatureTitle)
                          || !string.IsNullOrWhiteSpace(parent.FeatureDescription)
                          || !string.IsNullOrWhiteSpace(parent.FeatureButtonText))
                      {
                        <div class="mega-menu__col mega-menu__col--feature">

                          <article class="mega-featured">

                            @if (!string.IsNullOrWhiteSpace(featureImage))
                            {
                              <div class="mega-featured__media">

                                <img src="@featureImage" alt="@(parent.FeatureTitle ?? parent.MenuName ?? "")">

                              </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(parent.FeatureTitle))
                            {
                              <h3 class="mega-featured__title">
                                @parent.FeatureTitle
                              </h3>
                            }

                            @if (!string.IsNullOrWhiteSpace(parent.FeatureDescription))
                            {
                              <div class="mega-featured__copy">
                                @Html.Raw(parent.FeatureDescription.CleanParagraphTags())
                              </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(parent.FeatureButtonText))
                            {
                              <a href="@(parent.FeatureButtonUrl ?? parent.Url ?? "#")" class="site-btn site-btn--line mega-featured__cta"
                                 target="@(parent.FeatureButtonTarget ?? "_self")"
                                 rel="@(parent.FeatureButtonTarget == "_blank" ? "noopener noreferrer" : null)">

                                <span class="site-btn__label">@parent.FeatureButtonText</span>
                                <span class="site-btn__arrow" aria-hidden="true">
                                  <svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </span>

                              </a>
                            }

                          </article>

                        </div>
                      }

                    </div>

                  </div>
                }

              </li>
            }

          </ul>

        </nav>

      </div>

      @* Somaiya Group Logo *@
      <a class="site-header__logo site-header__logo--somaiya" href="https://www.somaiya.com/" target="_blank"
         rel="noopener noreferrer" aria-label="Somaiya Group (opens in a new tab)">

        <img src="@headerLogo.ThumbImage" alt="Somaiya Group" width="152" height="114">

      </a>

    </div>
  </div>

</header>

<partial name="_SearchOverlay" />
