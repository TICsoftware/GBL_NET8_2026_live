<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  @{
    var nonce = Context.Items["CSPNonce"]?.ToString();
  }

  @* Critical preloader head first — before fonts/CSS so gray cover + pending class paint ASAP *@
  @RenderSection("head", required: false)

  <!-- ✅ Favicon -->
  <link rel="icon" href="~/Assets/images/favicon/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="~/Assets/images/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="~/Assets/images/favicon/favicon-16x16.png">
  <!-- Apple -->
  <link rel="apple-touch-icon" href="~/Assets/images/favicon/apple-touch-icon.png">
  <!-- Android -->
  <link rel="icon" type="image/png" sizes="192x192" href="~/Assets/images/favicon/android-chrome-192x192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="~/Assets/images/favicon/android-chrome-512x512.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
    rel="stylesheet">

  <link rel="preload" href="~/dist/site.css" as="style" onload="this.onload=null;this.rel='stylesheet'"
    asp-append-version="true">
  <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />

  <link rel="preload" href="~/Assets/css/header-footer.css" as="style" asp-append-version="true">
  <link rel="stylesheet" href="~/Assets/css/header-footer.css" asp-append-version="true">

  <link rel="preload" href="~/Assets/css/common-style.css" as="style" asp-append-version="true">
  <link rel="stylesheet" href="~/Assets/css/common-style.css" asp-append-version="true">
  <link rel="stylesheet" href="~/Assets/css/cookie-style.css" asp-append-version="true" />



  @RenderSection("Styles", required: false)
  <meta name="google-site-verification" content="6RVbp82VCE9-6QlK8FGCkTjLNqzOPLPT-yICBfMxHWw" />
</head>

<body>

  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K2XDZW5Z" height="0" width="0"
      style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->


  @{
    var isHomePage =
    ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
    ViewContext.RouteData.Values["action"]?.ToString() == "Index";

    string ReadLoaderSvg(string relativePath, bool stripFills = true)
    {
      try
      {
        var env = Context.RequestServices.GetService(typeof(Microsoft.AspNetCore.Hosting.IWebHostEnvironment))
          as Microsoft.AspNetCore.Hosting.IWebHostEnvironment;
        if (env == null) return string.Empty;
        var full = System.IO.Path.Combine(env.WebRootPath, relativePath.Replace('/', System.IO.Path.DirectorySeparatorChar));
        if (!System.IO.File.Exists(full)) return string.Empty;
        var text = System.IO.File.ReadAllText(full);
        // Lion is stroke-drawn; strip fill so first paint is outline-only.
        // Wordmark stays fully colored from first paint.
        if (stripFills)
        {
          text = System.Text.RegularExpressions.Regex.Replace(
            text,
            @"fill=""(#(ED1C24|231F20))""",
            @"fill=""none"" data-orig-fill=""$1""",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        }
        return text;
      }
      catch
      {
        return string.Empty;
      }
    }

    var lionSvgInline = isHomePage ? ReadLoaderSvg("Assets/images/logo/lion-vector-loader.svg") : string.Empty;
    var wordmarkSvgInline = isHomePage ? ReadLoaderSvg("Assets/images/logo/logo-vector-loader.svg", stripFills: false) : string.Empty;
  }

  @if (isHomePage)
  {
    @* Preloader — SVGs inlined so progress + lion are visible on first paint (no blank wait). *@
    <div id="sitePreloader" class="site-preloader" aria-hidden="true"
         style="position:fixed;inset:0;z-index:10500;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:28px;background:#f5f5f5;">
      <div class="site-preloader__logo-wrap" style="width:100%;max-width:min(42vw,650px);line-height:0;">
        <div id="sitePreloaderLogo"
             class="site-preloader__logo"
             role="img"
             aria-label="Priya Cement"
             data-svg-src="@Url.Content("~/Assets/images/logo/lion-vector-loader.svg")">@Html.Raw(lionSvgInline)</div>
      </div>
      <div id="sitePreloaderWordmark"
           class="site-preloader__wordmark"
           role="img"
           aria-label="Priya Cement"
           data-svg-src="@Url.Content("~/Assets/images/logo/logo-vector-loader.svg")"
           style="width:100%;max-width:min(42vw,240px);line-height:0;">@Html.Raw(wordmarkSvgInline)</div>
      <div class="site-preloader__progress" style="display:flex;flex-direction:column;align-items:center;gap:10px;width:200px;max-width:60vw;">
        <div class="site-preloader__bar" style="width:100%;height:3px;border-radius:999px;background:rgba(0,0,0,.12);overflow:hidden;">
          <span class="site-preloader__bar-fill" id="sitePreloaderFill" style="display:block;height:100%;width:0%;background:#ed1c24;"></span>
        </div>
        <div class="site-preloader__counter" id="sitePreloaderCounter" style="font-family:Poppins,sans-serif;font-size:13px;letter-spacing:.08em;color:rgba(0,0,0,.65);">0<span>%</span></div>
      </div>
    </div>
    @* Run immediately after preloader markup — do not wait for full page / bottom scripts *@
    <script src="~/Assets/js/homepage-preloader.js" asp-append-version="true"></script>
  }

  @* @Html.Partial("~/Views/Shared/_Header.cshtml") *@
  @await Component.InvokeAsync("HeaderMenu")


  <main id="main-content">
    @RenderBody()

    @* @Html.Partial("~/Views/Shared/_Footer.cshtml") *@
    @await Component.InvokeAsync("FooterMenu")

  </main>



  <!-- Back to top -->
  <button type="button" class="back-to-top fixed bottom-3 right-5 w-8 h-8 sm:w-10 sm:h-10 rounded-full
                     bg-black/70 text-white flex items-center justify-center
                     cursor-pointer z-50 opacity-0 pointer-events-none
                     transition-all duration-300" aria-label="Back to top" aria-hidden="true">

    <svg class="progress-ring absolute inset-0 w-full h-full -rotate-90 pointer-events-none" viewBox="0 0 100 100"
      preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <circle class="progress-ring-track" cx="50" cy="50" r="45" stroke="rgba(255,255,255,0.2)" stroke-width="6"
        fill="transparent" />
      <circle class="progress-ring-circle" cx="50" cy="50" r="45" stroke="#ED1C24" stroke-width="6" fill="transparent"
        stroke-linecap="round" />
    </svg>

    <span class="relative z-10 flex items-center justify-center" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M12 19V5M12 5L6 11M12 5L18 11" stroke="white" stroke-width="2" stroke-linecap="round" />
      </svg>
    </span>
  </button>




  <!-- COOKIE POLICY -->
  <div class="privacy_policy_botm" id="popup-privacypolicy">
    <div class="container">
      <div class="privacy_policy_bg">
        <p>We use cookies to enhance your browsing experience. By continuing to use our website you agree to our
          policies.</p>
        <div class="privacy_btn">
          <div class="privacy_close transition_all_4s hvr-shutter-out-horizontal acceptbtn" id="acceptCookie">Accept
          </div>
          <a href="/privacy-policy" class="transition_all_4s acceptbtn text-white hover:text-fontColorOne">Read the
            policy</a>
        </div>
      </div>
    </div>
  </div>
  <!-- COOKIE POLICY -->


  @* COMMON SCRIPT  *@
  <script src="~/Assets/js/jquery.min.js" asp-append-version="true"></script>
  <script src="~/Assets/js/gsap.min.js" asp-append-version="true"></script>
  <script src="~/Assets/js/ScrollTrigger.min.js" asp-append-version="true"></script>
  <script src="~/Assets/js/lenis.min.js" asp-append-version="true"></script>
  <script src="~/Assets/js/common-script.js" asp-append-version="true"></script>
  <script src="~/Assets/js/title-animation.js" asp-append-version="true"></script>
  <script defer type="text/javascript" src="~/Assets/js/cookie-script.js" asp-append-version="true"></script>
  <script src="~/scripts/Search/Search_Home.js" asp-append-version="true"></script>







  <!-- <script defer type="text/javascript" src="~/Assets/js/cookie-script.js"></script> -->
  @await RenderSectionAsync("Scripts", required: false)
</body>

</html>