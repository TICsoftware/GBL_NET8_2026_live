<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  @{
    var nonce = Context.Items["CSPNonce"]?.ToString();
  }

  <!-- ✅ Favicon -->
  <link rel="icon" href="~/Assets/images/favicon/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="~/Assets/images/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="~/Assets/images/favicon/favicon-16x16.png">
  <!-- Apple -->
  <link rel="apple-touch-icon" href="~/Assets/images/favicon/apple-touch-icon.png">
  <!-- Android -->
  <link rel="icon" type="image/png" sizes="192x192" href="~/Assets/images/favicon/android-chrome-192x192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="~/Assets/images/favicon/android-chrome-512x512.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Corinthia:wght@400;700&display=swap" rel="stylesheet">

  @RenderSection("head", required: false)
  
  <link rel="preload" href="~/dist/site.css" as="style" onload="this.onload=null;this.rel='stylesheet'"
        asp-append-version="true">
  <link rel="stylesheet" href="~/dist/site.css" asp-append-version="true" />

  <link rel="preload" href="~/Assets/css/header-footer.css" as="style" asp-append-version="true">
  <link rel="stylesheet" href="~/Assets/css/header-footer.css" asp-append-version="true">
  
  <link rel="preload" href="~/Assets/css/common-style.css" as="style">
  <link rel="stylesheet" href="~/Assets/css/common-style.css">

  <link rel="preload" href="~/Assets/css/homepage-style.css" as="style">
  <link rel="stylesheet" href="~/Assets/css/homepage-style.css">

  @RenderSection("Styles", required: false)
  <script>
  window.markerConfig = {
    project: '6afd3dc97f9399612681c253', 
    source: 'snippet'
  };

  !function(e,r,a){if(!e.__Marker){e.__Marker={};var t=[],n={__cs:t};["show","hide","isVisible","capture","cancelCapture","unload","reload","isExtensionInstalled","setReporter","clearReporter","setCustomData","on","off"].forEach(function(e){n[e]=function(){var r=Array.prototype.slice.call(arguments);r.unshift(e),t.push(r)}}),e.Marker=n;var s=r.createElement("script");s.async=1,s.src="https://edge.marker.io/latest/shim.js";var i=r.getElementsByTagName("script")[0];i.parentNode.insertBefore(s,i)}}(window,document);
</script>
  <!-- Page loader -->
  <link rel="stylesheet" href="~/Assets/css/page-loader.css" asp-append-version="true">
  <script nonce="@nonce">document.documentElement.classList.add('gbl-lock');</script>

</head>

<body>

  
 <!-- Page loader -->
  <div id="gbl-loader" role="status" aria-label="Loading Godavari Biorefineries Ltd">
    <div class="gl-scene" aria-hidden="true"><img class="gl-sun" data-src="@Url.Content("~/Assets/images/loader/loader-sun.svg")" alt=""></div>
    <div class="gl-ground" aria-hidden="true"></div>
    <div class="gl-scene" aria-hidden="true"><img class="gl-cane" data-src="@Url.Content("~/Assets/images/loader/loader-cane.svg")" alt=""></div>
    <div class="gl-grid" aria-hidden="true">
      <div><div class="gl-counter"><span class="gl-count">00</span><span class="gl-total">/100</span></div></div>
      <div class="gl-stack">
        <div class="gl-item"><div class="gl-item-inner"><div class="gl-item-image"><img data-src="@Url.Content("~/Assets/images/homepage/banner/banner-img-4.webp")" alt=""></div></div></div>
        <div class="gl-item"><div class="gl-item-inner"><div class="gl-item-image"><img data-src="@Url.Content("~/Assets/images/homepage/banner/banner-img-5.webp")" alt=""></div></div></div>
        <div class="gl-item"><div class="gl-item-inner"><div class="gl-item-image"><img data-src="@Url.Content("~/Assets/images/homepage/banner/banner-img-8.webp")" alt=""></div></div></div>
        <div class="gl-item"><div class="gl-item-inner"><div class="gl-item-image"><img data-src="@Url.Content("~/Assets/images/homepage/banner/banner-img-9.webp")" alt=""></div></div></div>
        <div class="gl-item"><div class="gl-item-inner"><div class="gl-item-image"><img data-src="@Url.Content("~/Assets/images/homepage/banner/banner-img-6.webp")" alt=""></div></div></div>
      </div>
      <div></div>
    </div>
    <div class="gl-cover" aria-hidden="true"><img data-src="@Url.Content("~/Assets/images/homepage/banner/banner-img-1.webp")" alt=""></div>
  </div>
  <script src="~/Assets/js/page-loader.js" asp-append-version="true"></script>

  
  @{
    var isHomePage =
    ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
    ViewContext.RouteData.Values["action"]?.ToString() == "Index";
  }


  @* @Html.Partial("~/Views/Shared/_Header.cshtml") *@
   @await Component.InvokeAsync("HeaderMenu")
 
  <main id="main-content">
    @RenderBody()
        
    @* @Html.Partial("~/Views/Shared/_Footer.cshtml") *@
    @await Component.InvokeAsync("FooterMenu")
        
  </main>



  <!-- Back to top -->
  <button type="button" class="back-to-top fixed bottom-3 right-5 w-8 h-8 sm:w-10 sm:h-10 rounded-full
    bg-black/70 text-white flex items-center justify-center
    cursor-pointer z-50 opacity-0 pointer-events-none
    transition-all duration-300" aria-label="Back to top" aria-hidden="true">

    <svg class="progress-ring absolute inset-0 w-full h-full -rotate-90 pointer-events-none" viewBox="0 0 100 100"
         preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <circle class="progress-ring-track" cx="50" cy="50" r="45" stroke="rgba(255,255,255,0.2)" stroke-width="6"
              fill="transparent" />
      <circle class="progress-ring-circle" cx="50" cy="50" r="45" stroke="#ED1C24" stroke-width="6" fill="transparent"
              stroke-linecap="round" />
    </svg>

    <span class="relative z-10 flex items-center justify-center" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M12 19V5M12 5L6 11M12 5L18 11" stroke="white" stroke-width="2" stroke-linecap="round" />
      </svg>
    </span>
  </button>



  <!-- COOKIE POLICY -->
  <!-- <div class="privacy_policy_botm" id="popup-privacypolicy">
        <div class="container">
            <div class="privacy_policy_bg">
                <p>We use cookies on cop.com to enhance your browsing experience. By continuing to browse this site you are consenting to the use of cookies on this website.</p>
                <div class="privacy_btn">
                    <div class="privacy_close transition_all_4s hvr-shutter-out-horizontal acceptbtn" id="acceptCookie">Accept</div>
                    <a href="/legal-disclaimer" class="transition_all_4s acceptbtn text-white hover:text-fontColorOne">Read our legal disclaimer</a>
                </div>
            </div>
        </div>
    </div> -->
  <!-- COOKIE POLICY -->


  @* COMMON SCRIPT  *@
  <script src="~/Assets/js/jquery.min.js"></script>
  <script src="~/Assets/js/gsap.min.js"></script>
  <script src="~/Assets/js/ScrollTrigger.min.js"></script>
  <script src="~/Assets/js/lenis.min.js"></script>
  <script src="~/Assets/js/common-script.js"></script>
  <script src="~/Assets/js/header.js" asp-append-version="true"></script>
  <script src="~/Assets/js/text-animtion.js" asp-append-version="true"></script>
  <script src="~/Assets/js/title-animation.js" asp-append-version="true"></script>
  <script src="~/Assets/js/intro-text-fill.js" asp-append-version="true"></script>
  <script src="~/Assets/js/image-parallax.js"></script>




  <!-- <script defer type="text/javascript" src="~/Assets/js/cookie-script.js"></script> -->
  @await RenderSectionAsync("Scripts", required: false)
</body>

</html>