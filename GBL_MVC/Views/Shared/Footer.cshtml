@using GBL_BusinessLogic.Entity
@using GBL_MVC.Helpers
@model List<MenuFooter>

@{
    var footerMenus = Model ?? new List<MenuFooter>();

    var columns = footerMenus
        .Where(x => (x.ParentFooterId == null || x.ParentFooterId == 0)
                    && x.FooterType == "Column")
        .OrderBy(x => x.Sequence)
        .ToList();

    var socialMenus = footerMenus
        .Where(x => x.FooterType == "Social")
        .OrderBy(x => x.Sequence)
        .ToList();

    var companyInfo = footerMenus
        .FirstOrDefault(x => x.FooterType == "CompanyInfo");

    var copyright = footerMenus
        .FirstOrDefault(x => x.FooterType == "Copyright");

    var bottomLinks = footerMenus
        .Where(x => x.FooterType == "BottomLink")
        .OrderBy(x => x.Sequence)
        .ToList();
}

<footer class="site-footer relative overflow-hidden text-white">

    @if (!string.IsNullOrEmpty(companyInfo?.FooterThumbImage))
    {
        <video class="site-footer-bg" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
            <source src="@companyInfo.FooterThumbImage" type="video/mp4">
        </video>
    }

    <div class="site-footer-overlay" aria-hidden="true"></div>

    <div class="container relative z-10">

        <div class="site-footer-grid section-spacing-sm">
            <div class="site-footer-col">
                @if (!string.IsNullOrEmpty(companyInfo?.Title))
                {
                    <h5 class="site-footer-heading">@companyInfo.Title</h5>
                }

                @if (!string.IsNullOrEmpty(companyInfo?.Description))
                {
                    @Html.Raw(companyInfo.Description)
                }
            </div>

            @foreach (var column in columns)
            {
                var links = footerMenus
                    .Where(x => x.ParentFooterId == column.FooterId)
                    .OrderBy(x => x.Sequence)
                    .ToList();

                var hasLinks = links.Any();
                var title = column.Title.ToString();

                <div class="site-footer-col">
                    @if (hasLinks)
                    {
                        <ul class="site-footer-nav">
                            @foreach (var link in links)
                            {
                                <li>
                                    @if (!string.IsNullOrWhiteSpace(link.Url))
                                    {
                                        <a href="@link.Url" target="@link.Target"
                                           class="@(link.Target == "_blank" ? "site-footer-external" : "") @link.IconClass"
                                           rel="@(link.Target == "_blank" ? "noopener noreferrer" : null)">

                                            @link.Title

                                            @if (link.Target == "_blank")
                                            {
                                                <span class="site-footer-ext-icon" aria-hidden="true">
                                                    <img src="@Url.Content("~/Assets/images/common-images/external-link.svg")" alt="" />
                                                </span>
                                            }
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="@link.IconClass">@link.Title</span>
                                    }
                                </li>
                            }
                        </ul>

                        if (title == "Column 3")
                        {
                            if (socialMenus.Any())
                            {
                                <div class="site-footer-col">
                                    <div class="site-footer-follow">
                                        <span>Follow Us</span>

                                        @foreach (var social in socialMenus)
                                        {
                                            if (social.Sequence > 0)
                                            {
                                                <a href="@(social.Url ?? "#")" target="@(social.Target ?? "_blank")" rel="noopener noreferrer"
                                                   aria-label="@social.Title">

                                                    @if (!string.IsNullOrEmpty(social.FooterImage))
                                                    {
                                                        <img src="@social.FooterImage" alt="@social.Title" />
                                                    }
                                                    else
                                                    {
                                                        @social.Title
                                                    }
                                                </a>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        }
                    }

                </div>
            }
            @* Social media section *@
        </div>

        <div class="site-footer-bottom">
            <p class="site-footer-copy">
                @if (copyright != null)
                {
                    <text>
                        &copy; <span id="year-foot"></span>
                        @copyright.Description.CleanParagraphTags()
                    </text>
                }
            </p>

            <ul class="site-footer-legal">
                @foreach (var link in bottomLinks)
                {
                    <li>
                        <a href="@(link.Url ?? "#")" target="@link.Target"
                           rel="@(link.Target == "_blank" ? "noopener noreferrer" : null)">
                            @link.Title
                        </a>
                    </li>
                }
            </ul>
        </div>

    </div>

</footer>
