@using GBL_BusinessLogic.Entity
@using GBL_MVC.Helpers
@model List<MenuFooter>

@{
    var footerMenus = Model ?? new List<MenuFooter>();

    var columns = footerMenus
        .Where(x => (x.ParentFooterId == null || x.ParentFooterId == 0)
                    && x.FooterType == "Column")
        .OrderBy(x => x.Sequence)
        .ToList();

    var socialMenus = footerMenus
        .Where(x => x.FooterType == "Social")
        .OrderBy(x => x.Sequence)
        .ToList();

    var companyInfo = footerMenus
        .FirstOrDefault(x => x.FooterType == "CompanyInfo");

    var copyright = footerMenus
        .FirstOrDefault(x => x.FooterType == "Copyright");

    var bottomLinks = footerMenus
        .Where(x => x.FooterType == "BottomLink")
        .OrderBy(x => x.Sequence)
        .ToList();
}

@functions {
    // Renders one footer menu item: a link when it has a URL, otherwise plain text.
    private Microsoft.AspNetCore.Html.IHtmlContent RenderFooterLink(MenuFooter link)
    {
        var isExternal = link.Target == "_blank";

        if (string.IsNullOrWhiteSpace(link.Url))
        {
            return new Microsoft.AspNetCore.Html.HtmlString(
                $"<span class=\"{HtmlEncoder.Encode(link.IconClass ?? "")}\">{HtmlEncoder.Encode(link.Title ?? "")}</span>");
        }

        var cls = ((isExternal ? "site-footer-external " : "") + (link.IconClass ?? "")).Trim();
        var rel = isExternal ? " rel=\"noopener noreferrer\"" : "";
        var icon = isExternal
            ? $"<span class=\"site-footer-ext-icon\" aria-hidden=\"true\"><img src=\"{Url.Content("~/Assets/images/common-images/external-link.svg")}\" alt=\"\" /></span>"
            : "";

        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<a href=\"{HtmlEncoder.Encode(link.Url)}\" target=\"{HtmlEncoder.Encode(link.Target ?? "")}\" class=\"{HtmlEncoder.Encode(cls)}\"{rel}>{HtmlEncoder.Encode(link.Title ?? "")}{icon}</a>");
    }
}

<footer class="site-footer relative overflow-hidden text-white">

    @if (!string.IsNullOrEmpty(companyInfo?.FooterThumbImage))
    {
        <video class="site-footer-bg" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
            <source src="@companyInfo.FooterThumbImage" type="video/mp4">
        </video>
    }

    <div class="site-footer-overlay" aria-hidden="true"></div>

    <div class="container relative z-10">

        <div class="site-footer-grid section-spacing-sm">
            <div class="site-footer-col site-footer-company">
                @if (!string.IsNullOrEmpty(companyInfo?.Title))
                {
                    <h5 class="site-footer-heading">@companyInfo.Title</h5>
                }

                @if (!string.IsNullOrEmpty(companyInfo?.Description))
                {
                    @* Mobile-only toggle: reveals the full address (CSS in header-footer.css) *@
                    <input type="checkbox" id="site-footer-addr-toggle" class="site-footer-addr-toggle" />
                    <div class="site-footer-company-body">
                        @Html.Raw(companyInfo.Description)
                    </div>
                    <label for="site-footer-addr-toggle" class="site-footer-addr-label">View full address</label>
                }
            </div>

            @foreach (var column in columns)
            {
                var links = footerMenus
                    .Where(x => x.ParentFooterId == column.FooterId)
                    .OrderBy(x => x.Sequence)
                    .ToList();

                var hasLinks = links.Any();
                var title = column.Title.ToString();

                <div class="site-footer-col">
                    @if (hasLinks)
                    {
                        <ul class="site-footer-nav">
                            @for (var i = 0; i < links.Count; i++)
                            {
                                var link = links[i];
                                var isGroupHeading = (link.IconClass ?? "").Contains("site-footer-heading");

                                @* A heading item (e.g. Business) owns the "site-footer-links-sub" items that follow it *@
                                var subLinks = new List<MenuFooter>();
                                if (isGroupHeading)
                                {
                                    while (i + 1 < links.Count && (links[i + 1].IconClass ?? "").Contains("site-footer-links-sub"))
                                    {
                                        subLinks.Add(links[++i]);
                                    }
                                }

                                <li class="@(subLinks.Any() ? "site-footer-group" : null)">
                                    @if (!subLinks.Any())
                                    {
                                        @RenderFooterLink(link)
                                    }
                                    else
                                    {
                                        var toggleId = $"site-footer-sub-{link.FooterId}";
                                        <span class="site-footer-split">
                                            @RenderFooterLink(link)
                                            @* Mobile-only toggle (split chip arrow); hidden on desktop via CSS *@
                                            <input type="checkbox" id="@toggleId" class="site-footer-subtoggle"
                                                   aria-label="Show @link.Title links" />
                                            <label for="@toggleId" class="site-footer-subtoggle-btn" aria-hidden="true"></label>
                                        </span>
                                        <ul class="site-footer-subnav">
                                            @foreach (var sub in subLinks)
                                            {
                                                <li>@RenderFooterLink(sub)</li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ul>

                        if (title == "Column 3")
                        {
                            if (socialMenus.Any())
                            {
                                <div class="site-footer-col">
                                    <div class="site-footer-follow">
                                        <span>Follow Us</span>

                                        @foreach (var social in socialMenus)
                                        {
                                            if (social.Sequence > 0)
                                            {
                                                <a href="@(social.Url ?? "#")" target="@(social.Target ?? "_blank")" rel="noopener noreferrer"
                                                   aria-label="@social.Title">

                                                    @if (!string.IsNullOrEmpty(social.FooterImage))
                                                    {
                                                        <img src="@social.FooterImage" alt="@social.Title" />
                                                    }
                                                    else
                                                    {
                                                        @social.Title
                                                    }
                                                </a>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        }
                    }

                </div>
            }
            @* Social media section *@
        </div>

        <div class="site-footer-bottom">
            <p class="site-footer-copy">
                @if (copyright != null)
                {
                    <text>
                        &copy; <span id="year-foot"></span>
                        @copyright.Description.CleanParagraphTags()
                    </text>
                }
            </p>

            <ul class="site-footer-legal">
                @foreach (var link in bottomLinks)
                {
                    <li>
                        <a href="@(link.Url ?? "#")" target="@link.Target"
                           rel="@(link.Target == "_blank" ? "noopener noreferrer" : null)">
                            @link.Title
                        </a>
                    </li>
                }
            </ul>
        </div>

    </div>

</footer>
